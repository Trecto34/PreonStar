# Working notes for the optimization effort: session logs, handoffs, raw
# benchmark captures and the original roadmap.  These are a lab notebook for
# one board, not engine documentation -- the conclusions worth keeping are
# promoted into README.md, BC250.md and SPEEDUP.md instead.
/.optimizations/

# Local BC-250 launcher scripts.  These hardcode one machine's paths
# (/home/server/q36-opt, /home/server/.q36/kv-cache), bind 0.0.0.0:8000 and
# assume a specific thread count and KV budget, so they are deliberately not
# part of the repository.  Keep your own copies untracked.
/start-qwen36.sh
/start-server.sh
/start-server-bg.sh
/stop-server.sh
.infino/

# mem0-local MCP server for this repo (see .local/share/mem0-local/README.md)
!.mcp.json

# Maestri canvas session/role state (AGENTS.md, CLAUDE.md, scratchpad per
# spawned role) -- regenerated per session, not repo work product.
/.maestri/

# Raw per-run captures under the sustained-validation logs: numbered
# .txt/.csv/.trace dumps, dmesg snapshots, and compiled probe binaries. The
# curated scripts, patches, manifests and HANDOFF.md decision docs in the
# same tree stay tracked.
logs/bc250-sustained-20260918/*-validation/*.txt
logs/bc250-sustained-20260918/*-validation/*.csv
logs/bc250-sustained-20260918/*-validation/*.trace
logs/bc250-sustained-20260918/*-validation/run-gpu-gates.sh
logs/bc250-sustained-20260918/barrier-fix-*/*.txt
logs/bc250-sustained-20260918/runs/
logs/bc250-sustained-20260918/baseline/q36-bench
logs/bc250-sustained-20260918/attn_parity
logs/bc250-sustained-20260918/hadamard_parity
logs/bc250-sustained-20260918/mmq_info
logs/bc250-sustained-20260918/read_copy_bw
logs/bc250-sustained-20260918/swiglu_hadamard_parity

# Local sustained-rerun script: hardcodes this worktree's path, same as the
# other local launcher scripts above.
/run_sustained_rerun.sh
/mmq_info
