#version 450
// The whole K-link chain in ONE dispatch: the same per-link work, separated by
// a software grid barrier (monotonic counter, all workgroups co-resident).
layout(local_size_x = 64) in;
layout(std430, binding = 0) coherent buffer A { uint a[]; };
layout(std430, binding = 1) coherent buffer B { uint b[]; };
layout(std430, binding = 2) coherent buffer C { uint bar[]; };
layout(push_constant) uniform P { uint n; uint links; uint groups; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    for (uint k = 0u; k < pc.links; k++) {
        uint s = 0u;
        if ((k & 1u) == 0u) {
            for (uint j = 0u; j < 32u; j++) s += a[(i * 7u + j * 64u) % pc.n];
            b[i] = a[i] + 1u + (s >> 31);
        } else {
            for (uint j = 0u; j < 32u; j++) s += b[(i * 7u + j * 64u) % pc.n];
            a[i] = b[i] + 1u + (s >> 31);
        }
        memoryBarrierBuffer();
        barrier();
        if (gl_LocalInvocationIndex == 0u) {
            atomicAdd(bar[0], 1u);
            uint guard = 0u; while (atomicAdd(bar[0], 0u) < (k + 1u) * pc.groups && ++guard < 4000000u) {}
        }
        barrier();
        memoryBarrierBuffer();
    }
}
