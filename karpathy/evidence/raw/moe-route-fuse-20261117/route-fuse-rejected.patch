+    uint mode;      /* 0 partials only, 1 + route reduce, 2 + shared-expert tail */
 } pc;
 
+/* moe_down_route_reduce.comp's fma32, verbatim: the reduce below must round
+ * exactly like the dispatch it replaces. */
+float fma32(float a, float b, float c) {
+    double p = double(a) * double(b);
+    double s = p + double(c);
+    double bv = s - p;
+    double e = (p - (s - bv)) + (double(c) - bv);
+    if (e != 0.0LF) {
+        uint64_t bits = doubleBitsToUint64(s);
+        if ((bits & 1UL) == 0UL) {
+            if (s > 0.0LF) bits += (e > 0.0LF) ? 1UL : -1UL;
+            else if (s < 0.0LF) bits += (e < 0.0LF) ? 1UL : -1UL;
+            s = uint64BitsToDouble(bits);
+        }
+    }
+    return float(s);
+}
+
+/* ffn_tail.comp's sigmoid, verbatim. */
+float sigmoid_stable(float x) {
+    if (x >= 0.0f) {
+        float z = exp(-x);
+        return 1.0f / (1.0f + z);
+    }
+    float z = exp(x);
+    return z / (1.0f + z);
+}
+
+/* The last of a (token, row)'s n_used slot workgroups to finish does what
+ * moe_down_route_reduce and then ffn_tail did for that row: the same fma32
+ * chain in expert order, then out = fma(shared, sigmoid(g), sum).  Saves two
+ * dispatches and two pipeline drains per MoE layer; nothing serializes, each
+ * row has its own ticket.  The partial store is released before the ticket
+ * increment and the last arriver acquires before reading the others; it
+ * resets the ticket for the next layer. */
+void route_tail(uint slot, uint row) {
+    uint tok = slot / pc.n_used;
+    uint idx = tok * pc.out_dim + row;
+    memoryBarrierBuffer();
+    if (atomicAdd(ticket[idx], 1u) != pc.n_used - 1u) return;
+    memoryBarrierBuffer();
+    float sum = 0.0;
+    for (uint u = 0u; u < pc.n_used; u++) {
+        uint s = tok * pc.n_used + u;
+        sum = fma32(y[s * pc.out_dim + row], route[s], sum);
+    }
+    if (pc.mode == 2u) sum = fma(sharedv[idx], sigmoid_stable(scalarv[tok]), sum);
+    yout[idx] = sum;
+    ticket[idx] = 0u;
+}
