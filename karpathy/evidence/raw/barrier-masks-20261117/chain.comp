#version 450
// One link of a dependent decode-like chain: every workgroup reads a spread of the
// whole input vector (the matvec access shape) and writes its 64 outputs.
// dst[i] = src[i] + 1, so after K links from zero every element must equal K.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer S { uint src[]; };
layout(std430, binding = 1) writeonly buffer D { uint dst[]; };
layout(push_constant) uniform P { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    uint s = 0u;
    for (uint k = 0u; k < 32u; k++) s += src[(i * 7u + k * 64u) % pc.n];
    dst[i] = src[i] + 1u + (s >> 31);  // s < 2^31 always; keeps the loads live
}
