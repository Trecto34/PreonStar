diff --git a/tests/p36_test.c b/tests/p36_test.c
index 948c86a..e37e977 100644
--- a/tests/p36_test.c
+++ b/tests/p36_test.c
@@ -8286,6 +8286,71 @@ done:
     p36_engine_close(engine);
 }
 
+/* Direct F32-input Q6_K attn_output decode vs an independent ggml-layout
+ * dequant reference. in_dim 3072 = 12 blocks of 210 B, so odd blocks sit at
+ * 2-byte (not 4-byte) alignment and both Q6_K halves / both scale indices run. */
+static void test_inkling2_wo_q6k(void) {
+#ifdef P36_NO_GPU
+    test_skip("inkling2-wo-q6k", "CPU-only build");
+    return;
+#else
+    if (!p36_gpu_init()) {
+        test_skip("inkling2-wo-q6k", "Vulkan unavailable");
+        return;
+    }
+    const uint32_t in_dim = 3072u, out_dim = 16u, nb = in_dim / 256u;
+    const uint64_t w_bytes = (uint64_t)out_dim * nb * 210u;
+    uint8_t *w = (uint8_t *)malloc((size_t)w_bytes);
+    float *x = (float *)malloc(in_dim * sizeof(float));
+    float *ref = (float *)calloc(out_dim, sizeof(float));
+    float *got = (float *)malloc(out_dim * sizeof(float));
+    TEST_ASSERT(w && x && ref && got);
+    uint32_t seed = 12345u;
+    for (uint64_t i = 0; i < w_bytes; i++) { seed = seed * 1664525u + 1013904223u; w[i] = (uint8_t)(seed >> 24); }
+    for (uint32_t i = 0; i < in_dim; i++) x[i] = sinf((float)i * 0.37f);
+    for (uint32_t r = 0; r < out_dim; r++) {
+        for (uint32_t b = 0; b < nb; b++) {
+            uint8_t *blk = w + ((uint64_t)r * nb + b) * 210u;
+            uint16_t dh = test_float_to_f16(0.001f * (float)(1 + (r + b) % 7));
+            memcpy(blk + 208, &dh, 2);
+            const uint8_t *ql = blk, *qh = blk + 128;
+            const int8_t *sc = (const int8_t *)(blk + 192);
+            float d = p36_quant_f16_to_f32(dh);
+            for (uint32_t n = 0; n < 2u; n++, ql += 64, qh += 32, sc += 8) {
+                for (uint32_t l = 0; l < 32u; l++) {
+                    uint32_t is = l / 16u, o = b * 256u + n * 128u + l;
+                    int q1 = (int)((ql[l] & 15) | (((qh[l] >> 0) & 3) << 4)) - 32;
+                    int q2 = (int)((ql[l + 32] & 15) | (((qh[l] >> 2) & 3) << 4)) - 32;
+                    int q3 = (int)((ql[l] >> 4) | (((qh[l] >> 4) & 3) << 4)) - 32;
+                    int q4 = (int)((ql[l + 32] >> 4) | (((qh[l] >> 6) & 3) << 4)) - 32;
+                    ref[r] += d * sc[is] * q1 * x[o] + d * sc[is + 2] * q2 * x[o + 32]
+                            + d * sc[is + 4] * q3 * x[o + 64] + d * sc[is + 6] * q4 * x[o + 96];
+                }
+            }
+        }
+    }
+    TEST_ASSERT(p36_gpu_set_model_map(w, w_bytes) != 0);
+    p36_gpu_tensor *xt = p36_gpu_tensor_alloc(in_dim * sizeof(float));
+    p36_gpu_tensor *yt = p36_gpu_tensor_alloc(out_dim * sizeof(float));
+    TEST_ASSERT(xt && yt);
+    TEST_ASSERT(p36_gpu_tensor_write(xt, 0, x, in_dim * sizeof(float)) != 0);
+    TEST_ASSERT(p36_gpu_inkling2_wo_kquant_decode_tensor(yt, w, w_bytes, 0, 14u, xt, in_dim, out_dim) != 0);
+    TEST_ASSERT(p36_gpu_tensor_read(yt, 0, got, out_dim * sizeof(float)) != 0);
+    float max_rel = 0.0f;
+    for (uint32_t r = 0; r < out_dim; r++) {
+        float e = fabsf(got[r] - ref[r]) / (fabsf(ref[r]) + 1e-3f);
+        if (e > max_rel) max_rel = e;
+    }
+    fprintf(stderr, "p36-test: inkling2 wo q6k: max rel err %.3g (y0 gpu %.5f ref %.5f)\n",
+            (double)max_rel, (double)got[0], (double)ref[0]);
+    TEST_ASSERT(max_rel < 1.0e-4f);
+    p36_gpu_set_model_map(NULL, 0);
+    p36_gpu_tensor_free(xt);
+    p36_gpu_tensor_free(yt);
+    free(w); free(x); free(ref); free(got);
+#endif
+}
+
 static void test_inkling2_strided_views(void) {
 #ifdef P36_NO_GPU
     test_skip("inkling2-strided-views", "CPU-only build");
@@ -8494,6 +8559,7 @@ static const p36_test_entry test_entries[] = {
     {"--pq2-0-layout-oracle", "pq2-0-layout-oracle", "PQ2_0 block layout against hand-built blocks", test_pq2_0_layout_oracle},
     {"--pq2-0-native-128", "pq2-0-native-128", "independent per-128 PQ2_0 scales: GPU decode+MMQ vs f16 contract", test_pq2_0_native_128},
     {"--ptq1-0-layout-oracle", "ptq1-0-layout-oracle", "PTQ1_0 block layout against hand-built blocks", test_ptq1_0_layout_oracle},
+    {"--inkling2-wo-q6k", "inkling2-wo-q6k", "Inkling-2 direct F32 Q6_K attn_output decode vs reference", test_inkling2_wo_q6k},
     {"--inkling2-strided-views", "inkling2-strided-views", "Inkling-2 strided multi-slice descriptor bounds & parity", test_inkling2_strided_views},
     {"--server", "server", "server parser/rendering/cache unit tests", test_server_unit_group},
