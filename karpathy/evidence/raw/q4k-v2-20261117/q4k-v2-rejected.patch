diff --git a/vulkan/dense_kquant_decode.comp b/vulkan/dense_kquant_decode.comp
index 8406938..180a042 100644
--- a/vulkan/dense_kquant_decode.comp
+++ b/vulkan/dense_kquant_decode.comp
@@ -224,6 +224,48 @@ vec4 unpack_i8(uint v) {
                 float(bitfieldExtract(int(v), 24, 8)));
 }
 
+#ifdef P36_Q4K_V2
+/* One-row, one-token Q4_K decode with 8 lanes per block: lane j reads the 4
+ * qs dwords of nibble pair j>>1, half j&1 once and uses both nibbles (low ->
+ * group 2*(j>>1), high -> the next group), 32 weights per lane instead of 16
+ * with each dword fetched by two lanes.  Same per-group terms as the generic
+ * loop below; the per-lane sums are grouped differently, so not bit-identical.
+ * Needs blocks >= 8 to fill the 64 lanes (host checks). */
+void main(void) {
+    uint lid = gl_LocalInvocationID.x;
+    uint j8 = lid & 7u;
+    uint pair = j8 >> 1u;
+    uint half_id = j8 & 1u;
+    uint row = gl_WorkGroupID.x;
+    float acc = 0.0;
+    for (uint b = lid >> 3u; b < pc.blocks; b += 8u) {
+        uint base = row * pc.row_bytes + 144u * b;
+        uint qbase = b * Q8K_WORDS;
+        uint w0 = (base >> 2u) + 4u + 8u * pair + 4u * half_id;
+        uint q0 = qbase + 2u + 16u * pair + 4u * half_id;
+        uint sc0, mn0, sc1, mn1;
+        k4_scale_min(base, 2u * pair, sc0, mn0);
+        k4_scale_min(base, 2u * pair + 1u, sc1, mn1);
+        float dlo = 0.0, dhi = 0.0, slo = 0.0, shi = 0.0;
+        for (uint i = 0u; i < 4u; i++) {
+            uint ql = ww[w0 + i];
+            vec4 alo = unpack_i8(q8[q0 + i]);
+            vec4 ahi = unpack_i8(q8[q0 + 8u + i]);
+            dlo += dot(unpack_i8(ql & 0x0f0f0f0fu), alo);
+            dhi += dot(unpack_i8((ql >> 4u) & 0x0f0f0f0fu), ahi);
+            slo += alo.x + alo.y + alo.z + alo.w;
+            shi += ahi.x + ahi.y + ahi.z + ahi.w;
+        }
+        float dw = load_f16(base);
+        float dm = load_f16(base + 2u);
+        float yd = uintBitsToFloat(q8[qbase]);
+        acc = fma(yd, dw * float(sc0) * dlo - dm * float(mn0) * slo, acc);
+        acc = fma(yd, dw * float(sc1) * dhi - dm * float(mn1) * shi, acc);
+    }
+    float total = subgroupAdd(acc);
+    if (lid == 0u) y[row] = total * pc.scale;
+}
+#else
 void main(void) {
     uint lid = gl_LocalInvocationID.x;
     uint itid = lid & 15u;
@@ -465,3 +507,4 @@ void main(void) {
