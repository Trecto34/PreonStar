+/* 16 bytes at even byte offset `off`, via the dword view (see load_16b). */
+uvec4 load_16b_w(uint off) {
+    /* Branchless: lanes of one wave work on different blocks, so the
+     * odd/even split would diverge. s = 0 or 16. */
+    uint w = off >> 2u;
+    uint s = (off & 2u) << 3u;
+    uint r0 = wa[w], r1 = wa[w + 1u], r2 = wa[w + 2u], r3 = wa[w + 3u], r4 = wa[w + 4u];
+    return uvec4((r0 >> s) | ((r1 << 16u) << (16u - s)), (r1 >> s) | ((r2 << 16u) << (16u - s)),
+                 (r2 >> s) | ((r3 << 16u) << (16u - s)), (r3 >> s) | ((r4 << 16u) << (16u - s)));
+}
