+/* Same arithmetic as inkling2_router_topk.comp (one token, n_expert = 128,
+ * top_k <= 8, one wave64 per pass), so the picks and weights are bit-identical.
+ * Every workgroup (each wave of the IQ2_S build) recomputes the 128-logit
+ * top-k instead of waiting on a separate 1-workgroup router_topk dispatch and
+ * its barrier; workgroup x == 0 of each slot publishes the pick and weight for
+ * the down kernel. Returns the expert for slot k. */
+uint ink_topk_slot(uint k_want, uint gx) {
+    uint lane = gl_SubgroupInvocationID;
+    uint e0 = lane;
+    uint e1 = lane + 64u;
+    float p0 = 1.0 / (1.0 + exp(-logits[e0]));
+    float p1 = 1.0 / (1.0 + exp(-logits[e1]));
+    float s0 = p0 + (pc.has_bias != 0u ? bias[e0] : 0.0);
+    float s1 = p1 + (pc.has_bias != 0u ? bias[e1] : 0.0);
+    uint my_id = 0u;
+    float my_p = 0.0;
+    float sum_p = 0.0;
+    for (uint k = 0u; k < pc.n_used; k++) {
+        float lmax = max(s0, s1);
+        float gmax = subgroupMax(lmax);
+        uint cand = 0xffffffffu;
+        if (s0 == gmax) cand = e0;
+        else if (s1 == gmax) cand = e1;
+        uint win = subgroupMin(cand);
+        float win_p = (win == e0) ? p0 : ((win == e1) ? p1 : 0.0);
+        win_p = subgroupAdd(win_p);
+        if (k == k_want) { my_id = win; my_p = win_p; }
+        sum_p += win_p;
+        if (win == e0) s0 = -1.0e30;
+        if (win == e1) s1 = -1.0e30;
+    }
+    if (gx == 0u && gl_LocalInvocationID.x == 0u) {
+        float norm = pc.weight_scale / (sum_p + 1.0e-20);
+        selected[k_want] = my_id;
+        router_w[k_want] = my_p * norm;
+    }
+    return my_id;
+}
