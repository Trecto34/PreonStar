         uint m2 = u * pc.in_dim / 2u;
         float acc = 0.0;
 
-#ifdef Q36_MOE_IQ2S
+#if defined(Q36_MOE_IQ2S) && defined(Q36_P1_LOADFLOOR)
+        /* DIAGNOSTIC ONLY (Q36_P1_LOADFLOOR, 2026-09-24 P1).  Same workgroup /
+         * block / expert mapping, but the whole 82-byte superblock is read with
+         * three coalesced 2-byte loads per lane (lane stride one word) instead
+         * of the ~48 scattered per-lane byte loads the real IQ2_S dequant
+         * performs.  No dequant, no mid, no tables.  Measures the achievable
