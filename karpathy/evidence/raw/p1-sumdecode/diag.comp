#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_ARB_gpu_shader_int64 : require

/* Decode-only Q2_K down projection and routing-weighted sum. One
 * workgroup owns one output row and visits the eight experts in order. */

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint16_t wb[]; };
layout(set = 0, binding = 1) readonly buffer Mid { vec2 mid[]; };
layout(set = 0, binding = 2) readonly buffer Selected { uint selected[]; };
layout(set = 0, binding = 3) readonly buffer Scales { float scales[]; };
layout(set = 0, binding = 4) readonly buffer RouteWeights { float route[]; };
layout(set = 0, binding = 5) writeonly buffer Output { float y[]; };
#if defined(Q36_MOE_IQ2S) || defined(Q36_MOE_IQ3S)
layout(set = 0, binding = 6) readonly buffer Tables { uint tables[]; };
#endif

layout(push_constant) uniform Push {
    uint out_dim;
    uint in_dim;
    uint blocks;
    uint n_used;
    uint has_scales;
    uint pad;
} pc;

const uint Q2K_U16 = 42u;
#if defined(Q36_MOE_IQ2S) || defined(Q36_MOE_IQ3S)
uint wb_u8(uint off) {
    return (uint(wb[off >> 1u]) >> (8u * (off & 1u))) & 255u;
}
#endif
#ifdef Q36_MOE_IQ2S
/* IQ2_S superblock: [d f16][32 qs][32 signs][8 qh][8 scales] = 82 bytes. */
const uint IQ2S_BYTES = 82u;
const uint TAB_IQ2S = 544u;
#endif
#ifdef Q36_MOE_IQ3S
/* IQ3_S superblock: [d f16][64 qs][8 qh][32 signs][4 scales] = 110 bytes.
 * A 32-element group (itid) owns 8 qs bytes, one qh byte, 4 sign bytes and
 * half a scales byte; the 9-bit grid index selects 4 magnitudes from the
 * 512-entry IQ3_S grid table in the shared IQ tables buffer. */
const uint IQ3S_BYTES = 110u;
const uint TAB_IQ3S_GRID = 2592u;
#endif

float fma32(float a, float b, float c) {
    double p = double(a) * double(b);
    double s = p + double(c);
    double bv = s - p;
    double e = (p - (s - bv)) + (double(c) - bv);
    if (e != 0.0LF) {
        uint64_t bits = doubleBitsToUint64(s);
        if ((bits & 1UL) == 0UL) {
            if (s > 0.0LF) bits += (e > 0.0LF) ? 1UL : -1UL;
            else if (s < 0.0LF) bits += (e < 0.0LF) ? 1UL : -1UL;
            s = uint64BitsToDouble(bits);
        }
    }
    return float(s);
}

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.x;
    uint itid = tid & 15u;
    uint ix = tid >> 4u;
    uint v_im = itid >> 3u;
    uint v_in = itid & 7u;
    uint l0 = 2u * v_in;
    uint q_off16 = (32u * v_im + l0) >> 1u;
    uint y_off = 128u * v_im + l0;
#if defined(Q36_MOE_IQ3S)
    uint row_bytes = pc.blocks * IQ3S_BYTES;
#elif defined(Q36_MOE_IQ2S)
    uint row_bytes = pc.blocks * IQ2S_BYTES;
#else
    uint row_u16 = pc.blocks * Q2K_U16;
#endif
    float sum = 0.0;

    for (uint u = 0u; u < pc.n_used; u++) {
        uint expert = selected[u];
#if defined(Q36_MOE_IQ2S) || defined(Q36_MOE_IQ3S)
        uint base_bytes = (expert * pc.out_dim + row) * row_bytes;
#else
        uint base_u16 = (expert * pc.out_dim + row) * row_u16;
#endif
        uint m2 = u * pc.in_dim / 2u;
        float acc = 0.0;

#if defined(Q36_MOE_IQ2S) && defined(Q36_P1_LOADFLOOR)
        /* DIAGNOSTIC ONLY (Q36_P1_LOADFLOOR, 2026-09-24 P1).  Same workgroup /
         * block / expert mapping, but the whole 82-byte superblock is read with
         * three coalesced 2-byte loads per lane (lane stride one word) instead
         * of the ~48 scattered per-lane byte loads the real IQ2_S dequant
         * performs.  No dequant, no mid, no tables.  Measures the achievable
         * DRAM rate for this key/value layout, so the 40.6 GB/s of the real
         * kernel can be attributed to the bus or to the load pattern. */
        uint lane16 = tid & 15u;
        for (uint i = ix; i < pc.blocks; i += 2u) {
            uint w = (base_bytes + i * IQ2S_BYTES) >> 1u;
            uint c = 0u;
            for (uint k = 0u; k < 3u; k++) {
                uint idx = w + lane16 + 16u * k;
                if (idx < w + 41u) c += uint(wb[idx]);
            }
            acc += float(c);
        }
#elif defined(Q36_MOE_IQ2S) && defined(Q36_P1_ALUFLOOR)
        /* DIAGNOSTIC ONLY (Q36_P1_ALUFLOOR, 2026-09-24 P1).  The real IQ2_S
         * field loads are kept verbatim (same 5 loads per element group, same
         * addresses, so no load can be dead-code eliminated) but the dequant
         * arithmetic around them is collapsed to a plain add.  Together with
         * Q36_P1_LOADFLOOR this splits the measured 315 ms into the cost of the
         * scattered field loads and the cost of the ALU that consumes them. */
        for (uint i = ix; i < pc.blocks; i += 2u) {
            uint bb = base_bytes + i * IQ2S_BYTES;
            uint y2 = m2 + ((i * 256u + y_off) >> 1u);
            for (uint p = 0u; p < 8u; p++) {
                uint n = y_off + 16u * p;
                uint ib32 = n >> 5u;
                uint lg = (n >> 3u) & 3u;
                uint j = n & 7u;
                uint scb = wb_u8(bb + 74u + ib32);
                uint entry = wb_u8(bb + 2u + 4u * ib32 + lg) |
                             ((wb_u8(bb + 66u + ib32) << (8u - 2u * lg)) & 0x300u);
                uint signs = wb_u8(bb + 34u + 4u * ib32 + lg);
                uint word = tables[TAB_IQ2S + entry * 2u + (j >> 2u)];
                vec2 bv = mid[y2 + 8u * p];
                acc += float(scb) + float(entry) + float(signs) +
                       float(word & 255u) + bv.x + bv.y;
            }
        }
#elif defined(Q36_MOE_IQ2S)
        /* Same element slotting as the Q2_K path: this thread owns the two
         * elements at y_off + 16*p for p = 0..7 and each 16-element group
         * carries one IQ2_S scale, one grid index and one sign byte. */
        for (uint i = ix; i < pc.blocks; i += 2u) {
            uint bb = base_bytes + i * IQ2S_BYTES;
            float d = unpackHalf2x16(uint(wb[bb >> 1u])).x;
            uint y2 = m2 + ((i * 256u + y_off) >> 1u);
            for (uint p = 0u; p < 8u; p++) {
                uint n = y_off + 16u * p;
                uint ib32 = n >> 5u;
                uint lg = (n >> 3u) & 3u;
                uint j = n & 7u;
                uint scb = wb_u8(bb + 74u + ib32);
                float wsc = d * 0.25 * (0.5 + float(lg < 2u ? (scb & 15u) : (scb >> 4u)));
                uint entry = wb_u8(bb + 2u + 4u * ib32 + lg) |
                             ((wb_u8(bb + 66u + ib32) << (8u - 2u * lg)) & 0x300u);
                uint signs = wb_u8(bb + 34u + 4u * ib32 + lg);
                uint word = tables[TAB_IQ2S + entry * 2u + (j >> 2u)];
                /* Both elements share the 8-group's scale, entry and sign byte,
                 * but each has its own magnitude byte and sign bit. */
                vec2 gv = vec2(float((word >> (8u * (j & 3u))) & 255u),
                               float((word >> (8u * ((j + 1u) & 3u))) & 255u));
                vec2 gsg = mix(vec2(1.0), vec2(-1.0),
                               bvec2(((signs >> j) & 1u) != 0u,
                                     ((signs >> (j + 1u)) & 1u) != 0u));
                vec2 bv = mid[y2 + 8u * p];
                acc = fma(wsc, dot(gv * gsg, bv), acc);
            }
        }
#elif defined(Q36_MOE_IQ3S)
        /* Same element slotting: this thread owns the elements y_off + 16*p
         * and +1 for p = 0..7, i.e. the even/odd pair inside one 32-element
         * group, which always shares one 9-bit grid index and one scale. */
        for (uint i = ix; i < pc.blocks; i += 2u) {
            uint bb = base_bytes + i * IQ3S_BYTES;
            float d = unpackHalf2x16(uint(wb[bb >> 1u])).x;
            uint y2 = m2 + ((i * 256u + y_off) >> 1u);
            for (uint p = 0u; p < 8u; p++) {
                uint n = y_off + 16u * p;
                uint g32 = n >> 5u;
                uint sub = (n & 31u) >> 3u;
                uint m = n & 7u;
                uint qh = wb_u8(bb + 66u + g32);
                uint qb = wb_u8(bb + 2u + 8u * g32 + 2u * sub + (m < 4u ? 0u : 1u));
                uint entry = qb | (((qh >> (2u * sub + (m < 4u ? 0u : 1u))) & 1u) << 8u);
                uint word = tables[TAB_IQ3S_GRID + entry];
                uint sgn = wb_u8(bb + 74u + 4u * g32 + sub);
                uint scb = wb_u8(bb + 106u + (g32 >> 1u));
                uint nib = (g32 & 1u) != 0u ? (scb >> 4u) : (scb & 15u);
                float wsc = d * float(2u * nib + 1u);
                vec2 gv = vec2(float((word >> (8u * (m & 3u))) & 255u),
                               float((word >> (8u * ((m & 3u) + 1u))) & 255u));
                vec2 gsg = mix(vec2(1.0), vec2(-1.0),
                               bvec2(((sgn >> m) & 1u) != 0u,
                                     ((sgn >> (m + 1u)) & 1u) != 0u));
                vec2 bv = mid[y2 + 8u * p];
                acc = fma(wsc, dot(gv * gsg, bv), acc);
            }
        }
#else
        for (uint i = ix; i < pc.blocks; i += 2u) {
            uint bb = base_u16 + i * Q2K_U16;
            uint qs_u32 = uint(wb[bb + 8u + q_off16]) |
                          (uint(wb[bb + 8u + q_off16 + 8u]) << 16u);
            vec4 q0 = vec4(unpack8(qs_u32 & 0x03030303u));
            vec4 q2 = vec4(unpack8((qs_u32 >> 2u) & 0x03030303u));
            vec4 q4 = vec4(unpack8((qs_u32 >> 4u) & 0x03030303u));
            vec4 q6 = vec4(unpack8((qs_u32 >> 6u) & 0x03030303u));

            float sc1[8];
            float sc2[8];
            for (uint w = 0u; w < 4u; w++) {
                uint sw = uint(wb[bb + 4u * v_im + w]);
                sc1[2u * w] = float(sw & 0xFu);
                sc2[2u * w] = float((sw >> 4u) & 0xFu);
                sc1[2u * w + 1u] = float((sw >> 8u) & 0xFu);
                sc2[2u * w + 1u] = float((sw >> 12u) & 0xFu);
            }

            vec2 dm = unpackHalf2x16(uint(wb[bb + 40u]) |
                                     (uint(wb[bb + 41u]) << 16u));
            uint yb = m2 + ((i * 256u + y_off) >> 1u);
            vec2 b0 = mid[yb + 0u];
            vec2 b16 = mid[yb + 8u];
            vec2 b32 = mid[yb + 16u];
            vec2 b48 = mid[yb + 24u];
            vec2 b64 = mid[yb + 32u];
            vec2 b80 = mid[yb + 40u];
            vec2 b96 = mid[yb + 48u];
            vec2 b112 = mid[yb + 56u];

            float sum1 = 0.0;
            float sum2 = 0.0;
            for (uint l = 0u; l < 2u; l++) {
                sum1 = fma(b0[l], sc1[0] * q0[l],
                       fma(b16[l], sc1[1] * q0[l + 2u],
                       fma(b32[l], sc1[2] * q2[l],
                       fma(b48[l], sc1[3] * q2[l + 2u],
                       fma(b64[l], sc1[4] * q4[l],
                       fma(b80[l], sc1[5] * q4[l + 2u],
                       fma(b96[l], sc1[6] * q6[l],
                       fma(b112[l], sc1[7] * q6[l + 2u], sum1))))))));
                sum2 = fma(b0[l], sc2[0],
                       fma(b16[l], sc2[1],
                       fma(b32[l], sc2[2],
                       fma(b48[l], sc2[3],
                       fma(b64[l], sc2[4],
                       fma(b80[l], sc2[5],
                       fma(b96[l], sc2[6],
                       fma(b112[l], sc2[7], sum2))))))));
            }
            acc = fma(dm.x, sum1, fma(-dm.y, sum2, acc));
        }
#endif

        acc = subgroupAdd(acc);
        if (tid == 0u) {
            float sc = pc.has_scales != 0u ? scales[expert] : 1.0;
            sum = fma32(acc * sc, route[u], sum);
        }
    }
    if (tid == 0u) y[row] = sum;
}
