#version 450
/* The PQ2_0 decode matvec's memory access pattern with the math removed.
 * VARIANT 0: exact (unaligned 2x u32 codes + u16 scale + 8 q8 words per block)
 * VARIANT 1: no activation (q8) loads
 * VARIANT 2: no scale load
 * VARIANT 3: codes only, aligned (row_bytes padded to 1408, blocks 36 B -> 4-aligned)
 * VARIANT 4: codes only, uvec2 aligned load */
layout(local_size_x = 64) in;
layout(set=0, binding=0) readonly buffer W { uint wb[]; };
layout(set=0, binding=1) buffer O { uint o[]; };
layout(push_constant) uniform P { uint out_dim; uint blocks; } pc;
#ifndef ROWS
#define ROWS 4u
#endif
#if VARIANT >= 3
#define BLK 36u
#else
#define BLK 34u
#endif
const uint Q8K_WORDS = 74u;
uint load_u16(uint off) { uint w = wb[off >> 2u]; return (w >> (8u * (off & 3u))) & 0xffffu; }
uint load_u32(uint off) {
    uint shift = 8u * (off & 3u); uint i = off >> 2u; uint lo = wb[i];
    return shift == 0u ? lo : (lo >> shift) | (wb[i + 1u] << (32u - shift));
}
void main() {
    uint lid = gl_LocalInvocationID.x, lane8 = lid & 7u;
    uint row_bytes = pc.blocks * 2u * BLK;
    uint first_row = gl_WorkGroupID.x * ROWS;
    uint acc = 0u;
    for (uint b = lid >> 3u; b < pc.blocks; b += 8u) {
#if VARIANT != 1
        uint qbase = b * Q8K_WORDS + 2u + 8u * lane8;
        for (uint i = 0u; i < 8u; i++) acc ^= o[16u + (qbase + i) % 4096u];
#endif
        for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
            if (row >= pc.out_dim) continue;
            uint qblock = 2u * b + (lane8 >> 2u);
            uint base = row * row_bytes + qblock * BLK;
            uint code_base = base + 4u + (lane8 & 3u) * 8u;
#if VARIANT == 4
            uvec2 c = uvec2(wb[code_base >> 2u], wb[(code_base >> 2u) + 1u]);
            acc ^= c.x ^ c.y;
#elif VARIANT == 3
            acc ^= wb[code_base >> 2u] ^ wb[(code_base >> 2u) + 1u];
#else
            code_base -= 2u;
            acc ^= load_u32(code_base) ^ load_u32(code_base + 4u);
#endif
#if VARIANT != 2 && VARIANT < 3
            acc ^= load_u16(base);
#endif
        }
    }
    if (acc == 0x12345678u) o[0] = acc;
}
