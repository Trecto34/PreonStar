#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require

/* Routed MoE down prefill GEMM for Inkling-2-Mini (IQ4_NL / Q5_0 / NVFP4, block=32).
 * Tile: BM = 64 output rows x SLOT_TILE = 64 routed slots, BK = 32 (KK = 8 f16vec4).
 * 256 threads (16x16 grid: each thread computes 4 rows x 4 slots, 0 VGPR spill, 8.5 KiB LDS,
 * 4 threads/row weight loader, 4-tier live1/2/3 skip). */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint w[]; };
layout(set = 0, binding = 1) readonly buffer Act { vec4 xv[]; };
layout(set = 0, binding = 2) readonly buffer Tiles { uint tiles[]; };
layout(set = 0, binding = 3) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 4) readonly buffer ExpScale { float exp_scale[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint in_dim;
    uint blocks;        /* in_dim / 32 = 36 */
    uint n_used;        /* 8 */
    uint has_exp_scale; /* 1 if exp_scale[] is valid */
} pc;

const uint SLOT_TILE = 64u;
const uint TILE_WORDS = 1u + SLOT_TILE;
const uint INVALID = 0xffffffffu;
const uint BM = 64u;
const uint KK = 8u;
#define P36_SWZ(i) (((i) >> 1u) & 7u)

#ifdef P36_MOE_IQ4NL
const uint BLOCK_U16 = 9u;
const float16_t IQ4NL_INIT[16] = float16_t[16](
    float16_t(-127.0), float16_t(-104.0), float16_t(-83.0), float16_t(-65.0),
    float16_t(-49.0),  float16_t(-35.0),  float16_t(-22.0), float16_t(-10.0),
    float16_t(1.0),    float16_t(13.0),   float16_t(25.0),  float16_t(38.0),
    float16_t(53.0),   float16_t(69.0),   float16_t(89.0),  float16_t(113.0)
);
shared float16_t sh_lut[16];
#elif defined(P36_MOE_Q5_0)
const uint BLOCK_U16 = 11u;
#elif defined(P36_MOE_NVFP4)
const uint BLOCK_U32 = 9u;
const float16_t NVFP4_INIT[16] = float16_t[16](
    float16_t(0.0),  float16_t(1.0),  float16_t(2.0),  float16_t(3.0),
    float16_t(4.0),  float16_t(6.0),  float16_t(8.0),  float16_t(12.0),
    float16_t(0.0),  float16_t(-1.0), float16_t(-2.0), float16_t(-3.0),
    float16_t(-4.0), float16_t(-6.0), float16_t(-8.0), float16_t(-12.0)
);
shared float16_t sh_lut[16];
shared float sh_ue4m3[256];
#else
#error "Define P36_MOE_IQ4NL, P36_MOE_Q5_0, or P36_MOE_NVFP4"
#endif

shared f16vec4 Aw[BM][KK];
shared float Dw[BM];
shared f16vec4 Bs[SLOT_TILE][KK];
shared uint sh_slot[SLOT_TILE];

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * BM;
    uint tile_base = gl_WorkGroupID.y * TILE_WORDS;
    uint expert = tiles[tile_base];
    if (expert == INVALID) return;

    if (tid < SLOT_TILE) {
        sh_slot[tid] = tiles[tile_base + 1u + tid];
    }
#ifdef P36_MOE_IQ4NL
    if (tid < 16u) sh_lut[tid] = IQ4NL_INIT[tid];
#elif defined(P36_MOE_NVFP4)
    if (tid < 16u) sh_lut[tid] = NVFP4_INIT[tid];
    if (tid == 0u || tid == 0x7Fu) {
        sh_ue4m3[tid] = 0.0;
    } else {
        uint e = (tid >> 3u) & 15u;
        uint m = tid & 7u;
        float raw = (e == 0u) ? ldexp(float(m), -9)
                              : ldexp(1.0 + float(m) * 0.125, int(e) - 7);
        sh_ue4m3[tid] = raw * 0.5;
    }
#endif
    barrier();

    bool live1 = (sh_slot[16u] != INVALID);
    bool live2 = (sh_slot[32u] != INVALID);
    bool live3 = (sh_slot[48u] != INVALID);

    uint sl = tid & 15u;       /* 0..15 -> slots sl, sl+16, sl+32, sl+48 */
    uint ry = tid >> 4u;       /* 0..15 -> 4 rows: ry + 16*i */

    float acc[4][4];
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        acc[i][0] = 0.0; acc[i][1] = 0.0; acc[i][2] = 0.0; acc[i][3] = 0.0;
    }

#ifdef P36_MOE_NVFP4
    uint row_u32 = (pc.blocks >> 1u) * BLOCK_U32;
    uint exp_u32 = expert * pc.out_dim * row_u32;
#else
    uint exp_u16 = expert * pc.out_dim * pc.blocks * BLOCK_U16;
    uint row_u16 = pc.blocks * BLOCK_U16;
#endif
    uint in_v4 = pc.in_dim >> 2u;

    /* Weight loader: 256 threads -> 64 rows x 4 quarters (lc = 0..3, 1 u32 word/thread!) */
    uint lr = tid >> 2u;       /* 0..63 row */
    uint lc = tid & 3u;        /* 0..3: 1 uint32 word = 2 f16vec4s */
    uint sa = P36_SWZ(lr);
    uint b_slot0 = tid >> 3u;  /* 0..31 */
    uint b_slot1 = b_slot0 + 32u; /* 32..63 */
    uint b_kk = tid & 7u;      /* 0..7 */
    uint b_swz = b_kk ^ P36_SWZ(b_slot0);
    uint sl_b0 = sh_slot[b_slot0];
    uint sl_b1 = sh_slot[b_slot1];
    bool live_b0 = (sl_b0 != INVALID);
    bool live_b1 = (sl_b1 != INVALID);
    uint b_base0 = live_b0 ? (sl_b0 * in_v4 + b_kk) : 0u;
    uint b_base1 = live_b1 ? (sl_b1 * in_v4 + b_kk) : 0u;

    uint swz_sl = P36_SWZ(sl);
    uint swz_ry = P36_SWZ(ry);

    for (uint b = 0u; b < pc.blocks; b++) {
#ifdef P36_MOE_NVFP4
        uint blk = b >> 1u;
        uint half_b = b & 1u;
        uint wi = exp_u32 + (row0 + lr) * row_u32 + blk * BLOCK_U32;
        uint ds = w[wi];
        float d0 = sh_ue4m3[(ds >> (half_b * 16u)) & 255u];
        float d1 = sh_ue4m3[(ds >> (half_b * 16u + 8u)) & 255u];
        float dmax = max(d0, d1);
        if (lc == 0u) Dw[lr] = dmax;
        uint lc_half = lc >> 1u;
        uint lc_w = lc & 1u;
        float16_t rel_d = (dmax > 0.0) ? float16_t(((lc_half == 0u) ? d0 : d1) / dmax) : float16_t(0.0);
        uint q0 = w[wi + 1u + half_b * 4u + lc];
        uint base_k = lc_half * 4u + lc_w;
        Aw[lr][(base_k     ) ^ sa] = f16vec4(sh_lut[(q0      ) & 15u], sh_lut[(q0 >>  8u) & 15u],
                                             sh_lut[(q0 >> 16u) & 15u], sh_lut[(q0 >> 24u) & 15u]) * rel_d;
        Aw[lr][(base_k + 2u) ^ sa] = f16vec4(sh_lut[(q0 >>  4u) & 15u], sh_lut[(q0 >> 12u) & 15u],
                                             sh_lut[(q0 >> 20u) & 15u], sh_lut[(q0 >> 28u) & 15u]) * rel_d;
#else
        uint boff = exp_u16 + (row0 + lr) * row_u16 + b * BLOCK_U16;
        uint wi = boff >> 1u;
        bool odd = (b & 1u) != 0u;
#ifdef P36_MOE_IQ4NL
        uint q0;
#ifdef P36_DOWN_SPLIT
        /* split layout (see inkling2_moe_down_decode.comp): same values, new addresses */
        {
            uint ebase = expert * pc.out_dim * pc.blocks * 18u;
            uint lin = ((b >> 2u) * pc.out_dim + row0 + lr) * 4u + (b & 3u);
            q0 = w[(ebase >> 2u) + lin * 4u + lc];
            if (lc == 0u) {
                uint si = (ebase >> 1u) + pc.out_dim * pc.blocks * 8u + lin;
                Dw[lr] = unpackHalf2x16(w[si >> 1u] >> ((si & 1u) * 16u)).x;
            }
        }
#else
        if (odd) {
            if (lc == 0u) Dw[lr] = unpackHalf2x16(w[wi] >> 16u).x;
            q0 = w[wi + 1u + lc];
        } else {
            uint u0 = w[wi + lc];
            uint u1 = w[wi + 1u + lc];
            if (lc == 0u) Dw[lr] = unpackHalf2x16(u0).x;
            q0 = (u0 >> 16u) | (u1 << 16u);
        }
#endif
        Aw[lr][(lc     ) ^ sa] = f16vec4(sh_lut[(q0      ) & 15u], sh_lut[(q0 >>  8u) & 15u],
                                         sh_lut[(q0 >> 16u) & 15u], sh_lut[(q0 >> 24u) & 15u]);
        Aw[lr][(4u + lc) ^ sa] = f16vec4(sh_lut[(q0 >>  4u) & 15u], sh_lut[(q0 >> 12u) & 15u],
                                         sh_lut[(q0 >> 20u) & 15u], sh_lut[(q0 >> 28u) & 15u]);
#elif defined(P36_MOE_Q5_0)
        uint qh, q0;
        if (odd) {
            if (lc == 0u) Dw[lr] = unpackHalf2x16(w[wi] >> 16u).x;
            qh = w[wi + 1u];
            q0 = w[wi + 2u + lc];
        } else {
            uint h0 = w[wi];
            uint h1 = w[wi + 1u];
            if (lc == 0u) Dw[lr] = unpackHalf2x16(h0).x;
            qh = (h0 >> 16u) | (h1 << 16u);
            uint v0 = (lc == 0u) ? h1 : w[wi + 1u + lc];
            uint v1 = w[wi + 2u + lc];
            q0 = (v0 >> 16u) | (v1 << 16u);
        }
        uint sh = lc * 4u;
        Aw[lr][(lc     ) ^ sa] = f16vec4(
            float16_t(int(((q0      ) & 15u) | (((qh >> (sh     )) & 1u) << 4u)) - 16),
            float16_t(int(((q0 >>  8u) & 15u) | (((qh >> (sh + 1u)) & 1u) << 4u)) - 16),
            float16_t(int(((q0 >> 16u) & 15u) | (((qh >> (sh + 2u)) & 1u) << 4u)) - 16),
            float16_t(int(((q0 >> 24u) & 15u) | (((qh >> (sh + 3u)) & 1u) << 4u)) - 16));
        uint sh2 = 16u + sh;
        Aw[lr][(4u + lc) ^ sa] = f16vec4(
            float16_t(int(((q0 >>  4u) & 15u) | (((qh >> (sh2     )) & 1u) << 4u)) - 16),
            float16_t(int(((q0 >> 12u) & 15u) | (((qh >> (sh2 + 1u)) & 1u) << 4u)) - 16),
            float16_t(int(((q0 >> 20u) & 15u) | (((qh >> (sh2 + 2u)) & 1u) << 4u)) - 16),
            float16_t(int(((q0 >> 28u) & 15u) | (((qh >> (sh2 + 3u)) & 1u) << 4u)) - 16));
#endif
#endif
        Bs[b_slot0][b_swz] = live_b0 ? f16vec4(xv[b_base0 + b * 8u]) : f16vec4(0.0hf);
        if (live2) {
            Bs[b_slot1][b_swz] = live_b1 ? f16vec4(xv[b_base1 + b * 8u]) : f16vec4(0.0hf);
        }
        barrier();

        f16vec2 p[4][4];
        [[unroll]] for (uint i = 0u; i < 4u; i++) {
            p[i][0] = f16vec2(0.0hf); p[i][1] = f16vec2(0.0hf);
            p[i][2] = f16vec2(0.0hf); p[i][3] = f16vec2(0.0hf);
        }

        if (live3) {
            [[unroll]] for (uint kk = 0u; kk < KK; kk++) {
                uint bk = kk ^ swz_ry ^ swz_sl;
                f16vec4 bv0 = Bs[sl][bk];
                f16vec4 bv1 = Bs[sl + 16u][bk];
                f16vec4 bv2 = Bs[sl + 32u][bk];
                f16vec4 bv3 = Bs[sl + 48u][bk];
                [[unroll]] for (uint i = 0u; i < 4u; i++) {
                    f16vec4 av = Aw[ry + 16u * i][kk];
                    p[i][0] = fma(av.zw, bv0.zw, fma(av.xy, bv0.xy, p[i][0]));
                    p[i][1] = fma(av.zw, bv1.zw, fma(av.xy, bv1.xy, p[i][1]));
                    p[i][2] = fma(av.zw, bv2.zw, fma(av.xy, bv2.xy, p[i][2]));
                    p[i][3] = fma(av.zw, bv3.zw, fma(av.xy, bv3.xy, p[i][3]));
                }
            }
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                float d = Dw[ry + 16u * i];
                acc[i][0] = fma(d, float(p[i][0].x) + float(p[i][0].y), acc[i][0]);
                acc[i][1] = fma(d, float(p[i][1].x) + float(p[i][1].y), acc[i][1]);
                acc[i][2] = fma(d, float(p[i][2].x) + float(p[i][2].y), acc[i][2]);
                acc[i][3] = fma(d, float(p[i][3].x) + float(p[i][3].y), acc[i][3]);
            }
        } else if (live2) {
            [[unroll]] for (uint kk = 0u; kk < KK; kk++) {
                uint bk = kk ^ swz_ry ^ swz_sl;
                f16vec4 bv0 = Bs[sl][bk];
                f16vec4 bv1 = Bs[sl + 16u][bk];
                f16vec4 bv2 = Bs[sl + 32u][bk];
                [[unroll]] for (uint i = 0u; i < 4u; i++) {
                    f16vec4 av = Aw[ry + 16u * i][kk];
                    p[i][0] = fma(av.zw, bv0.zw, fma(av.xy, bv0.xy, p[i][0]));
                    p[i][1] = fma(av.zw, bv1.zw, fma(av.xy, bv1.xy, p[i][1]));
                    p[i][2] = fma(av.zw, bv2.zw, fma(av.xy, bv2.xy, p[i][2]));
                }
            }
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                float d = Dw[ry + 16u * i];
                acc[i][0] = fma(d, float(p[i][0].x) + float(p[i][0].y), acc[i][0]);
                acc[i][1] = fma(d, float(p[i][1].x) + float(p[i][1].y), acc[i][1]);
                acc[i][2] = fma(d, float(p[i][2].x) + float(p[i][2].y), acc[i][2]);
            }
        } else if (live1) {
            [[unroll]] for (uint kk = 0u; kk < KK; kk++) {
                uint bk = kk ^ swz_ry ^ swz_sl;
                f16vec4 bv0 = Bs[sl][bk];
                f16vec4 bv1 = Bs[sl + 16u][bk];
                [[unroll]] for (uint i = 0u; i < 4u; i++) {
                    f16vec4 av = Aw[ry + 16u * i][kk];
                    p[i][0] = fma(av.zw, bv0.zw, fma(av.xy, bv0.xy, p[i][0]));
                    p[i][1] = fma(av.zw, bv1.zw, fma(av.xy, bv1.xy, p[i][1]));
                }
            }
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                float d = Dw[ry + 16u * i];
                acc[i][0] = fma(d, float(p[i][0].x) + float(p[i][0].y), acc[i][0]);
                acc[i][1] = fma(d, float(p[i][1].x) + float(p[i][1].y), acc[i][1]);
            }
        } else {
            [[unroll]] for (uint kk = 0u; kk < KK; kk++) {
                uint bk = kk ^ swz_ry ^ swz_sl;
                f16vec4 bv0 = Bs[sl][bk];
                [[unroll]] for (uint i = 0u; i < 4u; i++) {
                    f16vec4 av = Aw[ry + 16u * i][kk];
                    p[i][0] = fma(av.zw, bv0.zw, fma(av.xy, bv0.xy, p[i][0]));
                }
            }
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                float d = Dw[ry + 16u * i];
                acc[i][0] = fma(d, float(p[i][0].x) + float(p[i][0].y), acc[i][0]);
            }
        }
        barrier();
    }

    float es = (pc.has_exp_scale != 0u) ? exp_scale[expert] : 1.0;
    uint s0 = sh_slot[sl];
    uint s1 = live1 ? sh_slot[sl + 16u] : INVALID;
    uint s2 = live2 ? sh_slot[sl + 32u] : INVALID;
    uint s3 = live3 ? sh_slot[sl + 48u] : INVALID;
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        uint row = row0 + ry + 16u * i;
        if (s0 != INVALID) y[s0 * pc.out_dim + row] = acc[i][0] * es;
        if (s1 != INVALID) y[s1 * pc.out_dim + row] = acc[i][1] * es;
        if (s2 != INVALID) y[s2 * pc.out_dim + row] = acc[i][2] * es;
        if (s3 != INVALID) y[s3 * pc.out_dim + row] = acc[i][3] * es;
    }
}
