#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : require

/* Inkling-2-Mini single-tensor MoE gate_up + SITU decode kernel (100% lane-balanced).
 * 64 threads = 4 output rows x 16 lanes/row (16 lanes cover 1 full 256-superblock,
 * looping i = 0..blocks-1 -> 9 exact iterations, ZERO idle-lane tail, 4x lower VGPRs!).
 * All 4 rows share the same L1-resident activation vector and same expert base.
 * Uses IEEE float sign-bit XOR instead of bvec4/mix.
 * Dispatch: (mid_dim / 4, n_used, 1). */

#if defined(P36_MOE_IQ2S)
const uint WG_THREADS = 256u;
const uint WG_ROWS = 16u;
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
#else
const uint WG_THREADS = 64u;
const uint WG_ROWS = 4u;
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
#endif

layout(set = 0, binding = 0) readonly buffer Weights { uint16_t w[]; };
layout(set = 0, binding = 1) readonly buffer X { vec4 xv[]; };
layout(set = 0, binding = 2) readonly buffer Selected { uint selected[]; };
layout(set = 0, binding = 3) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 4) readonly buffer Tables { uint tables[]; };
layout(set = 0, binding = 5) readonly buffer ExpScale { float exp_scale[]; };

layout(push_constant) uniform Push {
    uint mid_dim;      /* 1152 */
    uint blocks;       /* 2304 / 256 = 9 */
    uint n_used;       /* 8 */
    float situ_beta;   /* 4.0 */
    float inv_beta;    /* 0.25 */
    float situ_lb;     /* 25.0 */
    float inv_lb;      /* 0.04 */
    uint has_exp_scale;
} pc;

const uint IQ2_U16 = 33u;
const uint IQ2XS_U16 = 37u;
const uint IQ2S_BYTES = 82u;
const uint IQ3XXS_BYTES = 98u;
const uint IQ3S_BYTES = 110u;
const uint TAB_KSIGNS = 512u;
const uint TAB_IQ2S = 544u;
const uint TAB_IQ3S_GRID = 2592u;
const uint TAB_IQ3XXS_GRID = 3104u;
const uint TAB_IQ2XS = 7456u;

uint w_u8(uint off) {
    return (uint(w[off >> 1u]) >> (8u * (off & 1u))) & 255u;
}

vec4 neg4(vec4 v, uint m) {
    return mix(v, -v, bvec4((m & 1u) != 0u, (m & 2u) != 0u, (m & 4u) != 0u, (m & 8u) != 0u));
}

float sum16(float v) {
    v += subgroupShuffleXor(v, 8u);
    v += subgroupShuffleXor(v, 4u);
    v += subgroupShuffleXor(v, 2u);
    v += subgroupShuffleXor(v, 1u);
    return v;
}

#ifdef P36_MOE_IQ2XXS
shared uvec2 sh_grid[256];
#elif defined(P36_MOE_IQ2XS)
shared uvec2 sh_grid[512];
shared uint sh_ksigns[128];
#elif defined(P36_MOE_IQ2S)
shared uvec2 sh_grid[1024];
#elif defined(P36_MOE_IQ3XXS)
shared uint sh_grid[256];
shared uint sh_ksigns[128];
#elif defined(P36_MOE_IQ3S)
shared uint sh_grid[512];
#endif

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint r_local = tid >> 4u;
    uint itid = tid & 15u;       /* 0..15 */
    uint row = gl_WorkGroupID.x * WG_ROWS + r_local;
    uint pair = gl_WorkGroupID.y;
    uint expert = selected[pair];
    uint x4 = (pair / pc.n_used) * pc.blocks * 64u;

#ifdef P36_MOE_IQ2XXS
    for (uint i = tid; i < 256u; i += WG_THREADS) {
        sh_grid[i] = uvec2(tables[2u * i], tables[2u * i + 1u]);
    }
    barrier();
#elif defined(P36_MOE_IQ2XS)
    for (uint i = tid; i < 512u; i += WG_THREADS) {
        sh_grid[i] = uvec2(tables[TAB_IQ2XS + 2u * i], tables[TAB_IQ2XS + 2u * i + 1u]);
    }
    if (tid < 32u) {
        uint kw = tables[TAB_KSIGNS + tid];
        sh_ksigns[4u * tid + 0u] = kw & 255u;
        sh_ksigns[4u * tid + 1u] = (kw >> 8u) & 255u;
        sh_ksigns[4u * tid + 2u] = (kw >> 16u) & 255u;
        sh_ksigns[4u * tid + 3u] = kw >> 24u;
    }
    barrier();
#elif defined(P36_MOE_IQ2S)
    for (uint i = tid; i < 1024u; i += WG_THREADS) {
        sh_grid[i] = uvec2(tables[TAB_IQ2S + 2u * i], tables[TAB_IQ2S + 2u * i + 1u]);
    }
    barrier();
#elif defined(P36_MOE_IQ3XXS)
    for (uint i = tid; i < 256u; i += WG_THREADS) sh_grid[i] = tables[TAB_IQ3XXS_GRID + i];
    if (tid < 32u) {
        uint kw = tables[TAB_KSIGNS + tid];
        sh_ksigns[4u * tid + 0u] = kw & 255u;
        sh_ksigns[4u * tid + 1u] = (kw >> 8u) & 255u;
        sh_ksigns[4u * tid + 2u] = (kw >> 16u) & 255u;
        sh_ksigns[4u * tid + 3u] = kw >> 24u;
    }
    barrier();
#elif defined(P36_MOE_IQ3S)
    for (uint i = tid; i < 512u; i += WG_THREADS) sh_grid[i] = tables[TAB_IQ3S_GRID + i];
    barrier();
#endif

    uint ib32 = itid >> 1u;
    uint qpair = itid & 1u;
    float gate_acc = 0.0;
    float up_acc = 0.0;

    uint exp_row0 = expert * (2u * pc.mid_dim);
#ifdef P36_MOE_IQ2XXS
    uint row_u16 = pc.blocks * IQ2_U16;
    uint gbase = (exp_row0 + row) * row_u16;
    uint ubase = (exp_row0 + pc.mid_dim + row) * row_u16;
#elif defined(P36_MOE_IQ2XS)
    uint row_u16 = pc.blocks * IQ2XS_U16;
    uint gbase = (exp_row0 + row) * row_u16;
    uint ubase = (exp_row0 + pc.mid_dim + row) * row_u16;
#elif defined(P36_MOE_IQ2S)
    uint row_bytes = pc.blocks * IQ2S_BYTES;
    uint gbase = (exp_row0 + row) * row_bytes;
    uint ubase = (exp_row0 + pc.mid_dim + row) * row_bytes;
#elif defined(P36_MOE_IQ3XXS)
    uint row_bytes = pc.blocks * IQ3XXS_BYTES;
    uint gbase = (exp_row0 + row) * row_bytes;
    uint ubase = (exp_row0 + pc.mid_dim + row) * row_bytes;
#elif defined(P36_MOE_IQ3S)
    uint row_bytes = pc.blocks * IQ3S_BYTES;
    uint gbase = (exp_row0 + row) * row_bytes;
    uint ubase = (exp_row0 + pc.mid_dim + row) * row_bytes;
#endif

    for (uint i = 0u; i < pc.blocks; i++) {
        uint y4 = (i * 256u + 16u * itid) >> 2u;
        vec4 a0 = xv[x4 + y4 + 0u];
        vec4 a1 = xv[x4 + y4 + 1u];
        vec4 a2 = xv[x4 + y4 + 2u];
        vec4 a3 = xv[x4 + y4 + 3u];

#ifdef P36_MOE_IQ2XXS
        uint gb = gbase + i * IQ2_U16;
        uint ub = ubase + i * IQ2_U16;
        float gd = unpackHalf2x16(uint(w[gb])).x;
        float ud = unpackHalf2x16(uint(w[ub])).x;
        uint gq = gb + 1u + 4u * ib32;
        uint uq = ub + 1u + 4u * ib32;
        uint gss = uint(w[gq + 2u]) | (uint(w[gq + 3u]) << 16u);
        uint uss = uint(w[uq + 2u]) | (uint(w[uq + 3u]) << 16u);
        float gdb = gd * 0.25 * (0.5 + float(gss >> 28u));
        float udb = ud * 0.25 * (0.5 + float(uss >> 28u));
        uint gidx_w = uint(w[gq + qpair]);
        uint uidx_w = uint(w[uq + qpair]);
        float gs = 0.0;
        float us = 0.0;
        [[unroll]] for (uint l = 0u; l < 2u; l++) {
            uint sbit = 7u * (2u * qpair + l);
            uint gqs = (gidx_w >> (8u * l)) & 255u;
            uint gsign = bitfieldExtract(gss, int(sbit), 7);
            uint gsign_hi = (gsign >> 4u) | ((uint(bitCount(gsign)) & 1u) << 3u);
            uvec2 gg = sh_grid[gqs];
            vec4 g0 = neg4(vec4(unpack8(gg.x)), gsign);
            vec4 g1 = neg4(vec4(unpack8(gg.y)), gsign_hi);
            uint uqs = (uidx_w >> (8u * l)) & 255u;
            uint usign = bitfieldExtract(uss, int(sbit), 7);
            uint usign_hi = (usign >> 4u) | ((uint(bitCount(usign)) & 1u) << 3u);
            uvec2 ug = sh_grid[uqs];
            vec4 u0 = neg4(vec4(unpack8(ug.x)), usign);
            vec4 u1 = neg4(vec4(unpack8(ug.y)), usign_hi);
            vec4 b0 = (l == 0u) ? a0 : a2;
            vec4 b4 = (l == 0u) ? a1 : a3;
            gs += dot(b0, g0) + dot(b4, g1);
            us += dot(b0, u0) + dot(b4, u1);
        }
        gate_acc = fma(gdb, gs, gate_acc);
        up_acc = fma(udb, us, up_acc);
#elif defined(P36_MOE_IQ2XS)
        uint gb = gbase + i * IQ2XS_U16;
        uint ub = ubase + i * IQ2XS_U16;
        float gd = unpackHalf2x16(uint(w[gb])).x;
        float ud = unpackHalf2x16(uint(w[ub])).x;
        uint gsc = w_u8((gb + 33u) * 2u + ib32);
        uint usc = w_u8((ub + 33u) * 2u + ib32);
        float gdb = gd * 0.25 * (0.5 + float(qpair == 0u ? (gsc & 15u) : (gsc >> 4u)));
        float udb = ud * 0.25 * (0.5 + float(qpair == 0u ? (usc & 15u) : (usc >> 4u)));
        float gs = 0.0;
        float us = 0.0;
        [[unroll]] for (uint l = 0u; l < 2u; l++) {
            uint sub = 2u * qpair + l;
            uint gq = uint(w[gb + 1u + 4u * ib32 + sub]);
            uint uq = uint(w[ub + 1u + 4u * ib32 + sub]);
            uint gsign = sh_ksigns[gq >> 9u];
            uint usign = sh_ksigns[uq >> 9u];
            uvec2 gg = sh_grid[gq & 511u];
            uvec2 ug = sh_grid[uq & 511u];
            vec4 g0 = neg4(vec4(unpack8(gg.x)), gsign);
            vec4 g1 = neg4(vec4(unpack8(gg.y)), gsign >> 4u);
            vec4 u0 = neg4(vec4(unpack8(ug.x)), usign);
            vec4 u1 = neg4(vec4(unpack8(ug.y)), usign >> 4u);
            vec4 b0 = (l == 0u) ? a0 : a2;
            vec4 b4 = (l == 0u) ? a1 : a3;
            gs += dot(b0, g0) + dot(b4, g1);
            us += dot(b0, u0) + dot(b4, u1);
        }
        gate_acc = fma(gdb, gs, gate_acc);
        up_acc = fma(udb, us, up_acc);
#elif defined(P36_MOE_IQ2S)
        uint gbb = gbase + i * IQ2S_BYTES;
        uint ubb = ubase + i * IQ2S_BYTES;
        float gd = unpackHalf2x16(uint(w[gbb >> 1u])).x;
        float ud = unpackHalf2x16(uint(w[ubb >> 1u])).x;
        uint gqh = w_u8(gbb + 66u + ib32);
        uint uqh = w_u8(ubb + 66u + ib32);
        uint gsc = w_u8(gbb + 74u + ib32);
        uint usc = w_u8(ubb + 74u + ib32);
        float gdb = gd * 0.25 * (0.5 + float(qpair == 0u ? (gsc & 15u) : (gsc >> 4u)));
        float udb = ud * 0.25 * (0.5 + float(qpair == 0u ? (usc & 15u) : (usc >> 4u)));
        uint gsig01 = uint(w[(gbb + 34u + 4u * ib32 + 2u * qpair) >> 1u]);
        uint usig01 = uint(w[(ubb + 34u + 4u * ib32 + 2u * qpair) >> 1u]);
        uint gidx01 = uint(w[(gbb + 2u + 4u * ib32 + 2u * qpair) >> 1u]);
        uint uidx01 = uint(w[(ubb + 2u + 4u * ib32 + 2u * qpair) >> 1u]);
        float gs = 0.0;
        float us = 0.0;
        [[unroll]] for (uint l = 0u; l < 2u; l++) {
            uint p = 2u * qpair + l;
            uint gsig = (gsig01 >> (8u * l)) & 255u;
            uint usig = (usig01 >> (8u * l)) & 255u;
            uint gidx = ((gidx01 >> (8u * l)) & 255u) | ((gqh << (8u - 2u * p)) & 0x300u);
            uint uidx = ((uidx01 >> (8u * l)) & 255u) | ((uqh << (8u - 2u * p)) & 0x300u);
            uvec2 gg = sh_grid[gidx];
            uvec2 ug = sh_grid[uidx];
            vec4 g0 = neg4(vec4(unpack8(gg.x)), gsig);
            vec4 g1 = neg4(vec4(unpack8(gg.y)), gsig >> 4u);
            vec4 u0 = neg4(vec4(unpack8(ug.x)), usig);
            vec4 u1 = neg4(vec4(unpack8(ug.y)), usig >> 4u);
            vec4 b0 = (l == 0u) ? a0 : a2;
            vec4 b4 = (l == 0u) ? a1 : a3;
            gs += dot(b0, g0) + dot(b4, g1);
            us += dot(b0, u0) + dot(b4, u1);
        }
        gate_acc = fma(gdb, gs, gate_acc);
        up_acc = fma(udb, us, up_acc);
#elif defined(P36_MOE_IQ3XXS)
        uint gbb = gbase + i * IQ3XXS_BYTES;
        uint ubb = ubase + i * IQ3XXS_BYTES;
        uint gaux_h = (gbb + 66u + 4u * ib32) >> 1u;
        uint uaux_h = (ubb + 66u + 4u * ib32) >> 1u;
        uint gaux = uint(w[gaux_h]) | (uint(w[gaux_h + 1u]) << 16u);
        uint uaux = uint(w[uaux_h]) | (uint(w[uaux_h + 1u]) << 16u);
        float gd = unpackHalf2x16(uint(w[gbb >> 1u])).x * 0.25 * float(2u * (gaux >> 28u) + 1u);
        float ud = unpackHalf2x16(uint(w[ubb >> 1u])).x * 0.25 * float(2u * (uaux >> 28u) + 1u);
        float gs = 0.0;
        float us = 0.0;
        [[unroll]] for (uint l = 0u; l < 2u; l++) {
            uint sub = 2u * qpair + l;
            uint gsi = (gaux >> (7u * sub)) & 127u;
            uint usi = (uaux >> (7u * sub)) & 127u;
            uint gsign = sh_ksigns[gsi];
            uint usign = sh_ksigns[usi];
            uint ge01 = uint(w[(gbb + 2u + 8u * ib32 + 2u * sub) >> 1u]);
            uint ue01 = uint(w[(ubb + 2u + 8u * ib32 + 2u * sub) >> 1u]);
            vec4 g0 = neg4(vec4(unpack8(sh_grid[ge01 & 255u])), gsign);
            vec4 g1 = neg4(vec4(unpack8(sh_grid[ge01 >> 8u])), gsign >> 4u);
            vec4 u0 = neg4(vec4(unpack8(sh_grid[ue01 & 255u])), usign);
            vec4 u1 = neg4(vec4(unpack8(sh_grid[ue01 >> 8u])), usign >> 4u);
            vec4 b0 = (l == 0u) ? a0 : a2;
            vec4 b4 = (l == 0u) ? a1 : a3;
            gs += dot(b0, g0) + dot(b4, g1);
            us += dot(b0, u0) + dot(b4, u1);
        }
        gate_acc = fma(gd, gs, gate_acc);
        up_acc = fma(ud, us, up_acc);
#elif defined(P36_MOE_IQ3S)
        uint gbb = gbase + i * IQ3S_BYTES;
        uint ubb = ubase + i * IQ3S_BYTES;
        uint gqh = w_u8(gbb + 66u + ib32);
        uint uqh = w_u8(ubb + 66u + ib32);
        uint gscb = w_u8(gbb + 106u + (ib32 >> 1u));
        uint uscb = w_u8(ubb + 106u + (ib32 >> 1u));
        uint gnib = (ib32 & 1u) != 0u ? (gscb >> 4u) : (gscb & 15u);
        uint unib = (ib32 & 1u) != 0u ? (uscb >> 4u) : (uscb & 15u);
        float gd = unpackHalf2x16(uint(w[gbb >> 1u])).x * float(2u * gnib + 1u);
        float ud = unpackHalf2x16(uint(w[ubb >> 1u])).x * float(2u * unib + 1u);
        uint gsgn01 = uint(w[(gbb + 74u + 4u * ib32 + 2u * qpair) >> 1u]);
        uint usgn01 = uint(w[(ubb + 74u + 4u * ib32 + 2u * qpair) >> 1u]);
        float gs = 0.0;
        float us = 0.0;
        [[unroll]] for (uint l = 0u; l < 2u; l++) {
            uint sub = 2u * qpair + l;
            uint gsgn = (gsgn01 >> (8u * l)) & 255u;
            uint usgn = (usgn01 >> (8u * l)) & 255u;
            uint ge01 = uint(w[(gbb + 2u + 8u * ib32 + 2u * sub) >> 1u]);
            uint ue01 = uint(w[(ubb + 2u + 8u * ib32 + 2u * sub) >> 1u]);
            uint ge0 = (ge01 & 255u) | (((gqh >> (2u * sub)) & 1u) << 8u);
            uint ge1 = (ge01 >> 8u)  | (((gqh >> (2u * sub + 1u)) & 1u) << 8u);
            uint ue0 = (ue01 & 255u) | (((uqh >> (2u * sub)) & 1u) << 8u);
            uint ue1 = (ue01 >> 8u)  | (((uqh >> (2u * sub + 1u)) & 1u) << 8u);
            vec4 g0 = neg4(vec4(unpack8(sh_grid[ge0])), gsgn);
            vec4 g1 = neg4(vec4(unpack8(sh_grid[ge1])), gsgn >> 4u);
            vec4 u0 = neg4(vec4(unpack8(sh_grid[ue0])), usgn);
            vec4 u1 = neg4(vec4(unpack8(sh_grid[ue1])), usgn >> 4u);
            vec4 b0 = (l == 0u) ? a0 : a2;
            vec4 b4 = (l == 0u) ? a1 : a3;
            gs += dot(b0, g0) + dot(b4, g1);
            us += dot(b0, u0) + dot(b4, u1);
        }
        gate_acc = fma(gd, gs, gate_acc);
        up_acc = fma(ud, us, up_acc);
#else
#error "Define P36_MOE_IQ2XXS, P36_MOE_IQ2S, P36_MOE_IQ3XXS, or P36_MOE_IQ3S"
#endif
    }

    float g = sum16(gate_acc);
    float u = sum16(up_acc);
    if (itid == 0u) {
        if (pc.has_exp_scale != 0u) {
            float es = exp_scale[expert];
            g *= es;
            u *= es;
        }
        float sg = pc.situ_beta * tanh(g * pc.inv_beta) / (1.0 + exp(-g));
        float su = pc.situ_lb * tanh(u * pc.inv_lb);
        y[pair * pc.mid_dim + row] = sg * su;
    }
}
