#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : enable

/* Prefill Q8_0 GEMM, packed-f16 variant of matmul_q8_0_mm. 128x64
 * output tile per 256-thread workgroup, an 8x4 register tile per
 * thread. Shared memory holds f16vec4 lanes and the inner loop runs
 * packed f16 FMAs: the f32 kernel is instruction/latency-bound, not
 * bandwidth-bound, on the BC-250, so the win comes from doubling the
 * per-barrier work and halving the FMA instruction count.
 *
 * Numerics: weights stage as q * 2^-7 (exact in f16, |q| <= 127) and
 * activations round once to f16; packed even/odd-k partial sums flush
 * to f32 accumulators every 32-element Q8_0 block with the block scale
 * (d * 128) folded in, so f16 add chains are 8 terms long and cannot
 * overflow. Per-output k order is fixed regardless of n_tok, keeping
 * the batch-size invariance rule (warm == cold). Results differ from
 * the f32 kernel by ~1e-3 relative; --quality never routes here. */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights {
    uint16_t wb16[];
};

layout(set = 0, binding = 1) readonly buffer X {
    vec4 xv[];
};

layout(set = 0, binding = 2) writeonly buffer Output {
    float y[];
};

layout(push_constant) uniform Push {
    uint out_dim;
    uint n_tok;
    uint blocks;
    uint row_bytes;
    float scale;
} pc;

/* One Q8_0 block is 17 uint16 words: [d_f16][16 x 2 qs bytes]. */
const uint Q8_0_U16 = 17u;
const uint BM = 128u;
const uint BN = 64u;
const uint BK = 32u;
const uint KK = BK / 4u;

/* [m][kk] layout with the k index XOR-swizzled by the row/column index.
 *
 * The pad slot this layout used to carry (row stride KK+1) never reached the
 * hardware: the ninth column is never written or read, the toolchain drops it,
 * and RADV reports LDS exactly at the unpadded size.  The 16 tx lanes then hit
 * a 64-byte row stride, i.e. two banks for sixteen 64-bit reads -- an 8-way
 * conflict.  Swizzling k by (index >> 1) & 7 spreads those sixteen reads over
 * all 32 banks with no extra LDS, and it is only a permutation of where a
 * value lives, so every result is bit-identical: 1879 -> 1615 ms across a
 * ctx-2048 run, 17/17 frontier logit dumps unchanged (MEASURED_ON_BC250). */
#define Q36_SWZ(i) (((i) >> 1u) & 7u)   /* mask is KK - 1 */
shared f16vec4 As[BM][KK];
shared f16vec4 Bs[BN][KK];
shared float Ds[BM];

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * BM;
    uint col0 = gl_WorkGroupID.y * BN;
    uint tx = tid & 15u;
    uint ty = tid >> 4u;
    uint in_dim = pc.blocks * BK;

    float acc[8][4];
    for (uint i = 0u; i < 8u; i++)
        for (uint j = 0u; j < 4u; j++) acc[i][j] = 0.0;

    uint r = tid >> 1u;
    uint kk_a = (tid & 1u) * 4u;
    uint row = row0 + r;
    bool row_ok = row < pc.out_dim;
    uint sa = Q36_SWZ(r);
    uint a_k0 = (kk_a + 0u) ^ sa;
    uint a_k1 = (kk_a + 1u) ^ sa;
    uint a_k2 = (kk_a + 2u) ^ sa;
    uint a_k3 = (kk_a + 3u) ^ sa;
    uint q_off = 1u + kk_a * 2u;
    uint base_step = row_ok ? Q8_0_U16 : 0u;
    uint base = row_ok ? (row * pc.blocks) * Q8_0_U16 : 0u;

    uint c = tid >> 2u;
    uint kk_b = (tid & 3u) * 2u;
    uint col = col0 + c;
    bool col_ok = col < pc.n_tok;
    uint sb = Q36_SWZ(c);
    uint b_k0 = (kk_b + 0u) ^ sb;
    uint b_k1 = (kk_b + 1u) ^ sb;
    uint xbase_step = col_ok ? (BK / 4u) : 0u;
    uint xbase = col_ok ? (col * (pc.blocks * (BK / 4u)) + kk_b) : 0u;

    uint swz_tx = Q36_SWZ(tx);
    uint swz_ty = Q36_SWZ(ty);
    uint arow[8];
    for (uint i = 0u; i < 8u; i++) arow[i] = ty + 16u * i;
    uint brow[4];
    for (uint j = 0u; j < 4u; j++) brow[j] = tx + 16u * j;

    for (uint kb = 0u; kb < pc.blocks; kb++) {
        /* Stage A: 128 rows x 32 elems, 16 consecutive elems per thread
         * so one d load and four u32-equivalent qs loads cover them. */
        {
            uint q = base + q_off;
            uint p0 = uint(wb16[q + 0u]) | (uint(wb16[q + 1u]) << 16u);
            uint p1 = uint(wb16[q + 2u]) | (uint(wb16[q + 3u]) << 16u);
            uint p2 = uint(wb16[q + 4u]) | (uint(wb16[q + 5u]) << 16u);
            uint p3 = uint(wb16[q + 6u]) | (uint(wb16[q + 7u]) << 16u);
            As[r][a_k0] = f16vec4(unpack8(int(p0))) * float16_t(0.0078125);
            As[r][a_k1] = f16vec4(unpack8(int(p1))) * float16_t(0.0078125);
            As[r][a_k2] = f16vec4(unpack8(int(p2))) * float16_t(0.0078125);
            As[r][a_k3] = f16vec4(unpack8(int(p3))) * float16_t(0.0078125);
            if ((tid & 1u) == 0u) {
                float d = row_ok ? unpackHalf2x16(uint(wb16[base])).x : 0.0;
                Ds[r] = d * 128.0;
            }
            base += base_step;
        }
        /* Stage B: 64 tokens x 32 elems, rounded once to f16. */
        {
            vec4 x0 = col_ok ? xv[xbase + 0u] : vec4(0.0);
            vec4 x1 = col_ok ? xv[xbase + 1u] : vec4(0.0);
            Bs[c][b_k0] = f16vec4(x0);
            Bs[c][b_k1] = f16vec4(x1);
            xbase += xbase_step;
        }
        barrier();

        f16vec2 pk[8][4];
        for (uint i = 0u; i < 8u; i++)
            for (uint j = 0u; j < 4u; j++) pk[i][j] = f16vec2(0.0hf);
        [[unroll]]
        for (uint kk = 0u; kk < KK; kk++) {
            uint kkb = kk ^ swz_tx;
            f16vec4 b0 = Bs[brow[0]][kkb];
            f16vec4 b1 = Bs[brow[1]][kkb];
            f16vec4 b2 = Bs[brow[2]][kkb];
            f16vec4 b3 = Bs[brow[3]][kkb];
            uint kka = kk ^ swz_ty;
            for (uint i = 0u; i < 8u; i++) {
                f16vec4 a = As[arow[i]][kka];
                pk[i][0] = fma(a.zw, b0.zw, fma(a.xy, b0.xy, pk[i][0]));
                pk[i][1] = fma(a.zw, b1.zw, fma(a.xy, b1.xy, pk[i][1]));
                pk[i][2] = fma(a.zw, b2.zw, fma(a.xy, b2.xy, pk[i][2]));
                pk[i][3] = fma(a.zw, b3.zw, fma(a.xy, b3.xy, pk[i][3]));
            }
        }
        for (uint i = 0u; i < 8u; i++) {
            float d = Ds[arow[i]];
            for (uint j = 0u; j < 4u; j++) {
                acc[i][j] = fma(d, float(pk[i][j].x) + float(pk[i][j].y), acc[i][j]);
            }
        }
        barrier();
    }

    for (uint j = 0u; j < 4u; j++) {
        uint col = col0 + tx + 16u * j;
        if (col >= pc.n_tok) continue;
        uint y_base = col * pc.out_dim;
        for (uint i = 0u; i < 8u; i++) {
            uint row = row0 + ty + 16u * i;
            if (row < pc.out_dim) y[y_base + row] = acc[i][j] * pc.scale;
        }
    }
}
