#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require

/* Fused MoE down decode + weighted reduction over all 8 experts + ffn_post_conv + residual.
 * Uses aligned 32-bit uint loads (5/6 buffer_load_dword instead of 9/11 buffer_load_ushort!).
 * Supports IQ4_NL (18 bytes / 32 weights) and Q5_0 (22 bytes / 32 weights).
 * IQ4_NL LUT lives in shared memory to avoid dynamic-index VGPR ladders on RADV.
 * 4 output rows per workgroup sharing activations across all 8 experts.
 * Dispatch: (out_dim / 4, 1, 1). */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint w[]; };
layout(set = 0, binding = 1) readonly buffer Act { vec4 xv[]; };
layout(set = 0, binding = 2) readonly buffer Selected { uint selected[]; };
layout(set = 0, binding = 3) readonly buffer RouterW { float rw[]; };
layout(set = 0, binding = 4) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 5) readonly buffer ConvW { vec4 cw[]; };
layout(set = 0, binding = 6) buffer ConvState { float cs[]; };
layout(set = 0, binding = 7) readonly buffer Res { float res[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint in_dim;
    uint blocks;     /* in_dim / 32 = 36 */
    uint n_used;     /* 8 */
    float inv_scale; /* 1 / sqrt(5) for fused ffn_post_conv + residual */
} pc;

const uint ROWS = 8u;

#ifdef P36_MOE_IQ4NL
const uint BLOCK_U16 = 9u;
const float IQ4NL_INIT[16] = float[16](
    -127.0, -104.0, -83.0, -65.0, -49.0, -35.0, -22.0, -10.0,
       1.0,   13.0,  25.0,  38.0,  53.0,  69.0,  89.0, 113.0
);
shared float sh_lut[16];
#elif defined(P36_MOE_Q5_0)
const uint BLOCK_U16 = 11u;
#else
#error "Define P36_MOE_IQ4NL or P36_MOE_Q5_0"
#endif

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * ROWS;
    uint slot = tid >> 3u;
    uint blane = tid & 7u;
    bool odd = (blane & 1u) != 0u; /* row_u16 is even -> parity is loop-invariant! */

#ifdef P36_MOE_IQ4NL
    if (tid < 16u) sh_lut[tid] = IQ4NL_INIT[tid];
    barrier();
#endif

    uint expert = selected[slot];
    float weight = rw[slot];
    uint x_base = slot * (pc.in_dim >> 2u);
    uint exp_u16 = expert * pc.out_dim * pc.blocks * BLOCK_U16;
    uint row_u16 = pc.blocks * BLOCK_U16;

    float acc[ROWS];
    [[unroll]] for (uint r = 0u; r < ROWS; r++) acc[r] = 0.0;

    for (uint b = blane; b < pc.blocks; b += 8u) {
        uint x4 = x_base + b * 8u;
        vec4 a0 = xv[x4 + 0u];
        vec4 a1 = xv[x4 + 1u];
        vec4 a2 = xv[x4 + 2u];
        vec4 a3 = xv[x4 + 3u];
        vec4 a4 = xv[x4 + 4u];
        vec4 a5 = xv[x4 + 5u];
        vec4 a6 = xv[x4 + 6u];
        vec4 a7 = xv[x4 + 7u];

        [[unroll]] for (uint r = 0u; r < ROWS; r++) {
            uint boff = exp_u16 + (row0 + r) * row_u16 + b * BLOCK_U16;
            uint wi = boff >> 1u;
            float d;
            float s = 0.0;

#ifdef P36_MOE_IQ4NL
            uint u0 = w[wi + 0u];
            uint u1 = w[wi + 1u];
            uint u2 = w[wi + 2u];
            uint u3 = w[wi + 3u];
            uint u4 = w[wi + 4u];
            uint q0, q1, q2, q3;
            if (odd) {
                d = unpackHalf2x16(u0 >> 16u).x;
                q0 = u1; q1 = u2; q2 = u3; q3 = u4;
            } else {
                d = unpackHalf2x16(u0).x;
                q0 = (u0 >> 16u) | (u1 << 16u);
                q1 = (u1 >> 16u) | (u2 << 16u);
                q2 = (u2 >> 16u) | (u3 << 16u);
                q3 = (u3 >> 16u) | (u4 << 16u);
            }

            s += dot(vec4(sh_lut[(q0      ) & 15u], sh_lut[(q0 >>  8u) & 15u],
                          sh_lut[(q0 >> 16u) & 15u], sh_lut[(q0 >> 24u) & 15u]), a0);
            s += dot(vec4(sh_lut[(q1      ) & 15u], sh_lut[(q1 >>  8u) & 15u],
                          sh_lut[(q1 >> 16u) & 15u], sh_lut[(q1 >> 24u) & 15u]), a1);
            s += dot(vec4(sh_lut[(q2      ) & 15u], sh_lut[(q2 >>  8u) & 15u],
                          sh_lut[(q2 >> 16u) & 15u], sh_lut[(q2 >> 24u) & 15u]), a2);
            s += dot(vec4(sh_lut[(q3      ) & 15u], sh_lut[(q3 >>  8u) & 15u],
                          sh_lut[(q3 >> 16u) & 15u], sh_lut[(q3 >> 24u) & 15u]), a3);

            s += dot(vec4(sh_lut[(q0 >>  4u) & 15u], sh_lut[(q0 >> 12u) & 15u],
                          sh_lut[(q0 >> 20u) & 15u], sh_lut[(q0 >> 28u) & 15u]), a4);
            s += dot(vec4(sh_lut[(q1 >>  4u) & 15u], sh_lut[(q1 >> 12u) & 15u],
                          sh_lut[(q1 >> 20u) & 15u], sh_lut[(q1 >> 28u) & 15u]), a5);
            s += dot(vec4(sh_lut[(q2 >>  4u) & 15u], sh_lut[(q2 >> 12u) & 15u],
                          sh_lut[(q2 >> 20u) & 15u], sh_lut[(q2 >> 28u) & 15u]), a6);
            s += dot(vec4(sh_lut[(q3 >>  4u) & 15u], sh_lut[(q3 >> 12u) & 15u],
                          sh_lut[(q3 >> 20u) & 15u], sh_lut[(q3 >> 28u) & 15u]), a7);
#elif defined(P36_MOE_Q5_0)
            uint u0 = w[wi + 0u];
            uint u1 = w[wi + 1u];
            uint u2 = w[wi + 2u];
            uint u3 = w[wi + 3u];
            uint u4 = w[wi + 4u];
            uint u5 = w[wi + 5u];
            uint qh, q0, q1, q2, q3;
            if (odd) {
                d = unpackHalf2x16(u0 >> 16u).x;
                qh = u1; q0 = u2; q1 = u3; q2 = u4; q3 = u5;
            } else {
                d = unpackHalf2x16(u0).x;
                qh = (u0 >> 16u) | (u1 << 16u);
                q0 = (u1 >> 16u) | (u2 << 16u);
                q1 = (u2 >> 16u) | (u3 << 16u);
                q2 = (u3 >> 16u) | (u4 << 16u);
                q3 = (u4 >> 16u) | (u5 << 16u);
            }

            s += dot(vec4(float(int(((q0      ) & 15u) | (((qh      ) & 1u) << 4u)) - 16),
                          float(int(((q0 >>  8u) & 15u) | (((qh >>  1u) & 1u) << 4u)) - 16),
                          float(int(((q0 >> 16u) & 15u) | (((qh >>  2u) & 1u) << 4u)) - 16),
                          float(int(((q0 >> 24u) & 15u) | (((qh >>  3u) & 1u) << 4u)) - 16)), a0);
            s += dot(vec4(float(int(((q1      ) & 15u) | (((qh >>  4u) & 1u) << 4u)) - 16),
                          float(int(((q1 >>  8u) & 15u) | (((qh >>  5u) & 1u) << 4u)) - 16),
                          float(int(((q1 >> 16u) & 15u) | (((qh >>  6u) & 1u) << 4u)) - 16),
                          float(int(((q1 >> 24u) & 15u) | (((qh >>  7u) & 1u) << 4u)) - 16)), a1);
            s += dot(vec4(float(int(((q2      ) & 15u) | (((qh >>  8u) & 1u) << 4u)) - 16),
                          float(int(((q2 >>  8u) & 15u) | (((qh >>  9u) & 1u) << 4u)) - 16),
                          float(int(((q2 >> 16u) & 15u) | (((qh >> 10u) & 1u) << 4u)) - 16),
                          float(int(((q2 >> 24u) & 15u) | (((qh >> 11u) & 1u) << 4u)) - 16)), a2);
            s += dot(vec4(float(int(((q3      ) & 15u) | (((qh >> 12u) & 1u) << 4u)) - 16),
                          float(int(((q3 >>  8u) & 15u) | (((qh >> 13u) & 1u) << 4u)) - 16),
                          float(int(((q3 >> 16u) & 15u) | (((qh >> 14u) & 1u) << 4u)) - 16),
                          float(int(((q3 >> 24u) & 15u) | (((qh >> 15u) & 1u) << 4u)) - 16)), a3);

            s += dot(vec4(float(int(((q0 >>  4u) & 15u) | (((qh >> 16u) & 1u) << 4u)) - 16),
                          float(int(((q0 >> 12u) & 15u) | (((qh >> 17u) & 1u) << 4u)) - 16),
                          float(int(((q0 >> 20u) & 15u) | (((qh >> 18u) & 1u) << 4u)) - 16),
                          float(int(((q0 >> 28u) & 15u) | (((qh >> 19u) & 1u) << 4u)) - 16)), a4);
            s += dot(vec4(float(int(((q1 >>  4u) & 15u) | (((qh >> 20u) & 1u) << 4u)) - 16),
                          float(int(((q1 >> 12u) & 15u) | (((qh >> 21u) & 1u) << 4u)) - 16),
                          float(int(((q1 >> 20u) & 15u) | (((qh >> 22u) & 1u) << 4u)) - 16),
                          float(int(((q1 >> 28u) & 15u) | (((qh >> 23u) & 1u) << 4u)) - 16)), a5);
            s += dot(vec4(float(int(((q2 >>  4u) & 15u) | (((qh >> 24u) & 1u) << 4u)) - 16),
                          float(int(((q2 >> 12u) & 15u) | (((qh >> 25u) & 1u) << 4u)) - 16),
                          float(int(((q2 >> 20u) & 15u) | (((qh >> 26u) & 1u) << 4u)) - 16),
                          float(int(((q2 >> 28u) & 15u) | (((qh >> 27u) & 1u) << 4u)) - 16)), a6);
            s += dot(vec4(float(int(((q3 >>  4u) & 15u) | (((qh >> 28u) & 1u) << 4u)) - 16),
                          float(int(((q3 >> 12u) & 15u) | (((qh >> 29u) & 1u) << 4u)) - 16),
                          float(int(((q3 >> 20u) & 15u) | (((qh >> 30u) & 1u) << 4u)) - 16),
                          float(int(((q3 >> 28u) & 15u) | (((qh >> 31u) & 1u) << 4u)) - 16)), a7);
#endif
            acc[r] = fma(d, s, acc[r]);
        }
    }

    [[unroll]] for (uint r = 0u; r < ROWS; r++) {
        float x3 = subgroupAdd(acc[r] * weight);
        if (tid == 0u) {
            uint c = row0 + r;
            vec4 kw = cw[c];
            float s0 = cs[c];
            float s1 = cs[pc.out_dim + c];
            float s2 = cs[2u * pc.out_dim + c];
            float conv_acc = s0 * kw.x + s1 * kw.y + s2 * kw.z + x3 * kw.w;
            y[c] = (x3 + conv_acc) * pc.inv_scale + res[c];
            cs[c] = s1;
            cs[pc.out_dim + c] = s2;
            cs[2u * pc.out_dim + c] = x3;
        }
    }
}
