#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require

/* Inkling-2-Mini single-tensor MoE gate_up + SITU prefill GEMM.
 * Tile: BM = 32 mid rows x SLOT_TILE = 64 routed slots, swizzled f16vec4 LDS.
 * Parallel gate/up weight loader: threads 0..127 dequantize gate into Ag[32][8],
 * threads 128..255 dequantize up into Au[32][8] -> halves dequant work & VGPRs!
 * Compact 2x4x2 register tile (32 VGPR accumulators -> zero spill, high occupancy)
 * and enough LDS headroom to stage IQ2_S uvec2 sh_grid[1024] (8 KiB -> 16 KiB total).
 * Compile with: P36_MOE_IQ2XXS, P36_MOE_IQ2XS, P36_MOE_IQ2S, P36_MOE_IQ3XXS, or P36_MOE_IQ3S. */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#ifdef P36_MOE_Q4K
layout(set = 0, binding = 0) readonly buffer Weights { uint w[]; };
#else
layout(set = 0, binding = 0) readonly buffer Weights { uint16_t w[]; };
#endif
layout(set = 0, binding = 1) readonly buffer X { vec4 xv[]; };
layout(set = 0, binding = 2) readonly buffer Tiles { uint tiles[]; };
layout(set = 0, binding = 3) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 4) readonly buffer Tables { uint tables[]; };
layout(set = 0, binding = 5) readonly buffer ExpScale { float exp_scale[]; };

layout(push_constant) uniform Push {
    uint mid_dim;
    uint blocks;
    uint n_used;
    float situ_beta;
    float inv_beta;
    float situ_lb;
    float inv_lb;
    uint has_exp_scale;
} pc;

const uint IQ2_U16 = 33u;
const uint IQ2XS_U16 = 37u;
const uint IQ2S_BYTES = 82u;
const uint IQ3XXS_BYTES = 98u;
const uint IQ3S_BYTES = 110u;
const uint Q4K_WORDS = 36u;
const uint TAB_KSIGNS = 512u;
const uint TAB_IQ2S = 544u;
const uint TAB_IQ3S_GRID = 2592u;
const uint TAB_IQ3XXS_GRID = 3104u;
const uint TAB_IQ2XS = 7456u;

const uint SLOT_TILE = 64u;
const uint TILE_WORDS = 1u + SLOT_TILE;
const uint INVALID = 0xffffffffu;
const uint BM = 32u;
const uint KK = 8u;
#define P36_SWZ(i) (((i) >> 1u) & 7u)

#ifndef P36_MOE_Q4K
uint w_u8(uint off) {
    return (uint(w[off >> 1u]) >> (8u * (off & 1u))) & 255u;
}
#endif

#ifdef P36_MOE_IQ2XXS
shared f16vec4 sh_grid0[256];
shared f16vec4 sh_grid1[256];
#elif defined(P36_MOE_IQ2XS)
shared uvec2 sh_grid[512];
shared uint sh_ksigns[128];
#elif defined(P36_MOE_IQ3XXS)
shared f16vec4 sh_grid[256];
shared uint sh_ksigns[128];
#elif defined(P36_MOE_IQ3S)
shared f16vec4 sh_grid[512];
#endif
shared f16vec4 Ag[BM][KK];
shared f16vec4 Au[BM][KK];
shared f16vec4 Bs[SLOT_TILE][KK];
shared float Dg[BM];
shared float Du[BM];
shared uint sh_slot[SLOT_TILE];
shared uint sh_x4[SLOT_TILE];

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * BM;
    uint tile_base = gl_WorkGroupID.y * TILE_WORDS;
    uint expert = tiles[tile_base];
    if (expert == INVALID) return;

    if (tid < SLOT_TILE) {
        uint slot = tiles[tile_base + 1u + tid];
        sh_slot[tid] = slot;
        sh_x4[tid] = (slot != INVALID ? slot / pc.n_used : 0u) * pc.blocks * 64u;
    }
#ifdef P36_MOE_IQ2XXS
    sh_grid0[tid] = f16vec4(vec4(unpack8(tables[2u * tid])) * 0.015625);
    sh_grid1[tid] = f16vec4(vec4(unpack8(tables[2u * tid + 1u])) * 0.015625);
#elif defined(P36_MOE_IQ2XS)
    for (uint i = tid; i < 512u; i += 256u) {
        sh_grid[i] = uvec2(tables[TAB_IQ2XS + 2u * i], tables[TAB_IQ2XS + 2u * i + 1u]);
    }
    if (tid < 32u) {
        uint kw = tables[TAB_KSIGNS + tid];
        sh_ksigns[4u * tid + 0u] = kw & 255u;
        sh_ksigns[4u * tid + 1u] = (kw >> 8u) & 255u;
        sh_ksigns[4u * tid + 2u] = (kw >> 16u) & 255u;
        sh_ksigns[4u * tid + 3u] = kw >> 24u;
    }
#elif defined(P36_MOE_IQ3XXS)
    sh_grid[tid] = f16vec4(vec4(unpack8(tables[TAB_IQ3XXS_GRID + tid])));
    if (tid < 32u) {
        uint kw = tables[TAB_KSIGNS + tid];
        sh_ksigns[4u * tid + 0u] = kw & 255u;
        sh_ksigns[4u * tid + 1u] = (kw >> 8u) & 255u;
        sh_ksigns[4u * tid + 2u] = (kw >> 16u) & 255u;
        sh_ksigns[4u * tid + 3u] = kw >> 24u;
    }
#elif defined(P36_MOE_IQ3S)
    for (uint i = tid; i < 512u; i += 256u) {
        sh_grid[i] = f16vec4(vec4(unpack8(tables[TAB_IQ3S_GRID + i])));
    }
#endif
    barrier();

    /* Parallel gate (tid < 128) / up (tid >= 128) weight loader: 32 rows x 4 subs each */
    bool is_up = (tid >= 128u);
    uint t128 = tid & 127u;
    uint ar = t128 >> 2u;       /* 0..31 */
    uint sub = t128 & 3u;       /* 0..3 */
    uint row = row0 + ar;
    uint exp_row0 = expert * (2u * pc.mid_dim);
    uint w_row = exp_row0 + (is_up ? pc.mid_dim : 0u) + (row < pc.mid_dim ? row : 0u);

#ifdef P36_MOE_IQ2XXS
    uint wbase = w_row * pc.blocks * IQ2_U16;
#elif defined(P36_MOE_IQ2XS)
    uint wbase = w_row * pc.blocks * IQ2XS_U16;
#elif defined(P36_MOE_IQ2S)
    uint wbase = w_row * pc.blocks * IQ2S_BYTES;
#elif defined(P36_MOE_IQ3XXS)
#ifdef P36_GU_STEPMAJOR
    /* step-major gate_up layout (see inkling2_moe_gate_up_decode.comp) */
    uint wbase = (exp_row0 * pc.blocks + (w_row - exp_row0)) * IQ3XXS_BYTES;
#else
    uint wbase = w_row * pc.blocks * IQ3XXS_BYTES;
#endif
#elif defined(P36_MOE_IQ3S)
    uint wbase = w_row * pc.blocks * IQ3S_BYTES;
#elif defined(P36_MOE_Q4K)
#ifdef P36_GU_STEPMAJOR
    uint wbase = (exp_row0 * pc.blocks + (w_row - exp_row0)) * Q4K_WORDS;
#else
    uint wbase = w_row * pc.blocks * Q4K_WORDS;
#endif
#endif

    uint bc0 = tid >> 3u;
    uint bc1 = bc0 + 32u;
    uint bkk = tid & 7u;
    uint sl = tid & 15u;
    uint ry = tid >> 4u;

    float accg[2][4];
    float accu[2][4];
    [[unroll]] for (uint i = 0u; i < 2u; i++) {
        accg[i][0] = 0.0; accg[i][1] = 0.0; accg[i][2] = 0.0; accg[i][3] = 0.0;
        accu[i][0] = 0.0; accu[i][1] = 0.0; accu[i][2] = 0.0; accu[i][3] = 0.0;
    }

    uint sa = P36_SWZ(ar);
    uint a_k0 = (sub * 2u) ^ sa;
    uint a_k1 = (sub * 2u + 1u) ^ sa;
    uint sbit = 7u * sub;
    uint sub_word = sub >> 1u;
    uint sub_shift = 8u * (sub & 1u);

    bool live1 = (sh_slot[16u] != INVALID);
    bool live2 = (sh_slot[32u] != INVALID);
    bool live3 = (sh_slot[48u] != INVALID);
    bool live_b0 = (sh_slot[bc0] != INVALID);
    bool live_b1 = (sh_slot[bc1] != INVALID);
    uint b_k = bkk ^ P36_SWZ(bc0);
    uint b_base0 = live_b0 ? (sh_x4[bc0] + bkk) : 0u;
    uint b_base1 = live_b1 ? (sh_x4[bc1] + bkk) : 0u;

    uint swz_sl = P36_SWZ(sl);
    uint swz_ry = P36_SWZ(ry);
    uint arow[2] = uint[2](ry, ry + 16u);

    uint n_kb = pc.blocks * 8u;
    for (uint kb = 0u; kb < n_kb; kb++) {
        uint sb = kb >> 3u;
        uint ib32 = kb & 7u;

        f16vec4 v0, v1;
        float d_val = 0.0;
        bool write_d = false;

#ifdef P36_MOE_IQ2XXS
        {
            uint wb = wbase + sb * IQ2_U16;
            uint wq = wb + 1u + (ib32 << 2u);
            uint ss = uint(w[wq + 2u]) | (uint(w[wq + 3u]) << 16u);
            uint qs = (uint(w[wq + sub_word]) >> sub_shift) & 255u;
            uint sgn = bitfieldExtract(ss, int(sbit), 7);
            f16vec4 g0 = sh_grid0[qs];
            f16vec4 g1 = sh_grid1[qs];
            v0 = mix(g0, -g0, bvec4((sgn & 1u) != 0u, (sgn & 2u) != 0u, (sgn & 4u) != 0u, (sgn & 8u) != 0u));
            v1 = mix(g1, -g1, bvec4((sgn & 16u) != 0u, (sgn & 32u) != 0u, (sgn & 64u) != 0u, (bitCount(sgn) & 1) != 0));
            if (sub == 0u) {
                d_val = unpackHalf2x16(uint(w[wb])).x * 16.0 * (0.5 + float(ss >> 28u));
                write_d = true;
            }
        }
#elif defined(P36_MOE_IQ2XS)
        {
            uint wb = wbase + sb * IQ2XS_U16;
            uint sc_b = w_u8((wb + 33u) * 2u + ib32);
            uint nib = sub < 2u ? (sc_b & 15u) : (sc_b >> 4u);
            float sc = (0.5 + float(nib)) * 0.015625;
            uint q = uint(w[wb + 1u + 4u * ib32 + sub]);
            uint sgn = sh_ksigns[q >> 9u];
            uvec2 gg = sh_grid[q & 511u];
            vec4 g0 = vec4(unpack8(gg.x));
            vec4 g1 = vec4(unpack8(gg.y));
            g0 = mix(g0, -g0, bvec4((sgn & 1u) != 0u, (sgn & 2u) != 0u, (sgn & 4u) != 0u, (sgn & 8u) != 0u));
            g1 = mix(g1, -g1, bvec4((sgn & 16u) != 0u, (sgn & 32u) != 0u, (sgn & 64u) != 0u, (sgn & 128u) != 0u));
            v0 = f16vec4(g0 * sc);
            v1 = f16vec4(g1 * sc);
            if (sub == 0u && ib32 == 0u) {
                d_val = unpackHalf2x16(uint(w[wb])).x * 16.0;
                write_d = true;
            }
        }
#elif defined(P36_MOE_IQ2S)
        {
            uint wbb = wbase + sb * IQ2S_BYTES;
            uint sc_b = w_u8(wbb + 74u + ib32);
            uint nib = sub < 2u ? (sc_b & 15u) : (sc_b >> 4u);
            float sc = (0.5 + float(nib)) * 0.015625;
            uint sh = (8u - 2u * sub) & 31u;
            uint entry = w_u8(wbb + 2u + 4u * ib32 + sub) | ((w_u8(wbb + 66u + ib32) << sh) & 0x300u);
            uint sgn = w_u8(wbb + 34u + 4u * ib32 + sub);
            vec4 g0 = vec4(unpack8(tables[TAB_IQ2S + entry * 2u]));
            vec4 g1 = vec4(unpack8(tables[TAB_IQ2S + entry * 2u + 1u]));
            g0 = mix(g0, -g0, bvec4((sgn & 1u) != 0u, (sgn & 2u) != 0u, (sgn & 4u) != 0u, (sgn & 8u) != 0u));
            g1 = mix(g1, -g1, bvec4((sgn & 16u) != 0u, (sgn & 32u) != 0u, (sgn & 64u) != 0u, (sgn & 128u) != 0u));
            v0 = f16vec4(g0 * sc);
            v1 = f16vec4(g1 * sc);
            if (sub == 0u && ib32 == 0u) {
                d_val = unpackHalf2x16(uint(w[wbb >> 1u])).x * 16.0;
                write_d = true;
            }
        }
#elif defined(P36_MOE_IQ3XXS)
        {
#ifdef P36_GU_STEPMAJOR
            uint wbb = wbase + sb * 2u * pc.mid_dim * IQ3XXS_BYTES;
#else
            uint wbb = wbase + sb * IQ3XXS_BYTES;
#endif
            uint aux_h = (wbb + 66u + 4u * ib32) >> 1u;
            uint aux = uint(w[aux_h]) | (uint(w[aux_h + 1u]) << 16u);
            uint si = (aux >> sbit) & 127u;
            uint sgn = sh_ksigns[si];
            uint e01 = uint(w[(wbb + 2u + 8u * ib32 + 2u * sub) >> 1u]);
            f16vec4 g0 = sh_grid[e01 & 255u];
            f16vec4 g1 = sh_grid[e01 >> 8u];
            v0 = mix(g0, -g0, bvec4((sgn & 1u) != 0u, (sgn & 2u) != 0u, (sgn & 4u) != 0u, (sgn & 8u) != 0u));
            v1 = mix(g1, -g1, bvec4((sgn & 16u) != 0u, (sgn & 32u) != 0u, (sgn & 64u) != 0u, (sgn & 128u) != 0u));
            if (sub == 0u) {
                d_val = unpackHalf2x16(uint(w[wbb >> 1u])).x * 0.25 * float(2u * (aux >> 28u) + 1u);
                write_d = true;
            }
        }
#elif defined(P36_MOE_IQ3S)
        {
            uint wbb = wbase + sb * IQ3S_BYTES;
            uint qh = w_u8(wbb + 66u + ib32);
            uint e01 = uint(w[(wbb + 2u + 8u * ib32 + 2u * sub) >> 1u]);
            uint e0 = (e01 & 255u) | (((qh >> (2u * sub)) & 1u) << 8u);
            uint e1 = (e01 >> 8u)  | (((qh >> (2u * sub + 1u)) & 1u) << 8u);
            f16vec4 g0 = sh_grid[e0];
            f16vec4 g1 = sh_grid[e1];
            uint sgn = w_u8(wbb + 74u + 4u * ib32 + sub);
            v0 = mix(g0, -g0, bvec4((sgn & 1u) != 0u, (sgn & 2u) != 0u, (sgn & 4u) != 0u, (sgn & 8u) != 0u));
            v1 = mix(g1, -g1, bvec4((sgn & 16u) != 0u, (sgn & 32u) != 0u, (sgn & 64u) != 0u, (sgn & 128u) != 0u));
            if (sub == 0u) {
                uint scb = w_u8(wbb + 106u + (ib32 >> 1u));
                uint nib = (ib32 & 1u) != 0u ? (scb >> 4u) : (scb & 15u);
                d_val = unpackHalf2x16(uint(w[wbb >> 1u])).x * float(2u * nib + 1u);
                write_d = true;
            }
        }
#elif defined(P36_MOE_Q4K)
        {
#ifdef P36_GU_STEPMAJOR
            uint wb = wbase + sb * 2u * pc.mid_dim * Q4K_WORDS;
#else
            uint wb = wbase + sb * Q4K_WORDS;
#endif
            vec2 d2 = unpackHalf2x16(w[wb]);
            uint s0 = w[wb + 1u];
            uint s1 = w[wb + 2u];
            uint sc, mn;
            if (ib32 < 4u) {
                uint sh = ib32 * 8u;
                sc = (s0 >> sh) & 63u;
                mn = (s1 >> sh) & 63u;
            } else {
                uint sh = (ib32 - 4u) * 8u;
                uint s2 = w[wb + 3u];
                sc = ((s2 >> sh) & 15u) | (((s0 >> (sh + 6u)) & 3u) << 4u);
                mn = ((s2 >> (sh + 4u)) & 15u) | (((s1 >> (sh + 6u)) & 3u) << 4u);
            }
            float ds = d2.x * float(sc);
            float dm = -d2.y * float(mn);
            uint nshift = (ib32 & 1u) * 4u;
            uint qw = wb + 4u + (ib32 >> 1u) * 8u + sub * 2u;
            uint ql0 = (w[qw + 0u] >> nshift) & 0x0f0f0f0fu;
            uint ql1 = (w[qw + 1u] >> nshift) & 0x0f0f0f0fu;
            vec4 q0 = vec4(float(ql0 & 15u), float((ql0 >> 8u) & 15u), float((ql0 >> 16u) & 15u), float((ql0 >> 24u) & 15u));
            vec4 q1 = vec4(float(ql1 & 15u), float((ql1 >> 8u) & 15u), float((ql1 >> 16u) & 15u), float((ql1 >> 24u) & 15u));
            v0 = f16vec4(fma(vec4(ds), q0, vec4(dm)));
            v1 = f16vec4(fma(vec4(ds), q1, vec4(dm)));
            if (sub == 0u && kb == 0u) {
                d_val = 1.0;
                write_d = true;
            }
        }
#endif
        if (!is_up) {
            Ag[ar][a_k0] = v0;
            Ag[ar][a_k1] = v1;
            if (write_d) Dg[ar] = d_val;
        } else {
            Au[ar][a_k0] = v0;
            Au[ar][a_k1] = v1;
            if (write_d) Du[ar] = d_val;
        }

        Bs[bc0][b_k] = live_b0 ? f16vec4(xv[b_base0 + kb * 8u]) : f16vec4(0.0hf);
        if (live2) {
            Bs[bc1][b_k] = live_b1 ? f16vec4(xv[b_base1 + kb * 8u]) : f16vec4(0.0hf);
        }
        barrier();

        f16vec2 pkg[2][4];
        f16vec2 pku[2][4];
        [[unroll]] for (uint i = 0u; i < 2u; i++) {
            pkg[i][0] = f16vec2(0.0hf); pkg[i][1] = f16vec2(0.0hf);
            pkg[i][2] = f16vec2(0.0hf); pkg[i][3] = f16vec2(0.0hf);
            pku[i][0] = f16vec2(0.0hf); pku[i][1] = f16vec2(0.0hf);
            pku[i][2] = f16vec2(0.0hf); pku[i][3] = f16vec2(0.0hf);
        }

        if (live3) {
            [[unroll]] for (uint kk = 0u; kk < KK; kk++) {
                uint bk = kk ^ swz_ry ^ swz_sl;
                f16vec4 bv0 = Bs[sl][bk];
                f16vec4 bv1 = Bs[sl + 16u][bk];
                f16vec4 bv2 = Bs[sl + 32u][bk];
                f16vec4 bv3 = Bs[sl + 48u][bk];
                [[unroll]] for (uint i = 0u; i < 2u; i++) {
                    f16vec4 ag = Ag[arow[i]][kk];
                    f16vec4 au = Au[arow[i]][kk];
                    pkg[i][0] = fma(ag.zw, bv0.zw, fma(ag.xy, bv0.xy, pkg[i][0]));
                    pku[i][0] = fma(au.zw, bv0.zw, fma(au.xy, bv0.xy, pku[i][0]));
                    pkg[i][1] = fma(ag.zw, bv1.zw, fma(ag.xy, bv1.xy, pkg[i][1]));
                    pku[i][1] = fma(au.zw, bv1.zw, fma(au.xy, bv1.xy, pku[i][1]));
                    pkg[i][2] = fma(ag.zw, bv2.zw, fma(ag.xy, bv2.xy, pkg[i][2]));
                    pku[i][2] = fma(au.zw, bv2.zw, fma(au.xy, bv2.xy, pku[i][2]));
                    pkg[i][3] = fma(ag.zw, bv3.zw, fma(ag.xy, bv3.xy, pkg[i][3]));
                    pku[i][3] = fma(au.zw, bv3.zw, fma(au.xy, bv3.xy, pku[i][3]));
                }
            }
            [[unroll]] for (uint i = 0u; i < 2u; i++) {
                float dg = Dg[arow[i]];
                float du = Du[arow[i]];
                accg[i][0] = fma(dg, float(pkg[i][0].x) + float(pkg[i][0].y), accg[i][0]);
                accu[i][0] = fma(du, float(pku[i][0].x) + float(pku[i][0].y), accu[i][0]);
                accg[i][1] = fma(dg, float(pkg[i][1].x) + float(pkg[i][1].y), accg[i][1]);
                accu[i][1] = fma(du, float(pku[i][1].x) + float(pku[i][1].y), accu[i][1]);
                accg[i][2] = fma(dg, float(pkg[i][2].x) + float(pkg[i][2].y), accg[i][2]);
                accu[i][2] = fma(du, float(pku[i][2].x) + float(pku[i][2].y), accu[i][2]);
                accg[i][3] = fma(dg, float(pkg[i][3].x) + float(pkg[i][3].y), accg[i][3]);
                accu[i][3] = fma(du, float(pku[i][3].x) + float(pku[i][3].y), accu[i][3]);
            }
        } else if (live2) {
            [[unroll]] for (uint kk = 0u; kk < KK; kk++) {
                uint bk = kk ^ swz_ry ^ swz_sl;
                f16vec4 bv0 = Bs[sl][bk];
                f16vec4 bv1 = Bs[sl + 16u][bk];
                f16vec4 bv2 = Bs[sl + 32u][bk];
                [[unroll]] for (uint i = 0u; i < 2u; i++) {
                    f16vec4 ag = Ag[arow[i]][kk];
                    f16vec4 au = Au[arow[i]][kk];
                    pkg[i][0] = fma(ag.zw, bv0.zw, fma(ag.xy, bv0.xy, pkg[i][0]));
                    pku[i][0] = fma(au.zw, bv0.zw, fma(au.xy, bv0.xy, pku[i][0]));
                    pkg[i][1] = fma(ag.zw, bv1.zw, fma(ag.xy, bv1.xy, pkg[i][1]));
                    pku[i][1] = fma(au.zw, bv1.zw, fma(au.xy, bv1.xy, pku[i][1]));
                    pkg[i][2] = fma(ag.zw, bv2.zw, fma(ag.xy, bv2.xy, pkg[i][2]));
                    pku[i][2] = fma(au.zw, bv2.zw, fma(au.xy, bv2.xy, pku[i][2]));
                }
            }
            [[unroll]] for (uint i = 0u; i < 2u; i++) {
                float dg = Dg[arow[i]];
                float du = Du[arow[i]];
                accg[i][0] = fma(dg, float(pkg[i][0].x) + float(pkg[i][0].y), accg[i][0]);
                accu[i][0] = fma(du, float(pku[i][0].x) + float(pku[i][0].y), accu[i][0]);
                accg[i][1] = fma(dg, float(pkg[i][1].x) + float(pkg[i][1].y), accg[i][1]);
                accu[i][1] = fma(du, float(pku[i][1].x) + float(pku[i][1].y), accu[i][1]);
                accg[i][2] = fma(dg, float(pkg[i][2].x) + float(pkg[i][2].y), accg[i][2]);
                accu[i][2] = fma(du, float(pku[i][2].x) + float(pku[i][2].y), accu[i][2]);
            }
        } else if (live1) {
            [[unroll]] for (uint kk = 0u; kk < KK; kk++) {
                uint bk = kk ^ swz_ry ^ swz_sl;
                f16vec4 bv0 = Bs[sl][bk];
                f16vec4 bv1 = Bs[sl + 16u][bk];
                [[unroll]] for (uint i = 0u; i < 2u; i++) {
                    f16vec4 ag = Ag[arow[i]][kk];
                    f16vec4 au = Au[arow[i]][kk];
                    pkg[i][0] = fma(ag.zw, bv0.zw, fma(ag.xy, bv0.xy, pkg[i][0]));
                    pku[i][0] = fma(au.zw, bv0.zw, fma(au.xy, bv0.xy, pku[i][0]));
                    pkg[i][1] = fma(ag.zw, bv1.zw, fma(ag.xy, bv1.xy, pkg[i][1]));
                    pku[i][1] = fma(au.zw, bv1.zw, fma(au.xy, bv1.xy, pku[i][1]));
                }
            }
            [[unroll]] for (uint i = 0u; i < 2u; i++) {
                float dg = Dg[arow[i]];
                float du = Du[arow[i]];
                accg[i][0] = fma(dg, float(pkg[i][0].x) + float(pkg[i][0].y), accg[i][0]);
                accu[i][0] = fma(du, float(pku[i][0].x) + float(pku[i][0].y), accu[i][0]);
                accg[i][1] = fma(dg, float(pkg[i][1].x) + float(pkg[i][1].y), accg[i][1]);
                accu[i][1] = fma(du, float(pku[i][1].x) + float(pku[i][1].y), accu[i][1]);
            }
        } else {
            [[unroll]] for (uint kk = 0u; kk < KK; kk++) {
                uint bk = kk ^ swz_ry ^ swz_sl;
                f16vec4 bv0 = Bs[sl][bk];
                [[unroll]] for (uint i = 0u; i < 2u; i++) {
                    f16vec4 ag = Ag[arow[i]][kk];
                    f16vec4 au = Au[arow[i]][kk];
                    pkg[i][0] = fma(ag.zw, bv0.zw, fma(ag.xy, bv0.xy, pkg[i][0]));
                    pku[i][0] = fma(au.zw, bv0.zw, fma(au.xy, bv0.xy, pku[i][0]));
                }
            }
            [[unroll]] for (uint i = 0u; i < 2u; i++) {
                float dg = Dg[arow[i]];
                float du = Du[arow[i]];
                accg[i][0] = fma(dg, float(pkg[i][0].x) + float(pkg[i][0].y), accg[i][0]);
                accu[i][0] = fma(du, float(pku[i][0].x) + float(pku[i][0].y), accu[i][0]);
            }
        }
        barrier();
    }

    float es = (pc.has_exp_scale != 0u) ? exp_scale[expert] : 1.0;
    uint s0 = sh_slot[sl];
    uint s1 = live1 ? sh_slot[sl + 16u] : INVALID;
    uint s2 = live2 ? sh_slot[sl + 32u] : INVALID;
    uint s3 = live3 ? sh_slot[sl + 48u] : INVALID;
    [[unroll]] for (uint i = 0u; i < 2u; i++) {
        uint out_row = row0 + arow[i];
        if (out_row >= pc.mid_dim) continue;
        if (s0 != INVALID) {
            float g = accg[i][0] * es, u = accu[i][0] * es;
            y[s0 * pc.mid_dim + out_row] =
                (pc.situ_beta * tanh(g * pc.inv_beta) / (1.0 + exp(-g))) *
                (pc.situ_lb * tanh(u * pc.inv_lb));
        }
        if (s1 != INVALID) {
            float g = accg[i][1] * es, u = accu[i][1] * es;
            y[s1 * pc.mid_dim + out_row] =
                (pc.situ_beta * tanh(g * pc.inv_beta) / (1.0 + exp(-g))) *
                (pc.situ_lb * tanh(u * pc.inv_lb));
        }
        if (s2 != INVALID) {
            float g = accg[i][2] * es, u = accu[i][2] * es;
            y[s2 * pc.mid_dim + out_row] =
                (pc.situ_beta * tanh(g * pc.inv_beta) / (1.0 + exp(-g))) *
                (pc.situ_lb * tanh(u * pc.inv_lb));
        }
        if (s3 != INVALID) {
            float g = accg[i][3] * es, u = accu[i][3] * es;
            y[s3 * pc.mid_dim + out_row] =
                (pc.situ_beta * tanh(g * pc.inv_beta) / (1.0 + exp(-g))) *
                (pc.situ_lb * tanh(u * pc.inv_lb));
        }
    }
}
