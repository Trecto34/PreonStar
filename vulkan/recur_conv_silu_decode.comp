#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Cache {
    float cachev[];
};

layout(set = 0, binding = 1) readonly buffer Current {
    float cur[];
};

layout(set = 0, binding = 2) readonly buffer Kernel {
    float ker[];
};

layout(set = 0, binding = 3) writeonly buffer Output {
    float outv[];
};

layout(push_constant) uniform Push {
    uint conv_dim;
    uint n_taps;
    uint n_tok;
} pc;

float sigmoid_stable(float x) {
    if (x >= 0.0f) {
        float z = exp(-x);
        return 1.0f / (1.0f + z);
    }
    float z = exp(x);
    return z / (1.0f + z);
}

void main(void) {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.conv_dim) return;
    uint hist = pc.n_taps - 1u;
    float k[4];
    for (uint t = 0u; t < pc.n_taps; t++) k[t] = ker[c * pc.n_taps + t];
    uint tok0 = 0u;
    uint tok1 = pc.n_tok;
    if (gl_NumWorkGroups.y > 1u) {
        tok0 = gl_WorkGroupID.y * 32u;
        tok1 = min(tok0 + 32u, pc.n_tok);
        if (tok0 >= pc.n_tok) return;
    }
    float h[3];
    if (tok0 == 0u) {
        for (uint t = 0u; t < hist; t++) h[t] = cachev[t * pc.conv_dim + c];
    } else {
        for (uint t = 0u; t < hist; t++) h[t] = cur[(tok0 - hist + t) * pc.conv_dim + c];
    }
    for (uint tok = tok0; tok < tok1; tok++) {
        float acc = 0.0f;
        for (uint t = 0u; t < hist; t++)
            acc += h[t] * k[t];
        float x = cur[tok * pc.conv_dim + c];
        acc += x * k[hist];
        for (uint t = 0u; t + 1u < hist; t++) h[t] = h[t + 1u];
        h[hist - 1u] = x;
        outv[tok * pc.conv_dim + c] = acc * sigmoid_stable(acc);
    }
    if (gl_NumWorkGroups.y == 1u) {
        for (uint t = 0u; t < hist; t++) cachev[t * pc.conv_dim + c] = h[t];
    }
}
