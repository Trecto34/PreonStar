#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : require

/* Fused loop controller gate (1-way or 3-way Q/K/V in decode):
 *   f = tanh(loop_forget @ h)
 *   g = tanh(loop_gain   @ h)
 *   out = (1 - f) * cur + g * msg
 * Decode (n_tok == 1): 4 rows per wave64, 16 coalesced vec4 lanes per row (576 x n_way WGs).
 * Prefill (n_tok > 1): 64 cols x 16 tokens per WG, loading wf/wg once per 16 tokens. */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer ForgetW0 { vec4 wf0[]; };
layout(set = 0, binding = 1) readonly buffer GainW0 { vec4 wg0[]; };
layout(set = 0, binding = 2) readonly buffer H { vec4 hv[]; };
layout(set = 0, binding = 3) readonly buffer Cur { float cur[]; };
layout(set = 0, binding = 4) readonly buffer Msg { float msg[]; };
layout(set = 0, binding = 5) writeonly buffer Out { float out_buf[]; };
layout(set = 0, binding = 6) readonly buffer ForgetW1 { vec4 wf1[]; };
layout(set = 0, binding = 7) readonly buffer GainW1 { vec4 wg1[]; };
layout(set = 0, binding = 8) readonly buffer ForgetW2 { vec4 wf2[]; };
layout(set = 0, binding = 9) readonly buffer GainW2 { vec4 wg2[]; };

layout(push_constant) uniform Push {
    uint n_embd;
    uint rank;
    uint n_tok;
    uint cur_stride;
    uint msg_stride;
    uint h_stride4;
    uint out_stride;
} pc;

#ifndef P36_DECODE
shared f16vec4 sh_h[16][4];
shared f16vec4 sh_wf[64][4];
shared f16vec4 sh_wg[64][4];
#endif

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint r4 = pc.rank >> 2u; /* 16 */

#ifdef P36_DECODE
    /* 4 output rows per wave64, 16 lanes per row -> 100% coalesced vec4 loads, 0 B LDS! */
    uint j = gl_WorkGroupID.y;
    uint row = gl_WorkGroupID.x * 4u + (tid >> 4u);
    uint k = tid & 15u;
    vec4 vh = hv[j * pc.h_stride4 + k];
    uint widx = row * r4 + k;
    float f;
    float g;
    if (j == 0u) {
        f = dot(wf0[widx], vh);
        g = dot(wg0[widx], vh);
    } else if (j == 1u) {
        f = dot(wf1[widx], vh);
        g = dot(wg1[widx], vh);
    } else {
        f = dot(wf2[widx], vh);
        g = dot(wg2[widx], vh);
    }
    f += subgroupShuffleXor(f, 8u); g += subgroupShuffleXor(g, 8u);
    f += subgroupShuffleXor(f, 4u); g += subgroupShuffleXor(g, 4u);
    f += subgroupShuffleXor(f, 2u); g += subgroupShuffleXor(g, 2u);
    f += subgroupShuffleXor(f, 1u); g += subgroupShuffleXor(g, 1u);
    if (k == 0u && row < pc.n_embd) {
        out_buf[j * pc.out_stride + row] =
            (1.0 - tanh(f)) * cur[j * pc.cur_stride + row] +
            tanh(g) * msg[j * pc.msg_stride + row];
    }
#else
    /* Prefill: 64 cols x up to 16 tokens per WG, packed-f16 coalesced 4-vec4 K-tiles (4.5 KiB LDS) */
    uint col0 = gl_WorkGroupID.x * 64u;
    uint col = col0 + tid;
    uint t0 = gl_WorkGroupID.y * 16u;
    uint nt = min(16u, pc.n_tok - t0);

    float f_acc[16];
    float g_acc[16];
    [[unroll]] for (uint t = 0u; t < 16u; t++) {
        f_acc[t] = 0.0;
        g_acc[t] = 0.0;
    }

    uint lr = tid >> 2u;       /* 0..15: row offset within 16-row strip */
    uint lk = tid & 3u;        /* 0..3: coalesced vec4 lane within 4-vec4 K-tile */

    for (uint k0 = 0u; k0 < r4; k0 += 4u) {
        sh_h[lr][lk] = (lr < nt) ? f16vec4(hv[(t0 + lr) * r4 + k0 + lk]) : f16vec4(0.0hf);
        [[unroll]] for (uint s = 0u; s < 4u; s++) {
            uint r_loc = s * 16u + lr;
            uint c_glob = col0 + r_loc;
            if (c_glob < pc.n_embd) {
                uint wi = c_glob * r4 + k0 + lk;
                sh_wf[r_loc][lk] = f16vec4(wf0[wi]);
                sh_wg[r_loc][lk] = f16vec4(wg0[wi]);
            }
        }
        barrier();

        if (col < pc.n_embd) {
            f16vec2 pf[16];
            f16vec2 pg[16];
            [[unroll]] for (uint t = 0u; t < 16u; t++) {
                pf[t] = f16vec2(0.0hf);
                pg[t] = f16vec2(0.0hf);
            }
            [[unroll]] for (uint k = 0u; k < 4u; k++) {
                f16vec4 fw = sh_wf[tid][k];
                f16vec4 gw = sh_wg[tid][k];
                [[unroll]] for (uint t = 0u; t < 16u; t++) {
                    f16vec4 vh = sh_h[t][k];
                    pf[t] = fma(fw.zw, vh.zw, fma(fw.xy, vh.xy, pf[t]));
                    pg[t] = fma(gw.zw, vh.zw, fma(gw.xy, vh.xy, pg[t]));
                }
            }
            [[unroll]] for (uint t = 0u; t < 16u; t++) {
                f_acc[t] += float(pf[t].x) + float(pf[t].y);
                g_acc[t] += float(pg[t].x) + float(pg[t].y);
            }
        }
        barrier();
    }

    if (col >= pc.n_embd) return;

    for (uint t = 0u; t < nt; t++) {
        uint idx = (t0 + t) * pc.n_embd + col;
        out_buf[idx] = (1.0 - tanh(f_acc[t])) * cur[idx] + tanh(g_acc[t]) * msg[idx];
    }
#endif
}
