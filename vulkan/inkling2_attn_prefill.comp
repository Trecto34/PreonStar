#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : require

/* Inkling-2-Mini GQA-3 FlashAttention prefill (head_dim == 128, BK == 32), key-per-lane.
 * 1 workgroup owns 1 KV head (all 3 GQA query heads) x 8 query tokens (8 half-waves of 32 lanes).
 * For each 32-key tile, lane j of a half-wave scores key j for its query token against all
 * 128 dims (Q broadcast from LDS), so the softmax needs one 32-lane max/sum per TILE instead of
 * a 32-lane dot reduction plus redundant exp2 per KEY. P.V then uses 4 output dims per lane
 * with P broadcast from LDS.
 * Dispatch: (n_head_kv = 8, ceil(n_tok / 8), 1). */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#ifdef KV_Q8
/* Int8 KV: per (slot, head) 34 words = 128 x int8 + 4 x f16 scale (one per 32 dims = 8 lanes). */
#define KV_HEAD(slot) (((slot) * pc.n_head_kv + kvh) * 34u)
vec4 kvq8(uint w, uint sw, uint lane) {
    float d = unpackHalf2x16(sw >> (16u * ((lane >> 3u) & 1u))).x;
    return vec4(float(bitfieldExtract(int(w), 0, 8)), float(bitfieldExtract(int(w), 8, 8)),
                float(bitfieldExtract(int(w), 16, 8)), float(bitfieldExtract(int(w), 24, 8))) * d;
}
#define LOAD_KV(BUF, hb) kvq8(BUF[(hb) + lane], BUF[(hb) + 32u + (lane >> 4u)], lane)
#define KV_ELEM uint
/* Raw words prefetched one tile ahead (16 VGPRs), decoded when written to LDS. */
#define KV_RAW uvec2
#define KV_RAW_ZERO uvec2(0u)
#define LOAD_RAW(BUF, hb) uvec2(BUF[(hb) + lane], BUF[(hb) + 32u + (lane >> 4u)])
#define DECODE_RAW(u) kvq8((u).x, (u).y, lane)
#else
#define KV_HEAD(slot) (((slot) * pc.n_head_kv + kvh) * 32u)
#define LOAD_KV(BUF, hb) vec4(BUF[(hb) + lane])
#define KV_ELEM f16vec4
#define KV_RAW f16vec4
#define KV_RAW_ZERO f16vec4(0.0)
#define LOAD_RAW(BUF, hb) BUF[(hb) + lane]
#define DECODE_RAW(u) vec4(u)
#endif

layout(set = 0, binding = 0) readonly buffer QBuf { vec4 q_buf[]; };
layout(set = 0, binding = 1) readonly buffer RBuf { float r_buf[]; };
layout(set = 0, binding = 2) readonly buffer RelBias { float rel_bias[]; };
layout(set = 0, binding = 3) readonly buffer Sinks { float sinks[]; };
layout(set = 0, binding = 4) readonly buffer GateBuf { vec4 gate_buf[]; };
layout(set = 0, binding = 5) readonly buffer CacheK { KV_ELEM cache_k[]; };
layout(set = 0, binding = 6) readonly buffer CacheV { KV_ELEM cache_v[]; };
layout(set = 0, binding = 7) writeonly buffer OutBuf { vec4 out_buf[]; };
layout(set = 0, binding = 8) readonly buffer NewK { KV_ELEM new_k[]; };
layout(set = 0, binding = 9) readonly buffer NewV { KV_ELEM new_v[]; };

layout(push_constant) uniform Push {
    uint n_head;
    uint n_head_kv;
    uint n_tok;
    uint pos0;
    uint kv_cap;
    uint is_swa;
    uint rel_extent;
    float scale;
} pc;

const uint BK = 32u;
const uint RB_ROWS = 40u;
const uint K_STRIDE = 65u;   /* f16x2 words per K row; +1 pad -> lane j reads bank (j + c) % 32 */
const uint RB_STRIDE = 17u;  /* +1 pad for the per-lane rel_bias row reads */
const float LOG2E = 1.4426950408889634;
const float NEG = -1.0e30;

shared uint sh_k[BK * K_STRIDE];
shared f16vec4 sh_v[BK][32];
shared float sh_rb[RB_ROWS * RB_STRIDE];
shared uvec4 sh_q[8][3][16];      /* per query token: 3 heads x 128 dims as f16, pre-scaled */
shared float sh_r[8][3][16];      /* per query token: 3 heads x 16 rel coefs, pre-scaled */
shared vec4 sh_p[8][BK];          /* per query token: P of 3 heads for each tile key */

float dot8(uvec4 q, uint k0, uint k1, uint k2, uint k3) {
    f16vec2 a = fma(unpackFloat2x16(q.y), unpackFloat2x16(k1), unpackFloat2x16(q.x) * unpackFloat2x16(k0));
    f16vec2 b = fma(unpackFloat2x16(q.w), unpackFloat2x16(k3), unpackFloat2x16(q.z) * unpackFloat2x16(k2));
    return (float(a.x) + float(a.y)) + (float(b.x) + float(b.y));
}

void main(void) {
    uint kvh = gl_WorkGroupID.x;
    uint t0 = gl_WorkGroupID.y * 8u;
    uint tid = gl_LocalInvocationID.x;
    uint hw = tid >> 5u;       /* 0..7: query token within tile */
    uint lane = tid & 31u;     /* key within tile (scores) / 4 output dims (P.V) */
    uint t = t0 + hw;
    bool active_t = (t < pc.n_tok);

    uint h0 = kvh * 3u;
    uint q_pos = pc.pos0 + t;
    float q_scale = pc.scale * LOG2E;

    /* Stage Q (f16, pre-scaled) and R for this half-wave's token. */
    [[unroll]] for (uint hh = 0u; hh < 3u; hh++) {
        vec4 qv = active_t ? q_buf[(t * pc.n_head + h0 + hh) * 32u + lane] * q_scale : vec4(0.0);
        uint w0 = packFloat2x16(f16vec2(qv.xy));
        uint w1 = packFloat2x16(f16vec2(qv.zw));
        /* lane L holds dims 4L..4L+3 = words 2L, 2L+1 = uvec4 L/2, half (L&1) */
        if ((lane & 1u) == 0u) { sh_q[hw][hh][lane >> 1u].x = w0; sh_q[hw][hh][lane >> 1u].y = w1; }
        else                   { sh_q[hw][hh][lane >> 1u].z = w0; sh_q[hw][hh][lane >> 1u].w = w1; }
        if (lane < 16u)
            sh_r[hw][hh][lane] = active_t ? r_buf[(t * pc.n_head + h0 + hh) * 16u + lane] * LOG2E : 0.0;
    }

    float m0 = active_t ? sinks[t * pc.n_head + h0 + 0u] * LOG2E : NEG;
    float m1 = active_t ? sinks[t * pc.n_head + h0 + 1u] * LOG2E : NEG;
    float m2 = active_t ? sinks[t * pc.n_head + h0 + 2u] * LOG2E : NEG;
    float l0 = active_t ? 1.0 : 0.0;
    float l1 = active_t ? 1.0 : 0.0;
    float l2 = active_t ? 1.0 : 0.0;
    vec4 o0 = vec4(0.0);
    vec4 o1 = vec4(0.0);
    vec4 o2 = vec4(0.0);

    uint t_last = min(t0 + 7u, pc.n_tok - 1u);
    uint k_end_tile = pc.pos0 + t_last + 1u;
    uint k_min_tile = (pc.is_swa != 0u && (pc.pos0 + t0) >= pc.rel_extent)
                    ? (pc.pos0 + t0 - pc.rel_extent + 1u) : 0u;
    uint my_k_start = (pc.is_swa != 0u && q_pos >= pc.rel_extent)
                    ? (q_pos - pc.rel_extent + 1u) : 0u;
    uint mask = pc.kv_cap - 1u;
    uint q_pos0 = pc.pos0 + t0;

    /* K/V of the next tile are fetched into registers while the current one is computed,
     * so the global-load latency (DRAM at long context) overlaps the math. */
    KV_RAW pk[4], pv[4];
#define FETCH_TILE(KB) \
    [[unroll]] for (uint r = 0u; r < 4u; r++) { \
        uint k_idx = (KB) + hw + r * 8u; \
        pk[r] = KV_RAW_ZERO; pv[r] = KV_RAW_ZERO; \
        if (k_idx < k_end_tile) { \
            if (pc.is_swa != 0u && k_idx >= pc.pos0) { \
                uint kv_base = KV_HEAD(k_idx - pc.pos0); \
                pk[r] = LOAD_RAW(new_k, kv_base); \
                pv[r] = LOAD_RAW(new_v, kv_base); \
            } else { \
                uint slot = (pc.is_swa != 0u) ? (k_idx & mask) : k_idx; \
                uint kv_base = KV_HEAD(slot); \
                pk[r] = LOAD_RAW(cache_k, kv_base); \
                pv[r] = LOAD_RAW(cache_v, kv_base); \
            } \
        } \
    }
    FETCH_TILE(k_min_tile)

    for (uint kb = k_min_tile; kb < k_end_tile; kb += BK) {
        /* 256 threads write 32 rows x 32 lanes of K/V (+40 rel_bias rows) into LDS. */
        [[unroll]] for (uint r = 0u; r < 4u; r++) {
            uint row = hw + r * 8u;
            vec4 kv = DECODE_RAW(pk[r]), vv = DECODE_RAW(pv[r]);
            sh_k[row * K_STRIDE + 2u * lane]      = packFloat2x16(f16vec2(kv.xy));
            sh_k[row * K_STRIDE + 2u * lane + 1u] = packFloat2x16(f16vec2(kv.zw));
            sh_v[row][lane] = f16vec4(vv);
        }
        if (kb + BK < k_end_tile) FETCH_TILE(kb + BK)
        uint d_base = (q_pos0 >= kb + 31u) ? (q_pos0 - kb - 31u) : 0u;
        /* Workgroup-uniform: every (query, key) pair of this tile is >= rel_extent apart, so
         * every rel_bias row is 0 and the bias FMAs would add exact zeros -- skip both
         * (full-attention layers at long context: almost every tile). */
        bool far_tile = d_base >= pc.rel_extent;
        if (!far_tile)
        for (uint idx = tid; idx < RB_ROWS * 16u; idx += 256u) {
            uint rr = idx >> 4u;
            uint cc = idx & 15u;
            uint d = d_base + rr;
            sh_rb[rr * RB_STRIDE + cc] = (d < pc.rel_extent) ? rel_bias[d * 16u + cc] : 0.0;
        }
        barrier();

        {   /* Uniform per wave64 (inactive tokens: m = NEG, p = 0) so the cluster ops stay legal. */
            /* Scores: lane = key kb + lane. */
            uint key = kb + lane;
            bool valid = active_t && key >= my_k_start && key <= q_pos && key < k_end_tile;
            float s0 = NEG, s1 = NEG, s2 = NEG;
            if (valid) {
                uint kr = lane * K_STRIDE;
                float a0 = 0.0, a1 = 0.0, a2 = 0.0;
                [[unroll]] for (uint c = 0u; c < 16u; c++) {
                    uint k0 = sh_k[kr + 4u * c], k1 = sh_k[kr + 4u * c + 1u];
                    uint k2 = sh_k[kr + 4u * c + 2u], k3 = sh_k[kr + 4u * c + 3u];
                    a0 += dot8(sh_q[hw][0][c], k0, k1, k2, k3);
                    a1 += dot8(sh_q[hw][1][c], k0, k1, k2, k3);
                    a2 += dot8(sh_q[hw][2][c], k0, k1, k2, k3);
                }
                uint rbr = (q_pos - key - d_base) * RB_STRIDE;
                if (!far_tile)
                [[unroll]] for (uint c = 0u; c < 16u; c++) {
                    float rb = sh_rb[rbr + c];
                    a0 = fma(sh_r[hw][0][c], rb, a0);
                    a1 = fma(sh_r[hw][1][c], rb, a1);
                    a2 = fma(sh_r[hw][2][c], rb, a2);
                }
                s0 = a0; s1 = a1; s2 = a2;
            }

            /* Online softmax once per tile (cluster = this half-wave). */
            float mn0 = max(m0, subgroupClusteredMax(s0, 32u));
            float mn1 = max(m1, subgroupClusteredMax(s1, 32u));
            float mn2 = max(m2, subgroupClusteredMax(s2, 32u));
            float p0 = valid ? exp2(s0 - mn0) : 0.0;
            float p1 = valid ? exp2(s1 - mn1) : 0.0;
            float p2 = valid ? exp2(s2 - mn2) : 0.0;
            float al0 = exp2(m0 - mn0), al1 = exp2(m1 - mn1), al2 = exp2(m2 - mn2);
            l0 = fma(l0, al0, subgroupClusteredAdd(p0, 32u));
            l1 = fma(l1, al1, subgroupClusteredAdd(p1, 32u));
            l2 = fma(l2, al2, subgroupClusteredAdd(p2, 32u));
            m0 = mn0; m1 = mn1; m2 = mn2;
            o0 *= al0; o1 *= al1; o2 *= al2;
            sh_p[hw][lane] = vec4(p0, p1, p2, 0.0);
            subgroupMemoryBarrierShared();
            subgroupBarrier();

            /* P.V: lane = 4 output dims. */
            uint j_end = min(BK, k_end_tile - kb);
            for (uint j = 0u; j < j_end; j++) {
                vec4 p = sh_p[hw][j];
                vec4 vv = vec4(sh_v[j][lane]);
                o0 = fma(vv, vec4(p.x), o0);
                o1 = fma(vv, vec4(p.y), o1);
                o2 = fma(vv, vec4(p.z), o2);
            }
        }
        barrier();
    }

    if (active_t) {
        uint ob0 = (t * pc.n_head + h0 + 0u) * 32u + lane;
        uint ob1 = (t * pc.n_head + h0 + 1u) * 32u + lane;
        uint ob2 = (t * pc.n_head + h0 + 2u) * 32u + lane;
        out_buf[ob0] = (o0 * (1.0 / l0)) * (1.0 / (1.0 + exp(-gate_buf[ob0])));
        out_buf[ob1] = (o1 * (1.0 / l1)) * (1.0 / (1.0 + exp(-gate_buf[ob1])));
        out_buf[ob2] = (o2 * (1.0 / l2)) * (1.0 / (1.0 + exp(-gate_buf[ob2])));
    }
}
