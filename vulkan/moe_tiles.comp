#version 460

/* Expert-major tile schedule built on GPU: groups routed pairs by expert
 * and packs up to pair_tile per tile (8 for the matvec kernels, 16 for
 * the prefill GEMMs), so batched MoE never reads the router selection
 * back. The consumer dispatch uses the worst case of one tile per pair;
 * unused trailing tiles keep the 0xffffffff expert marker and the
 * consumers exit on it. Pair order within an expert is atomic-scatter
 * order: each pair's output only depends on its own slot, so results do
 * not change. */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Selected {
    uint selected[];
};

layout(set = 0, binding = 1) buffer Tiles {
    uint tiles[];
};

/* SSD streaming: tile expert fields carry cache slot ids so the matvec
 * kernels index the stream cache buffers directly; the map is the host
 * slot_map uploaded per layer. */
layout(set = 0, binding = 2) readonly buffer SlotMap {
    uint slot_map[];
};

layout(push_constant) uniform Push {
    uint n_slot;
    uint n_expert;
    uint streamed;
    uint pair_tile;
    uint tile_bound;
} pc;

const uint INVALID = 0xffffffffu;

shared uint counts[256];
shared uint offsets[256];
shared uint starts[256];
shared uint tile_off[256];

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    /* pair_tile is always a power of two (8 for the matvec kernels, 16 for
     * the prefill GEMMs), so the per-expert tile rounding below is a shift
     * instead of an emulated integer division: at n_expert = 256 that
     * division alone was the bulk of this single-workgroup kernel's time. */
    uint pt_shift = findLSB(pc.pair_tile);
    uint tile_words = 1u + pc.pair_tile;
    uint words = pc.tile_bound * tile_words;

    counts[tid] = 0u;
    for (uint w = tid; w < words; w += 256u) tiles[w] = INVALID;
    barrier();

    for (uint i = tid; i < pc.n_slot; i += 256u) {
        atomicAdd(counts[selected[i]], 1u);
    }
    barrier();

    /* Exclusive prefix scan over the expert slots.  The schedule only needs
     * counts and ceil(counts/pair_tile) summed in expert order, and doing
     * that on one thread made this single-workgroup kernel cost 16 us of a
     * 1 us job: 256 dependent shared-memory round trips.  Slots with no
     * pairs stay zero, so scanning all 256 is the same prefix. */
    starts[tid] = counts[tid];
    tile_off[tid] = (counts[tid] + pc.pair_tile - 1u) >> pt_shift;
    barrier();
    for (uint d = 1u; d < 256u; d <<= 1u) {
        uint cprev = (tid >= d) ? starts[tid - d] : 0u;
        uint tprev = (tid >= d) ? tile_off[tid - d] : 0u;
        barrier();
        starts[tid] += cprev;
        tile_off[tid] += tprev;
        barrier();
    }
    {
        uint cexcl = (tid == 0u) ? 0u : starts[tid - 1u];
        uint texcl = (tid == 0u) ? 0u : tile_off[tid - 1u];
        barrier();
        starts[tid] = cexcl;
        offsets[tid] = cexcl;
        tile_off[tid] = texcl;
    }
    barrier();

    for (uint i = tid; i < pc.n_slot; i += 256u) {
        uint e = selected[i];
        uint rank = atomicAdd(offsets[e], 1u) - starts[e];
        uint slot = rank & (pc.pair_tile - 1u);
        uint base = (tile_off[e] + (rank >> pt_shift)) * tile_words;
        if (slot == 0u)
            tiles[base] = pc.streamed != 0u ? slot_map[e] : e;
        tiles[base + 1u + slot] = i;
    }
}
