#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#if defined(P36_Q4K_ONLY) || defined(P36_Q5K_ONLY) || defined(P36_Q3K_ONLY) || defined(P36_Q2K_ONLY)
layout(set = 0, binding = 0) readonly buffer Weights { uint ww[]; };
#else
layout(set = 0, binding = 0) readonly buffer Weights { uint16_t wh[]; };
#endif
layout(set = 0, binding = 1) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };

layout(push_constant) uniform Push {
    uint in_dim;
    uint out_dim;
    uint n_tok;
    uint blocks;
    uint row_bytes;
    uint type;
    float scale;
} pc;

const uint Q2_K = 10u;
const uint Q3_K = 11u;
const uint Q4_K = 12u;
const uint Q5_K = 13u;
const uint Q6_K = 14u;
#ifndef P36_BOUNDS
#define P36_BOUNDS 1
#endif
#ifndef P36_ROWS
#define P36_ROWS 4u
#endif
#ifndef P36_ROWS_TOK
#define P36_ROWS_TOK 1u
#endif
const uint ROWS = P36_ROWS;
const uint TOK = P36_ROWS_TOK;
const uint Q8K_WORDS = 74u;

#ifdef P36_Q4K_ONLY
#define QTYPE Q4_K
#elif defined(P36_Q2K_ONLY)
#define QTYPE Q2_K
#elif defined(P36_Q3K_ONLY)
#define QTYPE Q3_K
#elif defined(P36_Q5K_ONLY)
#define QTYPE Q5_K
#else
#define QTYPE pc.type
#endif

uint load_u8(uint off) {
#if defined(P36_Q4K_ONLY) || defined(P36_Q5K_ONLY) || defined(P36_Q3K_ONLY) || defined(P36_Q2K_ONLY)
    return (ww[off >> 2u] >> ((off & 3u) * 8u)) & 255u;
#else
    return (uint(wh[off >> 1u]) >> ((off & 1u) * 8u)) & 255u;
#endif
}

uint load_u32(uint off) {
#if defined(P36_Q4K_ONLY) || defined(P36_Q5K_ONLY) || defined(P36_Q3K_ONLY) || defined(P36_Q2K_ONLY)
    return ww[off >> 2u];
#else
    uint i = off >> 1u;
    return uint(wh[i]) | (uint(wh[i + 1u]) << 16u);
#endif
}

int load_i8(uint off) {
    return bitfieldExtract(int(load_u8(off)), 0, 8);
}

float load_f16(uint off) {
#if defined(P36_Q4K_ONLY) || defined(P36_Q5K_ONLY) || defined(P36_Q3K_ONLY) || defined(P36_Q2K_ONLY)
    return unpackHalf2x16(ww[off >> 2u] >> ((off & 2u) * 8u)).x;
#else
    return unpackHalf2x16(uint(wh[off >> 1u])).x;
#endif
}

void k4_scale_min(uint base, uint j, out uint sc, out uint mn) {
    uint s0 = load_u8(base + 4u + j);
    if (j < 4u) {
        sc = s0 & 63u;
        mn = load_u8(base + 8u + j) & 63u;
    } else {
        uint s1 = load_u8(base + 8u + j);
        uint s2 = load_u8(base + j);
        sc = (s1 & 15u) | ((s2 >> 6u) << 4u);
        mn = (s1 >> 4u) | ((s0 >> 6u) << 4u);
    }
}

uint q2_value(uint base, uint idx) {
    uint in_idx = idx & 127u;
    uint off = base + 16u + (idx >> 7u) * 32u + (in_idx & 31u);
    return (load_u8(off) >> ((in_idx >> 5u) * 2u)) & 3u;
}

int q3_scale(uint base, uint group) {
    uint lo = load_u8(base + 96u + (group & 7u));
    lo = group < 8u ? lo & 15u : lo >> 4u;
    uint hi = (load_u8(base + 104u + (group & 3u)) >>
               (2u * (group >> 2u))) & 3u;
    return int(lo | (hi << 4u)) - 32;
}

int q3_value(uint base, uint idx) {
    uint half_id = idx >> 7u;
    uint group = (idx & 127u) >> 4u;
    uint q = load_u8(base + 32u + half_id * 32u + (idx & 31u));
    uint m = 1u << (half_id * 4u + (group >> 1u));
    uint lo = (q >> (2u * (group >> 1u))) & 3u;
    return int(lo) - ((load_u8(base + (idx & 31u)) & m) != 0u ? 0 : 4);
}

uint q4_value(uint base, uint idx) {
    uint g = idx >> 5u;
    uint v = load_u8(base + 16u + (g >> 1u) * 32u + (idx & 31u));
    return (g & 1u) == 0u ? v & 15u : v >> 4u;
}

uint q5_value(uint base, uint idx) {
    uint g = idx >> 5u;
    uint i = idx & 31u;
    uint v = load_u8(base + 48u + (g >> 1u) * 32u + i);
    uint lo = (g & 1u) == 0u ? v & 15u : v >> 4u;
    return lo | (((load_u8(base + 16u + i) >> g) & 1u) << 4u);
}

uint q6_value(uint base, uint idx) {
    uint half_block = idx >> 7u;
    uint in_idx = idx & 127u;
    uint l = in_idx & 31u;
    uint sel = in_idx >> 5u;
    uint off = half_block * 64u + ((sel & 1u) != 0u ? 32u : 0u) + l;
    uint low = sel < 2u ? load_u8(base + off) & 15u : load_u8(base + off) >> 4u;
    uint hi = (load_u8(base + 128u + half_block * 32u + l) >> (2u * sel)) & 3u;
    return low | (hi << 4u);
}

vec4 dequant_word(uint row, uint block, uint word) {
    uint idx = 4u * word;
    uint base = row * pc.row_bytes;
    vec4 qv;
    if (QTYPE == Q2_K) {
        base += 84u * block;
        uint group = idx >> 4u;
        qv = vec4(q2_value(base, idx), q2_value(base, idx + 1u),
                  q2_value(base, idx + 2u), q2_value(base, idx + 3u));
        return load_f16(base + 80u) * float(load_u8(base + group) & 15u) * qv -
               load_f16(base + 82u) * float(load_u8(base + group) >> 4u);
    }
    if (QTYPE == Q3_K) {
        base += 110u * block;
        uint half_id = idx >> 7u;
        uint group = (idx & 127u) >> 4u;
        uint shift = 2u * (group >> 1u);
        uint m = 1u << (half_id * 4u + (group >> 1u));
        uint qs = (load_u32(base + 32u + half_id * 32u + (idx & 31u)) >> shift) &
                  0x03030303u;
        uint hm = load_u32(base + (idx & 31u));
        qv = vec4(float(qs & 255u), float((qs >> 8u) & 255u),
                  float((qs >> 16u) & 255u), float(qs >> 24u)) -
             4.0 * vec4((hm & (m << 0u)) != 0u ? 0.0 : 1.0,
                        (hm & (m << 8u)) != 0u ? 0.0 : 1.0,
                        (hm & (m << 16u)) != 0u ? 0.0 : 1.0,
                        (hm & (m << 24u)) != 0u ? 0.0 : 1.0);
        return load_f16(base + 108u) * float(q3_scale(base, idx >> 4u)) * qv;
    }
    if (QTYPE == Q4_K || QTYPE == Q5_K) {
        base += (QTYPE == Q4_K ? 144u : 176u) * block;
        uint sc;
        uint mn;
        k4_scale_min(base, idx >> 5u, sc, mn);
        qv = QTYPE == Q4_K ?
            vec4(q4_value(base, idx), q4_value(base, idx + 1u),
                 q4_value(base, idx + 2u), q4_value(base, idx + 3u)) :
            vec4(q5_value(base, idx), q5_value(base, idx + 1u),
                 q5_value(base, idx + 2u), q5_value(base, idx + 3u));
        return load_f16(base) * float(sc) * qv - load_f16(base + 2u) * float(mn);
    }
    base += 210u * block;
    uint half_block = idx >> 7u;
    uint in_idx = idx & 127u;
    uint l = in_idx & 31u;
    uint sel = in_idx >> 5u;
    uint ql_off = half_block * 64u + ((sel & 1u) != 0u ? 32u : 0u) + l;
    uint ql = load_u32(base + ql_off);
    uint qh = load_u32(base + 128u + half_block * 32u + l);
    uint low = sel < 2u ? ql & 0x0f0f0f0fu : (ql >> 4u) & 0x0f0f0f0fu;
    uint packed = low | (((qh >> (2u * sel)) & 0x03030303u) << 4u);
    qv = vec4(float(packed & 255u), float((packed >> 8u) & 255u),
              float((packed >> 16u) & 255u), float(packed >> 24u)) - 32.0;
    return load_f16(base + 208u) *
           float(load_i8(base + 192u + (idx >> 4u))) * qv;
}

#ifdef P36_Q3K_ONLY
/* A Q3_K block is 110 bytes, so odd blocks start 2 bytes off a word boundary.
 * Fetch the 16 bytes at even offset `off` as four aligned words, funnel-shifted
 * when misaligned: 4-5 word loads instead of eight 16-bit ones. */
uvec4 load_16b(uint off) {
    uint w = off >> 2u;
    uvec4 r = uvec4(ww[w], ww[w + 1u], ww[w + 2u], ww[w + 3u]);
    if ((off & 2u) != 0u) {
        uint w4 = ww[w + 4u];
        r = uvec4((r.x >> 16u) | (r.y << 16u), (r.y >> 16u) | (r.z << 16u),
                  (r.z >> 16u) | (r.w << 16u), (r.w >> 16u) | (w4 << 16u));
    }
    return r;
}
#endif

vec4 unpack_i8(uint v) {
    return vec4(float(bitfieldExtract(int(v), 0, 8)),
                float(bitfieldExtract(int(v), 8, 8)),
                float(bitfieldExtract(int(v), 16, 8)),
                float(bitfieldExtract(int(v), 24, 8)));
}

void main(void) {
    uint lid = gl_LocalInvocationID.x;
    uint itid = lid & 15u;
    uint first_row = gl_WorkGroupID.x * ROWS;
    uint ntok = clamp(pc.n_tok, 1u, TOK);
    float acc[ROWS][TOK];
    for (uint r = 0u; r < ROWS; r++)
        for (uint t = 0u; t < TOK; t++) acc[r][t] = 0.0;

    for (uint b = lid >> 4u; b < pc.blocks; b += 4u) {
        /* One q8 row per token.  Inactive t aliases the last live row so a
         * short verify (n_tok 2..3) never reads past the q8 tensor and the
         * register arrays stay statically indexed; acc[r][t] for an inactive
         * t is computed but not written back. */
        vec4 qvec[TOK][4];
        float qsum[TOK];
        float yd[TOK];
        for (uint t = 0u; t < TOK; t++) {
            uint qrow = b + min(t, ntok - 1u) * pc.blocks;
            uint qbase = qrow * Q8K_WORDS;
            for (uint i = 0u; i < 4u; i++)
                qvec[t][i] = unpack_i8(q8[qbase + 2u + 4u * itid + i]);
            float qs = 0.0;
            if (QTYPE == Q4_K || QTYPE == Q5_K || QTYPE == Q6_K || QTYPE == Q3_K) {
                for (uint i = 0u; i < 4u; i++)
                    qs += qvec[t][i].x + qvec[t][i].y + qvec[t][i].z + qvec[t][i].w;
            }
            qsum[t] = qs;
            yd[t] = uintBitsToFloat(q8[qbase]);
        }
        for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
#if P36_BOUNDS
            if (row >= pc.out_dim) continue;
#endif
            if (QTYPE == Q4_K) {
                uint base = row * pc.row_bytes + 144u * b;
                uint group = itid >> 1u;
                uint sc;
                uint mn;
                k4_scale_min(base, group, sc, mn);
                float qdot[TOK];
                for (uint t = 0u; t < TOK; t++) qdot[t] = 0.0;
                for (uint i = 0u; i < 4u; i++) {
                    uint idx = 16u * itid + 4u * i;
                    uint ql = load_u32(base + 16u + (group >> 1u) * 32u +
                                       (idx & 31u));
                    uint packed = (group & 1u) == 0u ?
                        ql & 0x0f0f0f0fu : (ql >> 4u) & 0x0f0f0f0fu;
                    vec4 wv = unpack_i8(packed);
                    for (uint t = 0u; t < TOK; t++)
                        qdot[t] += dot(wv, qvec[t][i]);
                }
                float dw = load_f16(base);
                float dm = load_f16(base + 2u);
                for (uint t = 0u; t < TOK; t++) {
                    float part = dw * float(sc) * qdot[t] -
                                 dm * float(mn) * qsum[t];
                    acc[r][t] = fma(yd[t], part, acc[r][t]);
                }
                continue;
            }
#ifdef P36_Q3K_ONLY
            if (QTYPE == Q3_K) {
                /* Value = lo2 + 4*hbit - 4: dot the 3-bit codes (0..7) and
                 * subtract 4*sum(q8).  Integer-exact, so identical to the
                 * generic path below. */
                uint base = row * pc.row_bytes + 110u * b;
                int sc = q3_scale(base, itid);
                uint half_id = itid >> 3u;
                uint group = itid & 7u;
                uint shift = 2u * (group >> 1u);
                uint hshift = half_id * 4u + (group >> 1u);
                uint lo16 = 16u * (itid & 1u);
                uvec4 qs = load_16b(base + 32u + half_id * 32u + lo16);
                uvec4 hm = load_16b(base + lo16);
                float qdot[TOK];
                for (uint t = 0u; t < TOK; t++) qdot[t] = -4.0 * qsum[t];
                for (uint i = 0u; i < 4u; i++) {
                    uint codes = ((qs[i] >> shift) & 0x03030303u) |
                                 (((hm[i] >> hshift) & 0x01010101u) << 2u);
                    vec4 wv = unpack_i8(codes);
                    for (uint t = 0u; t < TOK; t++)
                        qdot[t] += dot(wv, qvec[t][i]);
                }
                float wsc = load_f16(base + 108u);
                for (uint t = 0u; t < TOK; t++) {
                    float part = yd[t] * wsc * float(sc);
                    acc[r][t] = fma(part, qdot[t], acc[r][t]);
                }
                continue;
            }
#endif
            if (QTYPE == Q2_K) {
                /* 16 consecutive weights per lane: four dword loads cover the
                 * 16 code bytes, instead of 16 scalar byte loads.  The float
                 * expression keeps dequant_word()'s order for bit parity. */
                uint base = row * pc.row_bytes + 84u * b;
                uint half_id = itid >> 3u;
                uint byte0 = (itid & 1u) * 16u;
                uint shift = 2u * ((itid >> 1u) & 3u);
                uint qoff = base + 16u + half_id * 32u + byte0;
                float dsc = load_f16(base + 80u) *
                            float(load_u8(base + itid) & 15u);
                float dmn = load_f16(base + 82u) *
                            float(load_u8(base + itid) >> 4u);
                float part[TOK];
                for (uint t = 0u; t < TOK; t++) part[t] = 0.0;
                for (uint i = 0u; i < 4u; i++) {
                    uint packed = (load_u32(qoff + 4u * i) >> shift) & 0x03030303u;
                    vec4 wv = vec4(float(packed & 255u),
                                   float((packed >> 8u) & 255u),
                                   float((packed >> 16u) & 255u),
                                   float(packed >> 24u));
                    wv = dsc * wv - dmn;
                    for (uint t = 0u; t < TOK; t++)
                        part[t] += dot(wv, qvec[t][i]);
                }
                for (uint t = 0u; t < TOK; t++)
                    acc[r][t] = fma(yd[t], part[t], acc[r][t]);
                continue;
            }
            if (QTYPE == Q3_K) {
                uint base = row * pc.row_bytes + 110u * b;
                int sc = q3_scale(base, itid);
                uint half_id = itid >> 3u;
                uint group = itid & 7u;
                uint shift = 2u * (group >> 1u);
                uint m = 1u << (half_id * 4u + (group >> 1u));
                float qdot[TOK];
                for (uint t = 0u; t < TOK; t++) qdot[t] = 0.0;
                for (uint i = 0u; i < 4u; i++) {
                    uint idx = 16u * itid + 4u * i;
                    uint qs = (load_u32(base + 32u + half_id * 32u + (idx & 31u)) >> shift) &
                              0x03030303u;
                    uint hm = load_u32(base + (idx & 31u));
                    vec4 wv = vec4(float(qs & 255u), float((qs >> 8u) & 255u),
                                   float((qs >> 16u) & 255u), float(qs >> 24u)) -
                        4.0 * vec4((hm & (m << 0u)) != 0u ? 0.0 : 1.0,
                                   (hm & (m << 8u)) != 0u ? 0.0 : 1.0,
                                   (hm & (m << 16u)) != 0u ? 0.0 : 1.0,
                                   (hm & (m << 24u)) != 0u ? 0.0 : 1.0);
                    for (uint t = 0u; t < TOK; t++)
                        qdot[t] += dot(wv, qvec[t][i]);
                }
                float wsc = load_f16(base + 108u);
                for (uint t = 0u; t < TOK; t++) {
                    float part = yd[t] * wsc * float(sc);
                    acc[r][t] = fma(part, qdot[t], acc[r][t]);
                }
                continue;
            }
            if (QTYPE == Q5_K) {
                uint base = row * pc.row_bytes + 176u * b;
                uint group = itid >> 1u;
                uint sc;
                uint mn;
                k4_scale_min(base, group, sc, mn);
                float qdot[TOK];
                for (uint t = 0u; t < TOK; t++) qdot[t] = 0.0;
                for (uint i = 0u; i < 4u; i++) {
                    uint idx = 16u * itid + 4u * i;
                    uint ql = load_u32(base + 48u + (group >> 1u) * 32u +
                                       (idx & 31u));
                    uint low = (group & 1u) == 0u ?
                        ql & 0x0f0f0f0fu : (ql >> 4u) & 0x0f0f0f0fu;
                    uint qh = load_u32(base + 16u + (idx & 31u));
                    uint packed = low | (((qh >> group) & 0x01010101u) << 4u);
                    vec4 wv = unpack_i8(packed);
                    for (uint t = 0u; t < TOK; t++)
                        qdot[t] += dot(wv, qvec[t][i]);
                }
                float dw = load_f16(base);
                float dm = load_f16(base + 2u);
                for (uint t = 0u; t < TOK; t++) {
                    float part = dw * float(sc) * qdot[t] -
                                 dm * float(mn) * qsum[t];
                    acc[r][t] = fma(yd[t], part, acc[r][t]);
                }
                continue;
            }
            if (QTYPE == Q6_K) {
                uint base = row * pc.row_bytes + 210u * b;
                float qdot[TOK];
                for (uint t = 0u; t < TOK; t++) qdot[t] = 0.0;
                for (uint i = 0u; i < 4u; i++) {
                    uint idx = 16u * itid + 4u * i;
                    uint half_block = idx >> 7u;
                    uint in_idx = idx & 127u;
                    uint l = in_idx & 31u;
                    uint sel = in_idx >> 5u;
                    uint ql_off = half_block * 64u +
                        ((sel & 1u) != 0u ? 32u : 0u) + l;
                    uint ql = load_u32(base + ql_off);
                    uint qh = load_u32(base + 128u + half_block * 32u + l);
                    uint low = sel < 2u ? ql & 0x0f0f0f0fu :
                                           (ql >> 4u) & 0x0f0f0f0fu;
                    uint packed = low |
                        (((qh >> (2u * sel)) & 0x03030303u) << 4u);
                    vec4 wv = vec4(float(packed & 255u),
                                   float((packed >> 8u) & 255u),
                                   float((packed >> 16u) & 255u),
                                   float(packed >> 24u));
                    for (uint t = 0u; t < TOK; t++)
                        qdot[t] += dot(wv, qvec[t][i]);
                }
                float dsc = load_f16(base + 208u) *
                            float(load_i8(base + 192u + itid));
                for (uint t = 0u; t < TOK; t++) {
                    float part = dsc * (qdot[t] - 32.0 * qsum[t]);
                    acc[r][t] = fma(yd[t], part, acc[r][t]);
                }
                continue;
            }
            float part[TOK];
            for (uint t = 0u; t < TOK; t++) part[t] = 0.0;
            for (uint i = 0u; i < 4u; i++) {
                vec4 wv = dequant_word(row, b, 4u * itid + i);
                for (uint t = 0u; t < TOK; t++)
                    part[t] += dot(wv, qvec[t][i]);
            }
            for (uint t = 0u; t < TOK; t++)
                acc[r][t] = fma(yd[t], part[t], acc[r][t]);
        }
    }

    for (uint r = 0u; r < ROWS; r++) {
        uint row = first_row + r;
        for (uint t = 0u; t < TOK; t++) {
            float total = subgroupAdd(acc[r][t]);
            if (lid == 0u
#if P36_BOUNDS
                && row < pc.out_dim
#endif
                && t < pc.n_tok
            ) y[t * pc.out_dim + row] = total * pc.scale;
        }
    }
}
