#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#ifdef P36_MOE_IQ3XXS4
#extension GL_EXT_control_flow_attributes : require
#define P36_MOE_IQ3XXS 1
#endif

/* Decode-only Q2_K down projection and routing-weighted sum. One
 * workgroup owns one output row and visits the eight experts in order. */

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint16_t wb[]; };
#ifdef P36_MOE_IQ3XXS4
layout(set = 0, binding = 1) readonly buffer Mid { vec4 mid4[]; };
#else
layout(set = 0, binding = 1) readonly buffer Mid { vec2 mid[]; };
#endif
layout(set = 0, binding = 2) readonly buffer Selected { uint selected[]; };
layout(set = 0, binding = 3) readonly buffer Scales { float scales[]; };
layout(set = 0, binding = 4) readonly buffer RouteWeights { float route[]; };  /* used by the reduce */
layout(set = 0, binding = 5) writeonly buffer Output { float y[]; };
#if defined(P36_MOE_IQ2S) || defined(P36_MOE_IQ3S) || defined(P36_MOE_IQ3XXS)
layout(set = 0, binding = 6) readonly buffer Tables { uint tables[]; };
#endif

layout(push_constant) uniform Push {
    uint out_dim;
    uint in_dim;
    uint blocks;
    uint n_used;
    uint has_scales;
    uint n_tok;     /* identity tokens (MTP verify rows); host-side only */
} pc;

const uint Q2K_U16 = 42u;
#if defined(P36_MOE_IQ2S) || defined(P36_MOE_IQ3S) || defined(P36_MOE_IQ3XXS) || defined(P36_MOE_Q3K)
uint wb_u8(uint off) {
    return (uint(wb[off >> 1u]) >> (8u * (off & 1u))) & 255u;
}
/* IQ3_XXS stores its 32-bit aux word at an even offset, so one aligned read
 * replaces four wb_u8() calls in the inner loop (same bytes, same order). */
uint wb_u32(uint off) {
    uint i = off >> 1u;
    return uint(wb[i]) | (uint(wb[i + 1u]) << 16u);
}
#endif
#ifdef P36_MOE_IQ3XXS
const uint IQ3XXS_BYTES = 98u;
const uint TAB_KSIGNS = 512u;
const uint TAB_IQ3XXS_GRID = 3104u;
#endif
#ifdef P36_MOE_Q3K
const uint Q3K_BYTES = 110u;
#endif
#ifdef P36_MOE_IQ2S
/* IQ2_S superblock: [d f16][32 qs][32 signs][8 qh][8 scales] = 82 bytes. */
const uint IQ2S_BYTES = 82u;
const uint TAB_IQ2S = 544u;
#endif
#ifdef P36_MOE_IQ3S
/* IQ3_S superblock: [d f16][64 qs][8 qh][32 signs][4 scales] = 110 bytes.
 * A 32-element group (itid) owns 8 qs bytes, one qh byte, 4 sign bytes and
 * half a scales byte; the 9-bit grid index selects 4 magnitudes from the
 * 512-entry IQ3_S grid table in the shared IQ tables buffer. */
const uint IQ3S_BYTES = 110u;
const uint TAB_IQ3S_GRID = 2592u;
#endif


#ifdef P36_DOWN_ROWS
/* IQ3_XXS4 with P36_DOWN_ROWS output rows of the same routed slot per workgroup: the
 * lane's 16 activations (half of its loads) are read once per block and
 * reused for every row.  Each row keeps the 1-row build's per-lane weights and
 * fma order, so the partials are bit-identical to it.  Host launches
 * out_dim / P36_DOWN_ROWS workgroups (out_dim a multiple of it). */
const uint DR = P36_DOWN_ROWS;
void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint itid = tid & 15u;
    uint ix = tid >> 4u;
    uint row0 = gl_WorkGroupID.x * DR;
    uint slot = gl_WorkGroupID.y;
    uint expert = selected[slot];
    uint row_bytes = pc.blocks * IQ3XXS_BYTES;
    uint m4 = slot * pc.in_dim / 4u;
    uint g32 = itid >> 1u;
    uint half16 = itid & 1u;
    float acc[DR];
    [[unroll]] for (uint r = 0u; r < DR; r++) acc[r] = 0.0;
    for (uint i = ix; i < pc.blocks; i += 2u) {
        uint y4 = m4 + ((i * 256u + 16u * itid) >> 2u);
        vec4 a[4] = vec4[4](mid4[y4], mid4[y4 + 1u], mid4[y4 + 2u], mid4[y4 + 3u]);
        [[unroll]] for (uint r = 0u; r < DR; r++) {
            uint bb = (expert * pc.out_dim + row0 + r) * row_bytes + i * IQ3XXS_BYTES;
            uint aux = wb_u32(bb + 66u + 4u * g32);
            float wsc = unpackHalf2x16(uint(wb[bb >> 1u])).x * 0.25 * float(2u * (aux >> 28u) + 1u);
            uint eo = (bb + 2u + 8u * g32 + 4u * half16) >> 1u;
            uint ent = uint(wb[eo]) | (uint(wb[eo + 1u]) << 16u);
            [[unroll]] for (uint h = 0u; h < 2u; h++) {
                uint si = (aux >> (7u * (2u * half16 + h))) & 127u;
                uint sign = (tables[TAB_KSIGNS + (si >> 2u)] >> (8u * (si & 3u))) & 255u;
                [[unroll]] for (uint e = 0u; e < 2u; e++) {
                    uint l = 2u * h + e;
                    vec4 gv = vec4(unpack8(tables[TAB_IQ3XXS_GRID + ((ent >> (8u * l)) & 255u)]));
                    uint ss = 4u * e;
                    gv = mix(gv, -gv, bvec4(((sign >> (ss + 0u)) & 1u) != 0u,
                                            ((sign >> (ss + 1u)) & 1u) != 0u,
                                            ((sign >> (ss + 2u)) & 1u) != 0u,
                                            ((sign >> (ss + 3u)) & 1u) != 0u));
                    acc[r] = fma(wsc, dot(gv, a[l]), acc[r]);
                }
            }
        }
    }
    float sc = pc.has_scales != 0u ? scales[expert] : 1.0;
    [[unroll]] for (uint r = 0u; r < DR; r++) {
        float total = subgroupAdd(acc[r]);
        if (tid == 0u) y[slot * pc.out_dim + row0 + r] = total * sc;
    }
}
#else
void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.x;
    uint itid = tid & 15u;
    uint ix = tid >> 4u;
    uint v_im = itid >> 3u;
    uint v_in = itid & 7u;
    uint l0 = 2u * v_in;
    uint q_off16 = (32u * v_im + l0) >> 1u;
    uint y_off = 128u * v_im + l0;
#if defined(P36_MOE_IQ3XXS)
    uint row_bytes = pc.blocks * IQ3XXS_BYTES;
#elif defined(P36_MOE_Q3K)
    uint row_bytes = pc.blocks * Q3K_BYTES;
#elif defined(P36_MOE_IQ3S)
    uint row_bytes = pc.blocks * IQ3S_BYTES;
#elif defined(P36_MOE_IQ2S)
    uint row_bytes = pc.blocks * IQ2S_BYTES;
#else
    uint row_u16 = pc.blocks * Q2K_U16;
#endif
    /* One workgroup per (output row, routed slot): grid.y runs over every
     * slot of every identity token (8 at decode, 8 x rows for an MTP
     * verify).  The serial 8-expert chain this replaces held the kernel at
     * ~58 GB/s; moe_down_route_reduce applies route[] afterwards in expert
     * order with the same fma32, so the sum is bit-identical. */
    {
        uint slot = gl_WorkGroupID.y;
        uint expert = selected[slot];
#if defined(P36_MOE_IQ2S) || defined(P36_MOE_IQ3S) || defined(P36_MOE_IQ3XXS) || defined(P36_MOE_Q3K)
        uint base_bytes = (expert * pc.out_dim + row) * row_bytes;
#else
        uint base_u16 = (expert * pc.out_dim + row) * row_u16;
#endif
#ifdef P36_MOE_IQ3XXS4
        uint m4 = slot * pc.in_dim / 4u;
#else
        uint m2 = slot * pc.in_dim / 2u;
#endif
        float acc = 0.0;

#ifdef P36_MOE_IQ3XXS4
        /* gate/up's lane map: a lane owns 16 consecutive weights of a block
         * (itid*16 ..), one aux word, two 16-bit entry loads for its four
         * grid words, one sign byte per 8 weights and vec4 activations --
         * about half the memory instructions per weight of the 2-weight
         * stride below.  Sums differ from it in the last bits. */
        uint g32 = itid >> 1u;
        uint half16 = itid & 1u;
        for (uint i = ix; i < pc.blocks; i += 2u) {
            uint bb = base_bytes + i * IQ3XXS_BYTES;
            uint aux = wb_u32(bb + 66u + 4u * g32);
            float wsc = unpackHalf2x16(uint(wb[bb >> 1u])).x * 0.25 * float(2u * (aux >> 28u) + 1u);
            uint eo = (bb + 2u + 8u * g32 + 4u * half16) >> 1u;
            uint ent = uint(wb[eo]) | (uint(wb[eo + 1u]) << 16u);
            uint y4 = m4 + ((i * 256u + 16u * itid) >> 2u);
            [[unroll]] for (uint h = 0u; h < 2u; h++) {
                uint si = (aux >> (7u * (2u * half16 + h))) & 127u;
                uint sign = (tables[TAB_KSIGNS + (si >> 2u)] >> (8u * (si & 3u))) & 255u;
                [[unroll]] for (uint e = 0u; e < 2u; e++) {
                    uint l = 2u * h + e;
                    vec4 gv = vec4(unpack8(tables[TAB_IQ3XXS_GRID + ((ent >> (8u * l)) & 255u)]));
                    uint ss = 4u * e;
                    gv = mix(gv, -gv, bvec4(((sign >> (ss + 0u)) & 1u) != 0u,
                                            ((sign >> (ss + 1u)) & 1u) != 0u,
                                            ((sign >> (ss + 2u)) & 1u) != 0u,
                                            ((sign >> (ss + 3u)) & 1u) != 0u));
                    acc = fma(wsc, dot(gv, mid4[y4 + l]), acc);
                }
            }
        }
#elif defined(P36_MOE_IQ3XXS)
        for (uint i = ix; i < pc.blocks; i += 2u) {
            uint bb = base_bytes + i * IQ3XXS_BYTES;
            float d = unpackHalf2x16(uint(wb[bb >> 1u])).x;
            uint y2 = m2 + ((i * 256u + y_off) >> 1u);
            /* n advances by 16 per step, so two consecutive p share one 32-bit
             * aux word; keep the last one instead of reloading it. */
            uint cg32 = 0xffffffffu;
            uint caux = 0u;
            for (uint p = 0u; p < 8u; p++) {
                uint n = y_off + 16u * p;
                uint g32 = n >> 5u;
                uint m = n & 31u;
                if (g32 != cg32) {
                    cg32 = g32;
                    caux = wb_u32(bb + 66u + 4u * g32);
                }
                uint aux = caux;
                uint si = (aux >> (7u * (m >> 3u))) & 127u;
                uint signs = (tables[TAB_KSIGNS + (si >> 2u)] >> (8u * (si & 3u))) & 255u;
                uint entry = wb_u8(bb + 2u + 8u * g32 + (m >> 2u));
                uint word = tables[TAB_IQ3XXS_GRID + entry];
                vec2 gv = vec2(float((word >> (8u * (m & 3u))) & 255u),
                               float((word >> (8u * ((m & 3u) + 1u))) & 255u));
                vec2 gsg = mix(vec2(1.0), vec2(-1.0),
                               bvec2(((signs >> (m & 7u)) & 1u) != 0u,
                                     ((signs >> ((m & 7u) + 1u)) & 1u) != 0u));
                float wsc = d * 0.25 * float(2u * (aux >> 28u) + 1u);
                acc = fma(wsc, dot(gv * gsg, mid[y2 + 8u * p]), acc);
            }
        }
#elif defined(P36_MOE_Q3K)
        for (uint i = ix; i < pc.blocks; i += 2u) {
            uint bb = base_bytes + i * Q3K_BYTES;
            float d = unpackHalf2x16(uint(wb[(bb + 108u) >> 1u])).x;
            uint y2 = m2 + ((i * 256u + y_off) >> 1u);
            for (uint p = 0u; p < 8u; p++) {
                uint n = y_off + 16u * p;
                uint group = n >> 4u;
                uint slo = wb_u8(bb + 96u + (group & 7u));
                uint shi = wb_u8(bb + 104u + (group & 3u));
                int sc = int(((group < 8u ? slo : (slo >> 4u)) & 15u) |
                             (((shi >> (2u * (group >> 2u))) & 3u) << 4u)) - 32;
                vec2 qv;
                for (uint z = 0u; z < 2u; z++) {
                    uint nn = n + z;
                    uint half_id = nn >> 7u;
                    uint g16 = (nn & 127u) >> 4u;
                    uint q = wb_u8(bb + 32u + half_id * 32u + (nn & 31u));
                    uint mask = 1u << (half_id * 4u + (g16 >> 1u));
                    uint lo = (q >> (2u * (g16 >> 1u))) & 3u;
                    qv[z] = float(int(lo) - ((wb_u8(bb + (nn & 31u)) & mask) != 0u ? 0 : 4));
                }
                acc = fma(d * float(sc), dot(qv, mid[y2 + 8u * p]), acc);
            }
        }
#elif defined(P36_MOE_IQ2S)
        /* Same element slotting as the Q2_K path: this thread owns the two
         * elements at y_off + 16*p for p = 0..7 and each 16-element group
         * carries one IQ2_S scale, one grid index and one sign byte. */
        for (uint i = ix; i < pc.blocks; i += 2u) {
            uint bb = base_bytes + i * IQ2S_BYTES;
            float d = unpackHalf2x16(uint(wb[bb >> 1u])).x;
            uint y2 = m2 + ((i * 256u + y_off) >> 1u);
            for (uint p = 0u; p < 8u; p++) {
                uint n = y_off + 16u * p;
                uint ib32 = n >> 5u;
                uint lg = (n >> 3u) & 3u;
                uint j = n & 7u;
                uint scb = wb_u8(bb + 74u + ib32);
                float wsc = d * 0.25 * (0.5 + float(lg < 2u ? (scb & 15u) : (scb >> 4u)));
                uint entry = wb_u8(bb + 2u + 4u * ib32 + lg) |
                             ((wb_u8(bb + 66u + ib32) << (8u - 2u * lg)) & 0x300u);
                uint signs = wb_u8(bb + 34u + 4u * ib32 + lg);
                uint word = tables[TAB_IQ2S + entry * 2u + (j >> 2u)];
                /* Both elements share the 8-group's scale, entry and sign byte,
                 * but each has its own magnitude byte and sign bit. */
                vec2 gv = vec2(float((word >> (8u * (j & 3u))) & 255u),
                               float((word >> (8u * ((j + 1u) & 3u))) & 255u));
                vec2 gsg = mix(vec2(1.0), vec2(-1.0),
                               bvec2(((signs >> j) & 1u) != 0u,
                                     ((signs >> (j + 1u)) & 1u) != 0u));
                vec2 bv = mid[y2 + 8u * p];
                acc = fma(wsc, dot(gv * gsg, bv), acc);
            }
        }
#elif defined(P36_MOE_IQ3S)
        /* Same element slotting: this thread owns the elements y_off + 16*p
         * and +1 for p = 0..7, i.e. the even/odd pair inside one 32-element
         * group, which always shares one 9-bit grid index and one scale. */
        for (uint i = ix; i < pc.blocks; i += 2u) {
            uint bb = base_bytes + i * IQ3S_BYTES;
            float d = unpackHalf2x16(uint(wb[bb >> 1u])).x;
            uint y2 = m2 + ((i * 256u + y_off) >> 1u);
            for (uint p = 0u; p < 8u; p++) {
                uint n = y_off + 16u * p;
                uint g32 = n >> 5u;
                uint sub = (n & 31u) >> 3u;
                uint m = n & 7u;
                uint qh = wb_u8(bb + 66u + g32);
                uint qb = wb_u8(bb + 2u + 8u * g32 + 2u * sub + (m < 4u ? 0u : 1u));
                uint entry = qb | (((qh >> (2u * sub + (m < 4u ? 0u : 1u))) & 1u) << 8u);
                uint word = tables[TAB_IQ3S_GRID + entry];
                uint sgn = wb_u8(bb + 74u + 4u * g32 + sub);
                uint scb = wb_u8(bb + 106u + (g32 >> 1u));
                uint nib = (g32 & 1u) != 0u ? (scb >> 4u) : (scb & 15u);
                float wsc = d * float(2u * nib + 1u);
                vec2 gv = vec2(float((word >> (8u * (m & 3u))) & 255u),
                               float((word >> (8u * ((m & 3u) + 1u))) & 255u));
                vec2 gsg = mix(vec2(1.0), vec2(-1.0),
                               bvec2(((sgn >> m) & 1u) != 0u,
                                     ((sgn >> (m + 1u)) & 1u) != 0u));
                vec2 bv = mid[y2 + 8u * p];
                acc = fma(wsc, dot(gv * gsg, bv), acc);
            }
        }
#else
        for (uint i = ix; i < pc.blocks; i += 2u) {
            uint bb = base_u16 + i * Q2K_U16;
            uint qs_u32 = uint(wb[bb + 8u + q_off16]) |
                          (uint(wb[bb + 8u + q_off16 + 8u]) << 16u);
            vec4 q0 = vec4(unpack8(qs_u32 & 0x03030303u));
            vec4 q2 = vec4(unpack8((qs_u32 >> 2u) & 0x03030303u));
            vec4 q4 = vec4(unpack8((qs_u32 >> 4u) & 0x03030303u));
            vec4 q6 = vec4(unpack8((qs_u32 >> 6u) & 0x03030303u));

            float sc1[8];
            float sc2[8];
            for (uint w = 0u; w < 4u; w++) {
                uint sw = uint(wb[bb + 4u * v_im + w]);
                sc1[2u * w] = float(sw & 0xFu);
                sc2[2u * w] = float((sw >> 4u) & 0xFu);
                sc1[2u * w + 1u] = float((sw >> 8u) & 0xFu);
                sc2[2u * w + 1u] = float((sw >> 12u) & 0xFu);
            }

            vec2 dm = unpackHalf2x16(uint(wb[bb + 40u]) |
                                     (uint(wb[bb + 41u]) << 16u));
            uint yb = m2 + ((i * 256u + y_off) >> 1u);
            vec2 b0 = mid[yb + 0u];
            vec2 b16 = mid[yb + 8u];
            vec2 b32 = mid[yb + 16u];
            vec2 b48 = mid[yb + 24u];
            vec2 b64 = mid[yb + 32u];
            vec2 b80 = mid[yb + 40u];
            vec2 b96 = mid[yb + 48u];
            vec2 b112 = mid[yb + 56u];

            float sum1 = 0.0;
            float sum2 = 0.0;
            for (uint l = 0u; l < 2u; l++) {
                sum1 = fma(b0[l], sc1[0] * q0[l],
                       fma(b16[l], sc1[1] * q0[l + 2u],
                       fma(b32[l], sc1[2] * q2[l],
                       fma(b48[l], sc1[3] * q2[l + 2u],
                       fma(b64[l], sc1[4] * q4[l],
                       fma(b80[l], sc1[5] * q4[l + 2u],
                       fma(b96[l], sc1[6] * q6[l],
                       fma(b112[l], sc1[7] * q6[l + 2u], sum1))))))));
                sum2 = fma(b0[l], sc2[0],
                       fma(b16[l], sc2[1],
                       fma(b32[l], sc2[2],
                       fma(b48[l], sc2[3],
                       fma(b64[l], sc2[4],
                       fma(b80[l], sc2[5],
                       fma(b96[l], sc2[6],
                       fma(b112[l], sc2[7], sum2))))))));
            }
            acc = fma(dm.x, sum1, fma(-dm.y, sum2, acc));
        }
#endif

        acc = subgroupAdd(acc);
        if (tid == 0u) {
            float sc = pc.has_scales != 0u ? scales[expert] : 1.0;
            y[slot * pc.out_dim + row] = acc * sc;
        }
    }
}
#endif
