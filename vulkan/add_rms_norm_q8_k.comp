#version 460

/* Fused residual add + weighted RMS norm + Q8_K activation quantization.
 * One workgroup (1024 threads) per row.
 *
 * Phase 1:
 *   sum[i]  = a[i] + b[i]                (written back, becomes the residual)
 *   norm[i] = rmsnorm(sum)[i] * w[i]
 *   Uses 1024 threads with fp64 reduction tree matching add_rms_norm.comp exactly.
 *
 * Phase 2:
 *   Quantizes the row into 256-element Q8_K blocks directly from registers/LDS.
 *   1024 threads handle 16 blocks (4096 elements) concurrently (64 threads per block).
 *   Loops over rounds of 16 blocks if row width > 4096.
 *   Produces bit-identical Q8_K output to quantize_q8_k.comp.
 *
 * Phase 3 (pc.rot != 0):
 *   Per 1024-element chunk: x * signs * inv_sqrt(1024), 10-stage FWHT in LDS,
 *   then the same 64-thread Q8_K quantizer into had_q8.  Output is
 *   bit-identical to hadamard_prepare.comp, so the caller can skip that
 *   dispatch and the re-read of the norm rows it used to do.
 */

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer A {
    float a[];
};

layout(set = 0, binding = 1) readonly buffer B {
    float b[];
};

layout(set = 0, binding = 2) readonly buffer Weight {
    float w[];
};

layout(set = 0, binding = 3) buffer Sum {
    float s[];
};

layout(set = 0, binding = 4) writeonly buffer Norm {
    float y[];
};

layout(set = 0, binding = 5) writeonly buffer Q8K {
    uint q8[];
};

layout(set = 0, binding = 6) readonly buffer Signs {
    float signs[];
};

layout(set = 0, binding = 7) writeonly buffer HadQ8K {
    uint had_q8[];
};

layout(push_constant) uniform Push {
    uint n;
    float eps;
    uint blocks;
    uint rot;              /* 1 => also emit the rotated quantisation */
    uint sign_offset;      /* element offset into signs[] */
    float inv_sqrt_block;  /* 1 / sqrt(1024) */
} pc;

const uint QK_K = 256u;
const uint Q8K_WORDS = 74u;

shared double sh_sum[1024];
shared float sh_abs[1024];
shared float sh_val[1024];
shared uint  sh_idx[1024];
shared int   sh_sum4[1024];
shared int   sh_bsum[256];

int nearest_int(float fval) {
    /* precise: keep the mul that produces fval from contracting into an fma
     * with this magic-number add, or bytes drift from the CPU quantizer. */
    precise float val = fval + 12582912.0f;
    uint bits = floatBitsToUint(val);
    return int(bits & 0x007fffffu) - 0x00400000;
}

uint pack_i8x4(int a0, int a1, int a2, int a3) {
    return (uint(a0) & 255u)
         | ((uint(a1) & 255u) << 8u)
         | ((uint(a2) & 255u) << 16u)
         | ((uint(a3) & 255u) << 24u);
}

void main(void) {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint base = row * pc.n;

    /* Phase 1: Residual add + RMS norm reduction (fp64) */
    double ss = 0.0;
    for (uint i = tid; i < pc.n; i += 1024u) {
        float x = a[base + i] + b[base + i];
        s[base + i] = x;
        ss += double(x) * double(x);
    }
    memoryBarrierBuffer();
    sh_sum[tid] = ss;
    barrier();
    for (uint sh = 512u; sh > 0u; sh >>= 1u) {
        if (tid < sh) sh_sum[tid] += sh_sum[tid + sh];
        barrier();
    }
    float scale = inversesqrt(float(sh_sum[0] / double(pc.n)) + pc.eps);
    barrier();

    /* Phase 2: Q8_K quantization in rounds of 16 blocks (64 threads per block) */
    uint sub = tid >> 6u;       /* sub-block index 0..15 */
    uint lid = tid & 63u;       /* thread index 0..63 within sub-block */
    uint elem0 = lid * 4u;
    uint total_rounds = (pc.blocks + 15u) / 16u;

    for (uint round = 0u; round < total_rounds; round++) {
        uint b = round * 16u + sub;
        bool active_block = (b < pc.blocks);

        float v[4];
        float best_abs = 0.0f;
        float best_val = 0.0f;
        uint best_idx = elem0;

        if (active_block) {
            uint col0 = b * QK_K + elem0;
            for (uint j = 0u; j < 4u; ++j) {
                uint col = col0 + j;
                float xv = (s[base + col] * scale) * w[col];
                y[base + col] = xv;
                v[j] = xv;
                float ax = abs(xv);
                if (ax > best_abs) {
                    best_abs = ax;
                    best_val = xv;
                    best_idx = elem0 + j;
                }
            }
        }

        sh_abs[tid] = best_abs;
        sh_val[tid] = best_val;
        sh_idx[tid] = best_idx;
        barrier();

        /* Tree reduction across 64 threads in this sub-block */
        for (uint s = 32u; s > 0u; s >>= 1u) {
            if (lid < s) {
                float other_abs = sh_abs[tid + s];
                uint other_idx = sh_idx[tid + s];
                if (other_abs > sh_abs[tid] || (other_abs == sh_abs[tid] && other_idx < sh_idx[tid])) {
                    sh_abs[tid] = other_abs;
                    sh_val[tid] = sh_val[tid + s];
                    sh_idx[tid] = other_idx;
                }
            }
            barrier();
        }

        /* fp64 division for exact d computation matching CPU and quantize_q8_k.comp */
        float maxv = sh_val[sub * 64u];
        float iscale = maxv != 0.0f ? float(-127.0 / double(maxv)) : 0.0f;
        float d = iscale != 0.0f ? float(1.0 / double(iscale)) : 0.0f;

        int qv[4];
        int sum4 = 0;
        if (active_block) {
            for (uint j = 0u; j < 4u; ++j) {
                float xv = v[j];
                int q = iscale != 0.0f ? nearest_int(iscale * xv) : 0;
                if (q > 127) q = 127;
                qv[j] = q;
                sum4 += q;
            }

            uint out_base = (row * pc.blocks + b) * Q8K_WORDS;
            if (lid == 0u) {
                q8[out_base + 0u] = floatBitsToUint(d);
                q8[out_base + 1u] = 0u;
            }
            q8[out_base + 2u + lid] = pack_i8x4(qv[0], qv[1], qv[2], qv[3]);
        }

        sh_sum4[tid] = sum4;
        barrier();

        if (active_block && (lid & 3u) == 0u) {
            sh_bsum[sub * 16u + (lid >> 2u)] = sh_sum4[tid] + sh_sum4[tid + 1u] +
                                              sh_sum4[tid + 2u] + sh_sum4[tid + 3u];
        }
        barrier();

        if (active_block && lid < 8u) {
            uint out_base = (row * pc.blocks + b) * Q8K_WORDS;
            int s0 = sh_bsum[sub * 16u + 2u * lid + 0u];
            int s1 = sh_bsum[sub * 16u + 2u * lid + 1u];
            q8[out_base + 66u + lid] = (uint(s0) & 0xffffu) | ((uint(s1) & 0xffffu) << 16u);
        }
        barrier();
    }

    /* Phase 3: optional rotated quantisation.  sh_abs doubles as the FWHT
     * scratch: phase 2 is finished, and a barrier separates the last read of
     * the transformed chunk from the max-abs pass that reuses the array. */
    if (pc.rot != 0u) {
        float qregs[4];
        for (uint c = 0u; c < pc.n; c += 1024u) {
            uint col = c + tid;
            float x = 0.0f;
            if (col < pc.n) {
                /* Same value phase 2 wrote to y[col], times signs and the
                 * 1/sqrt(1024) the rotation is normalised by. */
                x = ((s[base + col] * scale) * w[col]) * signs[pc.sign_offset + col] *
                    pc.inv_sqrt_block;
            }
            sh_abs[tid] = x;
            barrier();
            for (uint h = 1u; h < 1024u; h <<= 1u) {
                if ((tid & h) == 0u) {
                    float lo = sh_abs[tid];
                    float hi = sh_abs[tid + h];
                    sh_abs[tid] = lo + hi;
                    sh_abs[tid + h] = lo - hi;
                }
                barrier();
            }

            uint rsub = tid >> 6u;      /* Q8_K block inside the chunk, 0..3 */
            uint rlid = tid & 63u;
            uint relem = rlid * 4u;
            uint rb = (c >> 8u) + rsub;
            bool ractive = (rb < pc.blocks);

            float rmax_abs = 0.0f;
            float rmax_val = 0.0f;
            uint rmax_idx = relem;
            for (uint j = 0u; j < 4u; ++j) {
                qregs[j] = 0.0f;
                if (ractive) {
                    float xv = sh_abs[rsub * 256u + relem + j];
                    qregs[j] = xv;
                    float ax = abs(xv);
                    if (ax > rmax_abs) {
                        rmax_abs = ax;
                        rmax_val = xv;
                        rmax_idx = relem + j;
                    }
                }
            }
            barrier();  /* chunk reads done before sh_abs is reused */

            sh_abs[tid] = rmax_abs;
            sh_val[tid] = rmax_val;
            sh_idx[tid] = rmax_idx;
            barrier();

            for (uint s = 32u; s > 0u; s >>= 1u) {
                if (rlid < s) {
                    float other_abs = sh_abs[tid + s];
                    uint other_idx = sh_idx[tid + s];
                    if (other_abs > sh_abs[tid] || (other_abs == sh_abs[tid] && other_idx < sh_idx[tid])) {
                        sh_abs[tid] = other_abs;
                        sh_val[tid] = sh_val[tid + s];
                        sh_idx[tid] = other_idx;
                    }
                }
                barrier();
            }

            float rmaxv = sh_val[rsub * 64u];
            float riscale = rmaxv != 0.0f ? float(-127.0 / double(rmaxv)) : 0.0f;
            float rd = riscale != 0.0f ? float(1.0 / double(riscale)) : 0.0f;

            int rqv[4];
            int rsum4 = 0;
            if (ractive) {
                for (uint j = 0u; j < 4u; ++j) {
                    int q = riscale != 0.0f ? nearest_int(riscale * qregs[j]) : 0;
                    if (q > 127) q = 127;
                    rqv[j] = q;
                    rsum4 += q;
                }

                uint out_base = (row * pc.blocks + rb) * Q8K_WORDS;
                if (rlid == 0u) {
                    had_q8[out_base + 0u] = floatBitsToUint(rd);
                    had_q8[out_base + 1u] = 0u;
                }
                had_q8[out_base + 2u + rlid] = pack_i8x4(rqv[0], rqv[1], rqv[2], rqv[3]);
            }

            sh_sum4[tid] = rsum4;
            barrier();

            if (ractive && (rlid & 3u) == 0u) {
                sh_bsum[rsub * 16u + (rlid >> 2u)] = sh_sum4[tid] + sh_sum4[tid + 1u] +
                                                     sh_sum4[tid + 2u] + sh_sum4[tid + 3u];
            }
            barrier();

            if (ractive && rlid < 8u) {
                uint out_base = (row * pc.blocks + rb) * Q8K_WORDS;
                int s0 = sh_bsum[rsub * 16u + 2u * rlid + 0u];
                int s1 = sh_bsum[rsub * 16u + 2u * rlid + 1u];
                had_q8[out_base + 66u + rlid] = (uint(s0) & 0xffffu) | ((uint(s1) & 0xffffu) << 16u);
            }
            barrier();
        }
    }
}
