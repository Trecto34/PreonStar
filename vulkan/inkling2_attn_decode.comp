#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : require

/* Inkling-2-Mini Split-K + GQA-3 FlashAttention decode (n_tok == 1, head_dim == 128, F16 KV).
 * Each workgroup handles 1 KV head (ALL 3 GQA query heads simultaneously!) and 1 K-split.
 * Optimizations:
 *  - Fused Q.K + R.rel_bias inside ONE sum32 (-15 ds_bpermute shuffles per key!)
 *  - Pre-scaled LOG2E for native hardware exp2() (v_exp_f32, -9 FMULs per key!)
 * 256 threads = 8 half-waves of 32 lanes (each 32-lane half-wave owns 1 KV pos, 4 dims/lane).
 * Dispatch: (n_head_kv = 8, n_splits, 1). */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QBuf { vec4 q_buf[]; };
layout(set = 0, binding = 1) readonly buffer RBuf { float r_buf[]; };
layout(set = 0, binding = 2) readonly buffer RelBias { float rel_bias[]; };
layout(set = 0, binding = 3) readonly buffer Sinks { float sinks[]; };
layout(set = 0, binding = 4) readonly buffer GateBuf { vec4 gate_buf[]; };
layout(set = 0, binding = 5) readonly buffer CacheK { f16vec4 cache_k[]; };
layout(set = 0, binding = 6) readonly buffer CacheV { f16vec4 cache_v[]; };
layout(set = 0, binding = 7) writeonly buffer OutBuf { vec4 out_buf[]; };
layout(set = 0, binding = 8) writeonly buffer PartBuf { float part_buf[]; };

layout(push_constant) uniform Push {
    uint n_head;
    uint n_head_kv;
    uint pos;
    uint kv_cap;
    uint is_swa;
    uint rel_extent;
    uint n_splits;
    float scale;
} pc;

const float LOG2E = 1.4426950408889634;
const float LN2   = 0.6931471805599453;

shared float sh_m[3][8];
shared float sh_l[3][8];
shared vec4 sh_o[3][8][32];

void sum32_3(inout float v0, inout float v1, inout float v2) {
    v0 += subgroupShuffleXor(v0, 16u); v1 += subgroupShuffleXor(v1, 16u); v2 += subgroupShuffleXor(v2, 16u);
    v0 += subgroupShuffleXor(v0,  8u); v1 += subgroupShuffleXor(v1,  8u); v2 += subgroupShuffleXor(v2,  8u);
    v0 += subgroupShuffleXor(v0,  4u); v1 += subgroupShuffleXor(v1,  4u); v2 += subgroupShuffleXor(v2,  4u);
    v0 += subgroupShuffleXor(v0,  2u); v1 += subgroupShuffleXor(v1,  2u); v2 += subgroupShuffleXor(v2,  2u);
    v0 += subgroupShuffleXor(v0,  1u); v1 += subgroupShuffleXor(v1,  1u); v2 += subgroupShuffleXor(v2,  1u);
}

void sum32_6(inout float a0, inout float a1, inout float a2,
             inout float b0, inout float b1, inout float b2) {
    a0 += subgroupShuffleXor(a0, 16u); a1 += subgroupShuffleXor(a1, 16u); a2 += subgroupShuffleXor(a2, 16u);
    b0 += subgroupShuffleXor(b0, 16u); b1 += subgroupShuffleXor(b1, 16u); b2 += subgroupShuffleXor(b2, 16u);
    a0 += subgroupShuffleXor(a0,  8u); a1 += subgroupShuffleXor(a1,  8u); a2 += subgroupShuffleXor(a2,  8u);
    b0 += subgroupShuffleXor(b0,  8u); b1 += subgroupShuffleXor(b1,  8u); b2 += subgroupShuffleXor(b2,  8u);
    a0 += subgroupShuffleXor(a0,  4u); a1 += subgroupShuffleXor(a1,  4u); a2 += subgroupShuffleXor(a2,  4u);
    b0 += subgroupShuffleXor(b0,  4u); b1 += subgroupShuffleXor(b1,  4u); b2 += subgroupShuffleXor(b2,  4u);
    a0 += subgroupShuffleXor(a0,  2u); a1 += subgroupShuffleXor(a1,  2u); a2 += subgroupShuffleXor(a2,  2u);
    b0 += subgroupShuffleXor(b0,  2u); b1 += subgroupShuffleXor(b1,  2u); b2 += subgroupShuffleXor(b2,  2u);
    a0 += subgroupShuffleXor(a0,  1u); a1 += subgroupShuffleXor(a1,  1u); a2 += subgroupShuffleXor(a2,  1u);
    b0 += subgroupShuffleXor(b0,  1u); b1 += subgroupShuffleXor(b1,  1u); b2 += subgroupShuffleXor(b2,  1u);
}

void main(void) {
    uint kvh = gl_WorkGroupID.x;
    uint split = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    uint hw = tid >> 5u;       /* 0..7 half-wave */
    uint lane = tid & 31u;     /* 0..31: 4 dims per lane -> 128 dims total */

    uint h0 = kvh * 3u;
    float q_scale = pc.scale * LOG2E;
    vec4 q0 = q_buf[(h0 + 0u) * 32u + lane] * q_scale;
    vec4 q1 = q_buf[(h0 + 1u) * 32u + lane] * q_scale;
    vec4 q2 = q_buf[(h0 + 2u) * 32u + lane] * q_scale;

    float r0 = (lane < 16u) ? r_buf[(h0 + 0u) * 16u + lane] * LOG2E : 0.0;
    float r1 = (lane < 16u) ? r_buf[(h0 + 1u) * 16u + lane] * LOG2E : 0.0;
    float r2 = (lane < 16u) ? r_buf[(h0 + 2u) * 16u + lane] * LOG2E : 0.0;

    uint k_start_all = (pc.is_swa != 0u && pc.pos >= pc.rel_extent) ? (pc.pos - pc.rel_extent + 1u) : 0u;
    uint k_end_all = pc.pos + 1u;
    uint k_total = k_end_all - k_start_all;
    uint k_per = (k_total + pc.n_splits - 1u) / pc.n_splits;
    uint k_begin = k_start_all + split * k_per;
    uint k_end = min(k_begin + k_per, k_end_all);

    bool is_sink_owner = (split == 0u && hw == 0u);
    float m0 = is_sink_owner ? sinks[h0 + 0u] * LOG2E : -1.0e30;
    float m1 = is_sink_owner ? sinks[h0 + 1u] * LOG2E : -1.0e30;
    float m2 = is_sink_owner ? sinks[h0 + 2u] * LOG2E : -1.0e30;
    float l0 = is_sink_owner ? 1.0 : 0.0;
    float l1 = is_sink_owner ? 1.0 : 0.0;
    float l2 = is_sink_owner ? 1.0 : 0.0;
    vec4 o0 = vec4(0.0);
    vec4 o1 = vec4(0.0);
    vec4 o2 = vec4(0.0);

    uint mask = pc.kv_cap - 1u;
    uint k = k_begin + hw;
    for (; k + 8u < k_end; k += 16u) {
        uint k1 = k + 8u;
        uint slot0 = (pc.is_swa != 0u) ? (k & mask) : k;
        uint slot1 = (pc.is_swa != 0u) ? (k1 & mask) : k1;
        uint kv_base0 = (slot0 * pc.n_head_kv + kvh) * 32u + lane;
        uint kv_base1 = (slot1 * pc.n_head_kv + kvh) * 32u + lane;
        vec4 kv0 = vec4(cache_k[kv_base0]);
        vec4 kv1 = vec4(cache_k[kv_base1]);
        vec4 vv0 = vec4(cache_v[kv_base0]);
        vec4 vv1 = vec4(cache_v[kv_base1]);

        uint dist0 = pc.pos - k;
        uint dist1 = pc.pos - k1;
        float rb0 = (dist0 < pc.rel_extent && lane < 16u) ? rel_bias[dist0 * 16u + lane] : 0.0;
        float rb1 = (dist1 < pc.rel_extent && lane < 16u) ? rel_bias[dist1 * 16u + lane] : 0.0;

        float s0a = fma(r0, rb0, dot(q0, kv0));
        float s1a = fma(r1, rb0, dot(q1, kv0));
        float s2a = fma(r2, rb0, dot(q2, kv0));
        float s0b = fma(r0, rb1, dot(q0, kv1));
        float s1b = fma(r1, rb1, dot(q1, kv1));
        float s2b = fma(r2, rb1, dot(q2, kv1));
        sum32_6(s0a, s1a, s2a, s0b, s1b, s2b);

        float mp0 = max(s0a, s0b);
        if (mp0 > m0) {
            float a0 = exp2(m0 - mp0);
            float pa = exp2(s0a - mp0);
            float pb = exp2(s0b - mp0);
            o0 = fma(o0, vec4(a0), fma(vv0, vec4(pa), vv1 * pb));
            l0 = fma(l0, a0, pa + pb);
            m0 = mp0;
        } else {
            float pa = exp2(s0a - m0);
            float pb = exp2(s0b - m0);
            o0 = fma(vv0, vec4(pa), fma(vv1, vec4(pb), o0));
            l0 += pa + pb;
        }

        float mp1 = max(s1a, s1b);
        if (mp1 > m1) {
            float a1 = exp2(m1 - mp1);
            float pa = exp2(s1a - mp1);
            float pb = exp2(s1b - mp1);
            o1 = fma(o1, vec4(a1), fma(vv0, vec4(pa), vv1 * pb));
            l1 = fma(l1, a1, pa + pb);
            m1 = mp1;
        } else {
            float pa = exp2(s1a - m1);
            float pb = exp2(s1b - m1);
            o1 = fma(vv0, vec4(pa), fma(vv1, vec4(pb), o1));
            l1 += pa + pb;
        }

        float mp2 = max(s2a, s2b);
        if (mp2 > m2) {
            float a2 = exp2(m2 - mp2);
            float pa = exp2(s2a - mp2);
            float pb = exp2(s2b - mp2);
            o2 = fma(o2, vec4(a2), fma(vv0, vec4(pa), vv1 * pb));
            l2 = fma(l2, a2, pa + pb);
            m2 = mp2;
        } else {
            float pa = exp2(s2a - m2);
            float pb = exp2(s2b - m2);
            o2 = fma(vv0, vec4(pa), fma(vv1, vec4(pb), o2));
            l2 += pa + pb;
        }
    }
    if (k < k_end) {
        uint slot = (pc.is_swa != 0u) ? (k & mask) : k;
        uint kv_base = (slot * pc.n_head_kv + kvh) * 32u + lane;
        vec4 kv = vec4(cache_k[kv_base]);

        uint dist = pc.pos - k;
        float rb = (dist < pc.rel_extent && lane < 16u) ? rel_bias[dist * 16u + lane] : 0.0;

        vec4 vv = vec4(cache_v[kv_base]);
        float s0 = fma(r0, rb, dot(q0, kv));
        float s1 = fma(r1, rb, dot(q1, kv));
        float s2 = fma(r2, rb, dot(q2, kv));
        sum32_3(s0, s1, s2);

        if (s0 > m0) {
            float a0 = exp2(m0 - s0);
            o0 = fma(o0, vec4(a0), vv);
            l0 = fma(l0, a0, 1.0);
            m0 = s0;
        } else {
            float p0 = exp2(s0 - m0);
            o0 = fma(vv, vec4(p0), o0);
            l0 += p0;
        }

        if (s1 > m1) {
            float a1 = exp2(m1 - s1);
            o1 = fma(o1, vec4(a1), vv);
            l1 = fma(l1, a1, 1.0);
            m1 = s1;
        } else {
            float p1 = exp2(s1 - m1);
            o1 = fma(vv, vec4(p1), o1);
            l1 += p1;
        }

        if (s2 > m2) {
            float a2 = exp2(m2 - s2);
            o2 = fma(o2, vec4(a2), vv);
            l2 = fma(l2, a2, 1.0);
            m2 = s2;
        } else {
            float p2 = exp2(s2 - m2);
            o2 = fma(vv, vec4(p2), o2);
            l2 += p2;
        }
    }

    if (lane == 0u) {
        sh_m[0][hw] = m0; sh_l[0][hw] = l0;
        sh_m[1][hw] = m1; sh_l[1][hw] = l1;
        sh_m[2][hw] = m2; sh_l[2][hw] = l2;
    }
    sh_o[0][hw][lane] = o0;
    sh_o[1][hw][lane] = o1;
    sh_o[2][hw][lane] = o2;
    barrier();

    /* Merge 8 half-waves across 3 heads using first 3 half-waves (threads 0..95) */
    if (hw < 3u) {
        float ma = -1.0e30;
        [[unroll]] for (uint i = 0u; i < 8u; i++) ma = max(ma, sh_m[hw][i]);
        float la = 0.0;
        vec4 oa = vec4(0.0);
        [[unroll]] for (uint i = 0u; i < 8u; i++) {
            float w = (sh_l[hw][i] > 0.0) ? exp2(sh_m[hw][i] - ma) : 0.0;
            la += sh_l[hw][i] * w;
            oa += sh_o[hw][i][lane] * w;
        }
        uint h = h0 + hw;
        if (pc.n_splits == 1u) {
            vec4 y = oa * (1.0 / la);
            vec4 g = 1.0 / (1.0 + exp(-gate_buf[h * 32u + lane]));
            out_buf[h * 32u + lane] = y * g;
        } else {
            /* PartBuf layout: [n_head, n_splits, 132] -> [m (log2), l, pad, pad, O[0..127]] */
            uint pbase = (h * pc.n_splits + split) * 132u;
            if (lane == 0u) {
                part_buf[pbase + 0u] = ma;
                part_buf[pbase + 1u] = la;
            }
            part_buf[pbase + 4u + lane * 4u + 0u] = oa.x;
            part_buf[pbase + 4u + lane * 4u + 1u] = oa.y;
            part_buf[pbase + 4u + lane * 4u + 2u] = oa.z;
            part_buf[pbase + 4u + lane * 4u + 3u] = oa.w;
        }
    }
}
