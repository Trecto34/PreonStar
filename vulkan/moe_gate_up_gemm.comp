#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : enable

/* Routed IQ2_XXS gate/up/SwiGLU GEMM for prefill batches: one workgroup
 * owns a 64-mid-row x 32-slot tile of one expert's token group. The
 * expert row block dequantizes into shared memory once per k-block and
 * is applied to all 32 slots through packed f16 FMAs, so the dequant
 * and weight traffic amortize over the tile instead of per 8 routed
 * pairs, and no subgroup reduction runs at all.
 *
 * Numerics: grid values stage as +/-grid * 2^-6 (exact in f16, grid
 * <= 43) and activations round once to f16; packed even/odd-k partial
 * sums flush to f32 accumulators every 32-element scale group with the
 * group scale (db * 64) folded in. Per-output k order is fixed for any
 * n_tok, but the order differs from the decode matvec: prefill and
 * decode numerics diverge by ~1e-3, which the relaxed strict (not
 * bit-exact) warm==cold session gate absorbs. */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer GateWeights { uint16_t gw[]; };
layout(set = 0, binding = 1) readonly buffer UpWeights { uint16_t uw[]; };
layout(set = 0, binding = 2) readonly buffer X { vec4 xv[]; };
layout(set = 0, binding = 3) readonly buffer Tiles { uint tiles[]; };
layout(set = 0, binding = 4) readonly buffer GateScales { float gate_scales[]; };
layout(set = 0, binding = 5) readonly buffer UpScales { float up_scales[]; };
layout(set = 0, binding = 6) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 7) readonly buffer Tables { uint tables[]; };

layout(push_constant) uniform Push {
    uint mid_dim;
    uint blocks;
    uint n_used;
    uint has_gate_scales;
    uint has_up_scales;
    uint pad;
} pc;

/* One IQ2_XXS superblock is 33 uint16 words: [d_f16][32 x qs words]. */
const uint IQ2_U16 = 33u;
const uint SLOT_TILE = 32u;
const uint TILE_WORDS = 1u + SLOT_TILE;
const uint INVALID = 0xffffffffu;
const uint BM = 64u;
const uint KK = 8u;

#ifdef Q36_MOE_IQ2S
/* IQ2_S superblock: [d f16][64 qs][8 qh][8 scales] = 82 bytes.  Two 4-bit
 * scales per 32-element group (low nibble = first 16, high = last 16), so
 * the group scale folds into f32 per half instead of once per group. */
const uint IQ2S_BYTES = 82u;
const uint TAB_IQ2S = 544u;

uint g_u8(uint off) {
    return (uint(gw[off >> 1u]) >> (8u * (off & 1u))) & 255u;
}

uint u_u8(uint off) {
    return (uint(uw[off >> 1u]) >> (8u * (off & 1u))) & 255u;
}
#endif

shared uint sh_grid[512];
/* [m][kk] f16vec4 lanes, k XOR-swizzled by the row/slot index.  The pad slot
 * this layout used to carry never survived the toolchain (RADV reports LDS at
 * the unpadded size), leaving sixteen 64-bit lane reads on a 64-byte stride --
 * two banks, an 8-way conflict.  The swizzle spreads them over all 32 banks at
 * no LDS cost and only permutes storage, so results are bit-identical: with the
 * register tile below, 1635 -> 1018 ms across a ctx-2048 run (MEASURED_ON_BC250). */
#define Q36_SWZ(i) (((i) >> 1u) & 7u)   /* mask is KK - 1 */
shared f16vec4 Ag[BM][KK];
shared f16vec4 Au[BM][KK];
shared f16vec4 Bs[SLOT_TILE][KK];
shared float Dg[BM];
shared float Du[BM];
#ifdef Q36_MOE_IQ2S
shared float Dg2[BM];   /* high-nibble scale of the 32-element group */
shared float Du2[BM];
#endif
shared uint sh_slot[SLOT_TILE];
shared uint sh_x4[SLOT_TILE];

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * BM;
    uint tile_base = gl_WorkGroupID.y * TILE_WORDS;
    uint expert = tiles[tile_base];
    if (expert == INVALID) return;

    if (tid < SLOT_TILE) {
        uint slot = tiles[tile_base + 1u + tid];
        sh_slot[tid] = slot;
        sh_x4[tid] = (slot != INVALID ? slot / pc.n_used : 0u) * pc.blocks * 64u;
    }
#ifndef Q36_MOE_IQ2S
    for (uint w = tid; w < 512u; w += 256u) sh_grid[w] = tables[w];
#endif

#ifdef Q36_MOE_IQ2S
    uint row_bytes = pc.blocks * IQ2S_BYTES;
#else
    uint row_u16 = pc.blocks * IQ2_U16;
#endif
    uint ar = tid >> 2u;      /* staged row 0..63 */
    uint sub = tid & 3u;      /* 8-element group within the 32-block */
    uint row = row0 + ar;
#ifdef Q36_MOE_IQ2S
    uint base_bytes = (expert * pc.mid_dim + (row < pc.mid_dim ? row : 0u)) * row_bytes;
#else
    uint base_u16 = (expert * pc.mid_dim + (row < pc.mid_dim ? row : 0u)) * row_u16;
#endif
    uint bc = tid >> 3u;      /* staged slot 0..31 */
    uint bkk = tid & 7u;
    uint sl = tid & 15u;      /* output slot lane: slots sl + 16*j */
    uint ry = tid >> 4u;      /* output row lane: rows ry + 16*i */

    /* 4-row x 2-slot register tile per thread instead of 8x1: the same 16
     * accumulators and the same per-output k order, but each Ag/Au lane
     * read now feeds two slots, cutting inner-loop LDS reads per FMA pair
     * from 17:32 to 10:32.  Worth -7% on its own and -22% once the LDS reads
     * above are conflict-free; a 2-row x 4-slot tile measured slightly worse
     * than this one with the swizzle in place (MEASURED_ON_BC250). */
    float accg[4][2];
    float accu[4][2];
    for (uint i = 0u; i < 4u; i++) {
        for (uint j = 0u; j < 2u; j++) {
            accg[i][j] = 0.0;
            accu[i][j] = 0.0;
        }
    }
    barrier();

    uint sa = Q36_SWZ(ar);
    uint a_k0 = (sub * 2u) ^ sa;
    uint a_k1 = (sub * 2u + 1u) ^ sa;
    uint sbit = 7u * sub;
    uint sub_word = sub >> 1u;
    uint sub_shift = 8u * (sub & 1u);

    bool live_b = (bc < SLOT_TILE) && (sh_slot[bc] != INVALID);
    uint b_k = (bc < SLOT_TILE) ? (bkk ^ Q36_SWZ(bc)) : 0u;
    uint b_base = (bc < SLOT_TILE && live_b) ? (sh_x4[bc] + bkk) : 0u;

    uint swz_sl = Q36_SWZ(sl);
    uint swz_ry = Q36_SWZ(ry);
    uint arow[4];
    for (uint i = 0u; i < 4u; i++) arow[i] = ry + 16u * i;

    uint n_kb = pc.blocks * 8u;
    for (uint kb = 0u; kb < n_kb; kb++) {
        uint sb = kb >> 3u;
        uint ib32 = kb & 7u;
        /* Stage gate and up: 64 rows x one 32-element scale group, one
         * 8-element grid word per thread. */
#ifdef Q36_MOE_IQ2S
        {
            uint bb = base_bytes + sb * IQ2S_BYTES;
            uint gnib = sub < 2u ? (g_u8(bb + 74u + ib32) & 15u) : (g_u8(bb + 74u + ib32) >> 4u);
            uint unib = sub < 2u ? (u_u8(bb + 74u + ib32) & 15u) : (u_u8(bb + 74u + ib32) >> 4u);
            uint gsh = (8u - 2u * sub) & 31u;
            uint gentry = g_u8(bb + 2u + 4u * ib32 + sub) |
                          ((g_u8(bb + 66u + ib32) << gsh) & 0x300u);
            uint uentry = u_u8(bb + 2u + 4u * ib32 + sub) |
                          ((u_u8(bb + 66u + ib32) << gsh) & 0x300u);
            uint gsign = g_u8(bb + 34u + 4u * ib32 + sub);
            uint usign = u_u8(bb + 34u + 4u * ib32 + sub);

            vec4 g0 = vec4(unpack8(tables[TAB_IQ2S + gentry * 2u]));
            vec4 g1 = vec4(unpack8(tables[TAB_IQ2S + gentry * 2u + 1u]));
            g0 = mix(g0, -g0, bvec4((gsign & 1u) != 0u, (gsign & 2u) != 0u, (gsign & 4u) != 0u, (gsign & 8u) != 0u));
            g1 = mix(g1, -g1, bvec4((gsign & 16u) != 0u, (gsign & 32u) != 0u, (gsign & 64u) != 0u, (gsign & 128u) != 0u));
            Ag[ar][a_k0] = f16vec4(g0 * 0.015625);
            Ag[ar][a_k1] = f16vec4(g1 * 0.015625);

            vec4 u0 = vec4(unpack8(tables[TAB_IQ2S + uentry * 2u]));
            vec4 u1 = vec4(unpack8(tables[TAB_IQ2S + uentry * 2u + 1u]));
            u0 = mix(u0, -u0, bvec4((usign & 1u) != 0u, (usign & 2u) != 0u, (usign & 4u) != 0u, (usign & 8u) != 0u));
            u1 = mix(u1, -u1, bvec4((usign & 16u) != 0u, (usign & 32u) != 0u, (usign & 64u) != 0u, (usign & 128u) != 0u));
            Au[ar][a_k0] = f16vec4(u0 * 0.015625);
            Au[ar][a_k1] = f16vec4(u1 * 0.015625);

            if ((sub & 1u) == 0u) {
                float gd = unpackHalf2x16(uint(gw[bb >> 1u])).x;
                float ud = unpackHalf2x16(uint(uw[bb >> 1u])).x;
                if (sub == 0u) {
                    Dg[ar] = gd * 16.0 * (0.5 + float(gnib));
                    Du[ar] = ud * 16.0 * (0.5 + float(unib));
                } else {
                    Dg2[ar] = gd * 16.0 * (0.5 + float(gnib));
                    Du2[ar] = ud * 16.0 * (0.5 + float(unib));
                }
            }
        }
#else
        {
            uint gb = base_u16 + sb * IQ2_U16;
            uint gq = gb + 1u + (ib32 << 2u);
            uint gss = uint(gw[gq + 2u]) | (uint(gw[gq + 3u]) << 16u);
            uint uss = uint(uw[gq + 2u]) | (uint(uw[gq + 3u]) << 16u);
            uint gqs = (uint(gw[gq + sub_word]) >> sub_shift) & 255u;
            uint uqs = (uint(uw[gq + sub_word]) >> sub_shift) & 255u;

            uint gsign = bitfieldExtract(gss, int(sbit), 7);
            vec4 g0 = vec4(unpack8(sh_grid[gqs * 2u]));
            vec4 g1 = vec4(unpack8(sh_grid[gqs * 2u + 1u]));
            g0 = mix(g0, -g0, bvec4((gsign & 1u) != 0u, (gsign & 2u) != 0u, (gsign & 4u) != 0u, (gsign & 8u) != 0u));
            g1 = mix(g1, -g1, bvec4((gsign & 16u) != 0u, (gsign & 32u) != 0u, (gsign & 64u) != 0u, (bitCount(gsign) & 1) != 0));
            Ag[ar][a_k0] = f16vec4(g0 * 0.015625);
            Ag[ar][a_k1] = f16vec4(g1 * 0.015625);

            uint usign = bitfieldExtract(uss, int(sbit), 7);
            vec4 u0 = vec4(unpack8(sh_grid[uqs * 2u]));
            vec4 u1 = vec4(unpack8(sh_grid[uqs * 2u + 1u]));
            u0 = mix(u0, -u0, bvec4((usign & 1u) != 0u, (usign & 2u) != 0u, (usign & 4u) != 0u, (usign & 8u) != 0u));
            u1 = mix(u1, -u1, bvec4((usign & 16u) != 0u, (usign & 32u) != 0u, (usign & 64u) != 0u, (bitCount(usign) & 1) != 0));
            Au[ar][a_k0] = f16vec4(u0 * 0.015625);
            Au[ar][a_k1] = f16vec4(u1 * 0.015625);

            if (sub == 0u) {
                float gd = unpackHalf2x16(uint(gw[gb])).x;
                float ud = unpackHalf2x16(uint(uw[gb])).x;
                Dg[ar] = gd * 0.25 * (0.5 + float(gss >> 28u)) * 64.0;
                Du[ar] = ud * 0.25 * (0.5 + float(uss >> 28u)) * 64.0;
            }
        }
#endif
        /* Stage B: 32 slots x 32 elements, rounded once to f16. */
        if (bc < SLOT_TILE) {
            Bs[bc][b_k] = live_b ? f16vec4(xv[b_base + kb * 8u]) : f16vec4(0.0hf);
        }
        barrier();

        f16vec2 pkg[4][2];
        f16vec2 pku[4][2];
#ifdef Q36_MOE_IQ2S
        /* Two 4-bit scales per 32-element group: the xor swizzle only permutes
         * the low three bits, so the four slots carrying the low nibble are
         * exactly the four kk in the half selected by bit 2 of swz_ry.  Fold
         * each half separately in f32 with its own scale. */
        uint kk_lo = (swz_ry < 4u) ? 0u : 4u;
        [[unroll]]
        for (uint h = 0u; h < 2u; h++) {
            for (uint i = 0u; i < 4u; i++) {
                for (uint j = 0u; j < 2u; j++) {
                    pkg[i][j] = f16vec2(0.0hf);
                    pku[i][j] = f16vec2(0.0hf);
                }
            }
            [[unroll]]
            for (uint e = 0u; e < 4u; e++) {
                uint kk = (kk_lo ^ (h * 4u)) + e;
                uint kkb = kk ^ swz_sl;
                f16vec4 b0 = Bs[sl      ][kkb];
                f16vec4 b1 = Bs[sl + 16u][kkb];
                uint kka = kk ^ swz_ry;
                for (uint i = 0u; i < 4u; i++) {
                    f16vec4 ag = Ag[arow[i]][kka];
                    f16vec4 au = Au[arow[i]][kka];
                    pkg[i][0] = fma(ag.zw, b0.zw, fma(ag.xy, b0.xy, pkg[i][0]));
                    pkg[i][1] = fma(ag.zw, b1.zw, fma(ag.xy, b1.xy, pkg[i][1]));
                    pku[i][0] = fma(au.zw, b0.zw, fma(au.xy, b0.xy, pku[i][0]));
                    pku[i][1] = fma(au.zw, b1.zw, fma(au.xy, b1.xy, pku[i][1]));
                }
            }
            for (uint i = 0u; i < 4u; i++) {
                /* The stored slots holding the low nibble are the ones with
                 * slot bit 2 equal to bit 2 of swz_ry, so which kk half that
                 * is flips with swz_ry. */
                float dg = (h == (swz_ry >> 2u)) ? Dg[arow[i]] : Dg2[arow[i]];
                float du = (h == (swz_ry >> 2u)) ? Du[arow[i]] : Du2[arow[i]];
                for (uint j = 0u; j < 2u; j++) {
                    accg[i][j] = fma(dg, float(pkg[i][j].x) + float(pkg[i][j].y), accg[i][j]);
                    accu[i][j] = fma(du, float(pku[i][j].x) + float(pku[i][j].y), accu[i][j]);
                }
            }
        }
#else
        for (uint i = 0u; i < 4u; i++) {
            for (uint j = 0u; j < 2u; j++) {
                pkg[i][j] = f16vec2(0.0hf);
                pku[i][j] = f16vec2(0.0hf);
            }
        }
        [[unroll]]
        for (uint kk = 0u; kk < KK; kk++) {
            uint kkb = kk ^ swz_sl;
            f16vec4 b0 = Bs[sl      ][kkb];
            f16vec4 b1 = Bs[sl + 16u][kkb];
            uint kka = kk ^ swz_ry;
            for (uint i = 0u; i < 4u; i++) {
                f16vec4 ag = Ag[arow[i]][kka];
                f16vec4 au = Au[arow[i]][kka];
                pkg[i][0] = fma(ag.zw, b0.zw, fma(ag.xy, b0.xy, pkg[i][0]));
                pkg[i][1] = fma(ag.zw, b1.zw, fma(ag.xy, b1.xy, pkg[i][1]));
                pku[i][0] = fma(au.zw, b0.zw, fma(au.xy, b0.xy, pku[i][0]));
                pku[i][1] = fma(au.zw, b1.zw, fma(au.xy, b1.xy, pku[i][1]));
            }
        }
        for (uint i = 0u; i < 4u; i++) {
            float dg = Dg[arow[i]];
            float du = Du[arow[i]];
            for (uint j = 0u; j < 2u; j++) {
                accg[i][j] = fma(dg, float(pkg[i][j].x) + float(pkg[i][j].y), accg[i][j]);
                accu[i][j] = fma(du, float(pku[i][j].x) + float(pku[i][j].y), accu[i][j]);
            }
        }
#endif
        barrier();
    }

    float gsc = pc.has_gate_scales != 0u ? gate_scales[expert] : 1.0;
    float usc = pc.has_up_scales != 0u ? up_scales[expert] : 1.0;
    for (uint j = 0u; j < 2u; j++) {
        uint slot = sh_slot[sl + 16u * j];
        if (slot == INVALID) continue;
        for (uint i = 0u; i < 4u; i++) {
            uint r = row0 + ry + 16u * i;
            if (r >= pc.mid_dim) continue;
            float g = accg[i][j] * gsc;
            float v = accu[i][j] * usc;
            y[slot * pc.mid_dim + r] = (g / (1.0f + exp(-g))) * v;
        }
    }
}
