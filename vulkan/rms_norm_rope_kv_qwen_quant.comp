#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require

/* Fused RMS norm + Qwen RoPE + quantized KV store (Q8_0 K / Q4_0 V).
 * Same dataflow as rms_norm_rope_kv_qwen.comp but writes quantized blocks
 * instead of f16.  One workgroup (256 threads) per (head, token). */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer K { float k[]; };
layout(set = 0, binding = 1) readonly buffer Weight { float w[]; };
layout(set = 0, binding = 2) buffer KCache { uint kc[]; };
layout(set = 0, binding = 3) readonly buffer V { float v[]; };
layout(set = 0, binding = 4) buffer VCache { uint vc[]; };

layout(push_constant) uniform Push {
    uint src_stride; uint n_head; uint pos0; uint n_tok; uint cap;
    float eps; uint k_row_bytes; uint v_row_bytes;
} pc;

shared double sh_sum[256];
shared float sh_kv[256];
shared uint  sh_scale[8];
shared int   sh_q[256];

int nearest_int(float f) {
    precise float g = f + 12582912.0;  /* keep the fma contractor away */
    return int(floatBitsToUint(g) & 0x007fffffu) - 0x00400000;
}

/* f32 -> f16 round-to-nearest-even, bit-matching q36_quant_f32_to_f16().
 * packHalf2x16 rounds toward zero on AMD and cannot be used for scales. */
uint f16_rte(float f) {
    uint w = floatBitsToUint(f);
    uint shl1 = w + w;
    uint sign = w & 0x80000000u;
    uint bias = shl1 & 0xff000000u;
    if (bias < 0x71000000u) bias = 0x71000000u;
    precise float base = abs(f) * uintBitsToFloat(0x77800000u);  /* 0x1.0p+112 */
    base *= uintBitsToFloat(0x08800000u);                        /* 0x1.0p-110 */
    base += uintBitsToFloat((bias >> 1) + 0x07800000u);
    uint bits = floatBitsToUint(base);
    uint nonsign = ((bits >> 13) & 0x7c00u) + (bits & 0xfffu);
    return (sign >> 16) | (shl1 > 0xff000000u ? 0x7e00u : nonsign);
}

void main(void) {
    uint lid  = gl_LocalInvocationID.x;
    uint head = gl_WorkGroupID.x;
    uint tok  = gl_WorkGroupID.y;
    uint row  = tok * pc.n_head + head;
    uint pos  = pc.pos0 + tok;

    /* Phase 1: RMS norm + weight */
    float input_value = k[row * pc.src_stride + lid];
    sh_sum[lid] = double(input_value) * double(input_value);
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (lid < s) sh_sum[lid] += sh_sum[lid + s];
        barrier();
    }
    float nscale = inversesqrt(float(sh_sum[0] / 256.0) + pc.eps);
    sh_kv[lid] = input_value * nscale * w[lid];
    barrier();

    /* Phase 2: Qwen RoPE */
    if (lid < 32u) {
        float theta_scale = pow(10000000.0f, -2.0f / 64.0f);
        float theta[4] = { float(pos), float(pos), float(pos), 0.0f };
        for (uint i = 0u; i < lid; i++) {
            theta[0] *= theta_scale; theta[1] *= theta_scale; theta[2] *= theta_scale;
        }
        uint axis = (lid < 11u) ? 0u : (lid < 22u) ? 1u : 2u;
        float c = cos(theta[axis]);
        float s = sin(theta[axis]);
        float x0 = sh_kv[lid];
        float x1 = sh_kv[lid + 32u];
        sh_kv[lid] = x0 * c - x1 * s;
        sh_kv[lid + 32u] = x0 * s + x1 * c;
    }
    barrier();

    /* Phase 3: Quantize K to Q8_0 and write.
     * 8 blocks of 32, threads [b*32..b*32+31] handle block b. */
    {
        uint blk = lid >> 5u;
        uint lane = lid & 31u;
        float kval = sh_kv[lid];
        float amax = subgroupClusteredMax(abs(kval), 32u);
        /* fp64 divide: f32 division is 2.5 ulp on RADV, the host is exact */
        float d  = float(double(amax) / 127.0);
        /* fp64 divide: f32 rcp is 2.5 ulp on RADV, the host divide is exact */
        float id = d != 0.0 ? float(double(1.0) / double(d)) : 0.0;
        precise float pk = kval * id;
        sh_q[lid] = clamp(id != 0.0 ? nearest_int(pk) : 0, -128, 127);
        if (lane == 0u) sh_scale[blk] = f16_rte(d);
        barrier();
        /* Pack 272 bytes = 68 uints per head */
        uint head_bytes = (256u / 32u) * 34u;
        uint base_u = (pos * pc.k_row_bytes + head * head_bytes) / 4u;
        if (lid < 68u) {
            uint result = 0u;
            for (uint bi = 0u; bi < 4u; bi++) {
                uint bp = lid * 4u + bi;
                uint b = bp / 34u;
                uint off = bp - b * 34u;
                uint bv = (off < 2u)
                    ? (sh_scale[b] >> (off * 8u)) & 0xFFu
                    : uint(sh_q[b * 32u + off - 2u]) & 0xFFu;
                result |= bv << (bi * 8u);
            }
            kc[base_u + lid] = result;
        }
    }
    barrier();

    /* Phase 5: Quantize V to Q4_0 and write */
    {
        uint blk = lid >> 5u;
        uint lane = lid & 31u;
        float vval = v[row * 256u + lid];
        sh_kv[lid] = vval;
        float cur_v = vval;
        uint cur_idx = lane;
        for (uint s = 16u; s > 0u; s >>= 1u) {
            float other_v = subgroupShuffleDown(cur_v, s);
            uint other_idx = subgroupShuffleDown(cur_idx, s);
            bool take_other = abs(other_v) > abs(cur_v) || (abs(other_v) == abs(cur_v) && other_idx < cur_idx);
            if (lane < s && take_other) {
                cur_v = other_v;
                cur_idx = other_idx;
            }
        }
        float extreme = subgroupShuffle(cur_v, gl_SubgroupInvocationID & ~31u);
        float d  = extreme / (-8.0);
        float id = d != 0.0 ? float(double(1.0) / double(d)) : 0.0;
        precise float pv = vval * id + 8.5;
        sh_q[lid] = clamp(int(pv), 0, 15);
        barrier();
        /* Keep the compact cache layout, but reduce value reconstruction
         * error with a bounded least-squares scale correction. */
        int q = sh_q[lid] - 8;
        double my_num = double(sh_kv[lid]) * double(q);
        int my_den = q * q;
        double num = subgroupClusteredAdd(my_num, 32u);
        int den = subgroupClusteredAdd(my_den, 32u);
        float refined_d = d;
        if (den != 0) {
            float fit = float(num / double(den));
            refined_d = d + (fit - d) * 0.25;
        }
        d = refined_d;
        if (extreme == 0.0) d = uintBitsToFloat(0x80000000u);
        id = d != 0.0 ? float(double(1.0) / double(d)) : 0.0;
        precise float refined = vval * id + 8.5;
        sh_q[lid] = clamp(int(refined), 0, 15);
        if (lane == 0u) sh_scale[blk] = f16_rte(d);
        barrier();
        /* Pack 144 bytes = 36 uints per head */
        uint head_bytes = (256u / 32u) * 18u;
        uint base_u = (pos * pc.v_row_bytes + head * head_bytes) / 4u;
        if (lid < 36u) {
            uint result = 0u;
            for (uint bi = 0u; bi < 4u; bi++) {
                uint bp = lid * 4u + bi;
                uint b = bp / 18u;
                uint off = bp - b * 18u;
                uint bv;
                if (off < 2u) {
                    bv = (sh_scale[b] >> (off * 8u)) & 0xFFu;
                } else {
                    uint pi = off - 2u;
                    bv = (uint(sh_q[b * 32u + pi]) & 0xFu)
                       | ((uint(sh_q[b * 32u + pi + 16u]) & 0xFu) << 4u);
                }
                result |= bv << (bi * 8u);
            }
            vc[base_u + lid] = result;
        }
    }
}
