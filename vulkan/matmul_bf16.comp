#version 460

/* Dense bf16 matvec.  One workgroup cooperatively reduces each output row.
 * Loading packed bf16 pairs avoids fetching every weight word twice. */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights {
    uint w[];
};

layout(set = 0, binding = 1) readonly buffer Input {
    float x[];
};

layout(set = 0, binding = 2) writeonly buffer Output {
    float y[];
};

layout(push_constant) uniform Push {
    uint in_dim;
    uint out_dim;
    uint n_tok;
    float scale;
} pc;

shared float partial[256];

void main(void) {
    uint out_row = gl_WorkGroupID.x;
    uint tok = gl_WorkGroupID.y;
    if (out_row >= pc.out_dim || tok >= pc.n_tok) return;
    uint lane = gl_LocalInvocationID.x;
    uint wbase = out_row * pc.in_dim;
    uint xbase = tok * pc.in_dim;
    uint pair_count = (pc.in_dim + 1u) >> 1u;
    float acc = 0.0;
    for (uint pair = lane; pair < pair_count; pair += 256u) {
        uint i = pair << 1u;
        uint packed = w[(wbase + i) >> 1u];
        float w0 = uintBitsToFloat((packed & 0xffffu) << 16u);
        float w1 = uintBitsToFloat(packed & 0xffff0000u);
        acc = fma(w0, x[xbase + i], acc);
        if (i + 1u < pc.in_dim)
            acc = fma(w1, x[xbase + i + 1u], acc);
    }

    partial[lane] = acc;
    barrier();
    for (uint stride = 128u; stride != 0u; stride >>= 1u) {
        if (lane < stride) partial[lane] += partial[lane + stride];
        barrier();
    }
    if (lane == 0u)
        y[tok * pc.out_dim + out_row] = partial[0] * pc.scale;
}
