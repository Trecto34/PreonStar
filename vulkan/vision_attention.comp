#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QKV { float qkv[]; };
layout(set = 0, binding = 1) writeonly buffer Output { float outv[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint n_heads;
    uint head_dim;
    float scale;
} pc;

shared float dotv[128];

void main() {
    uint row = gl_WorkGroupID.x;
    uint head = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;
    uint d = lane;
    uint embd = pc.n_heads * pc.head_dim;
    uint stride = embd * 3u;
    uint qbase = row * stride + head * pc.head_dim;
    float acc = 0.0;
    float high = -3.402823466e38;
    float denom = 0.0;
    for (uint kr = 0; kr < pc.rows; kr++) {
        uint kbase = kr * stride + embd + head * pc.head_dim;
        dotv[lane] = d < pc.head_dim ? qkv[qbase + d] * qkv[kbase + d] : 0.0;
        barrier();
        for (uint stride_s = 64u; stride_s != 0u; stride_s >>= 1u) {
            if (lane < stride_s) dotv[lane] += dotv[lane + stride_s];
            barrier();
        }
        float score = dotv[0] * pc.scale;
        float next = max(high, score);
        float old_scale = kr == 0u ? 0.0 : exp(high - next);
        float new_scale = exp(score - next);
        denom = denom * old_scale + new_scale;
        if (d < pc.head_dim) {
            uint vbase = kr * stride + 2u * embd + head * pc.head_dim;
            acc = acc * old_scale + new_scale * qkv[vbase + d];
        }
        high = next;
        barrier();
    }
    if (d < pc.head_dim)
        outv[row * embd + head * pc.head_dim + d] = acc / denom;
}
