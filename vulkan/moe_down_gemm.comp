#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint16_t wb[]; };
layout(set = 0, binding = 1) readonly buffer Mid { vec4 mid[]; };
layout(set = 0, binding = 2) readonly buffer Tiles { uint tiles[]; };
layout(set = 0, binding = 3) readonly buffer Scales { float scales[]; };
layout(set = 0, binding = 4) writeonly buffer Output { float y[]; };
#if defined(P36_MOE_IQ2S) || defined(P36_MOE_IQ3S) || defined(P36_MOE_IQ3XXS)
layout(set = 0, binding = 5) readonly buffer Tables { uint tables[]; };
#endif

layout(push_constant) uniform Push {
    uint out_dim;
    uint in_dim;
    uint blocks;
    uint n_used;
    uint has_scales;
    uint pad;
} pc;

const uint Q2K_U16 = 42u;
#if defined(P36_MOE_IQ2S) || defined(P36_MOE_IQ3S) || defined(P36_MOE_IQ3XXS) || defined(P36_MOE_Q3K)
uint b_u8(uint off) {
    return (uint(wb[off >> 1u]) >> (8u * (off & 1u))) & 255u;
}
#endif
#ifdef P36_MOE_IQ3XXS
const uint IQ3XXS_BYTES = 98u;
const uint TAB_KSIGNS = 512u;
const uint TAB_IQ3XXS_GRID = 3104u;
#endif
#ifdef P36_MOE_Q3K
const uint Q3K_BYTES = 110u;
#endif
#ifdef P36_MOE_IQ2S
const uint IQ2S_BYTES = 82u;
const uint TAB_IQ2S = 544u;
#endif
#ifdef P36_MOE_IQ3S
const uint IQ3S_BYTES = 110u;
const uint TAB_IQ3S_GRID = 2592u;
#endif
#ifndef P36_SLOT_TILE
#define P36_SLOT_TILE 32u
#endif
#ifndef P36_DOWN_BM
#define P36_DOWN_BM 128u
#endif
const uint SLOT_TILE = P36_SLOT_TILE;
const uint TILE_WORDS = 1u + SLOT_TILE;
const uint INVALID = 0xffffffffu;
const uint BM = P36_DOWN_BM;
const uint RPL = BM / 16u;
const uint STAGE_ITERS = BM / 64u;
const uint KK = 8u;

#define P36_SWZ(i) (((i) >> 1u) & 7u)
shared f16vec4 As[BM][KK];
shared f16vec4 Bs[SLOT_TILE][KK];
shared uint sh_slot[SLOT_TILE];

void stage_a(uint ar, uint base_addr, uint sb, uint kb, uint sub, uint a_k0, uint a_k1) {
#ifdef P36_MOE_IQ3XXS
    uint bb = base_addr + sb * IQ3XXS_BYTES;
    uint g32 = kb & 7u;
    uint w_aux = (bb + 66u + 4u * g32) >> 1u;
    uint aux = uint(wb[w_aux]) | (uint(wb[w_aux + 1u]) << 16u);
    uint si = (aux >> (7u * sub)) & 127u;
    uint signs = (tables[TAB_KSIGNS + (si >> 2u)] >> (8u * (si & 3u))) & 255u;
    uint e01 = uint(wb[(bb + 2u + 8u * g32 + 2u * sub) >> 1u]);
    uint e0 = e01 & 255u;
    uint e1 = e01 >> 8u;
    vec4 g0 = vec4(unpack8(tables[TAB_IQ3XXS_GRID + e0]));
    vec4 g1 = vec4(unpack8(tables[TAB_IQ3XXS_GRID + e1]));
    g0 = mix(g0, -g0, bvec4((signs & 1u) != 0u, (signs & 2u) != 0u,
                            (signs & 4u) != 0u, (signs & 8u) != 0u));
    g1 = mix(g1, -g1, bvec4((signs & 16u) != 0u, (signs & 32u) != 0u,
                            (signs & 64u) != 0u, (signs & 128u) != 0u));
    float dscale = unpackHalf2x16(uint(wb[bb >> 1u])).x *
                   0.25 * float(2u * (aux >> 28u) + 1u);
    As[ar][a_k0] = f16vec4(g0 * dscale);
    As[ar][a_k1] = f16vec4(g1 * dscale);
#elif defined(P36_MOE_Q3K)
    uint bb = base_addr + sb * Q3K_BYTES;
    uint g32 = kb & 7u;
    uint group = 2u * g32 + (sub >> 1u);
    uint slo = b_u8(bb + 96u + (group & 7u));
    uint shi = b_u8(bb + 104u + (group & 3u));
    int sc = int(((group < 8u ? slo : (slo >> 4u)) & 15u) |
                 (((shi >> (2u * (group >> 2u))) & 3u) << 4u)) - 32;
    float dscale = unpackHalf2x16(uint(wb[(bb + 108u) >> 1u])).x * float(sc);
    uint qsh = 2u * (g32 & 3u);
    uint hbit = 4u * (g32 >> 2u) + (g32 & 3u);
    uint qo = (bb + 32u + 32u * (g32 >> 2u) + 8u * sub) >> 1u;
    uint ho = (bb + 8u * sub) >> 1u;
    uint q0w = uint(wb[qo + 0u]) | (uint(wb[qo + 1u]) << 16u);
    uint q1w = uint(wb[qo + 2u]) | (uint(wb[qo + 3u]) << 16u);
    uint h0w = uint(wb[ho + 0u]) | (uint(wb[ho + 1u]) << 16u);
    uint h1w = uint(wb[ho + 2u]) | (uint(wb[ho + 3u]) << 16u);
    vec4 q0;
    vec4 q1;
    [[unroll]] for (uint z = 0u; z < 4u; z++) {
        q0[z] = float(int((q0w >> (8u * z + qsh)) & 3u) - (((h0w >> (8u * z + hbit)) & 1u) != 0u ? 0 : 4));
        q1[z] = float(int((q1w >> (8u * z + qsh)) & 3u) - (((h1w >> (8u * z + hbit)) & 1u) != 0u ? 0 : 4));
    }
    As[ar][a_k0] = f16vec4(q0 * dscale);
    As[ar][a_k1] = f16vec4(q1 * dscale);
#elif defined(P36_MOE_IQ2S)
    uint bb = base_addr + sb * IQ2S_BYTES;
    uint sc = b_u8(bb + 74u + (kb & 7u));
    uint nib = sub < 2u ? (sc & 15u) : (sc >> 4u);
    float dscale = unpackHalf2x16(uint(wb[bb >> 1u])).x * 0.25 * (0.5 + float(nib));
    uint entry = b_u8(bb + 2u + 4u * (kb & 7u) + sub) |
                 ((b_u8(bb + 66u + (kb & 7u)) << (8u - 2u * sub)) & 0x300u);
    uint signs = b_u8(bb + 34u + 4u * (kb & 7u) + sub);
    vec4 g0 = vec4(unpack8(tables[TAB_IQ2S + entry * 2u]));
    vec4 g1 = vec4(unpack8(tables[TAB_IQ2S + entry * 2u + 1u]));
    g0 = mix(g0, -g0, bvec4((signs & 1u) != 0u, (signs & 2u) != 0u, (signs & 4u) != 0u, (signs & 8u) != 0u));
    g1 = mix(g1, -g1, bvec4((signs & 16u) != 0u, (signs & 32u) != 0u, (signs & 64u) != 0u, (signs & 128u) != 0u));
    As[ar][a_k0] = f16vec4(g0 * dscale);
    As[ar][a_k1] = f16vec4(g1 * dscale);
#elif defined(P36_MOE_IQ3S)
    uint bb = base_addr + sb * IQ3S_BYTES;
    uint g32 = kb & 7u;
    uint qh = b_u8(bb + 66u + g32);
    uint qlo = b_u8(bb + 2u + 8u * g32 + 2u * sub);
    uint qhi = b_u8(bb + 3u + 8u * g32 + 2u * sub);
    uint e0 = qlo | (((qh >> (2u * sub)) & 1u) << 8u);
    uint e1 = qhi | (((qh >> (2u * sub + 1u)) & 1u) << 8u);
    vec4 g0 = vec4(unpack8(tables[TAB_IQ3S_GRID + e0]));
    vec4 g1 = vec4(unpack8(tables[TAB_IQ3S_GRID + e1]));
    uint signs = b_u8(bb + 74u + 4u * g32 + sub);
    uint scb = b_u8(bb + 106u + (g32 >> 1u));
    uint nib = (g32 & 1u) != 0u ? (scb >> 4u) : (scb & 15u);
    float dscale = unpackHalf2x16(uint(wb[bb >> 1u])).x * float(2u * nib + 1u);
    g0 = mix(g0, -g0, bvec4((signs & 1u) != 0u, (signs & 2u) != 0u, (signs & 4u) != 0u, (signs & 8u) != 0u));
    g1 = mix(g1, -g1, bvec4((signs & 16u) != 0u, (signs & 32u) != 0u, (signs & 64u) != 0u, (signs & 128u) != 0u));
    As[ar][a_k0] = f16vec4(g0 * dscale);
    As[ar][a_k1] = f16vec4(g1 * dscale);
#else
    uint half_ = (kb >> 2u) & 1u;
    uint j = kb & 3u;
    uint bb = base_addr + sb * Q2K_U16;
    vec2 dm = unpackHalf2x16(uint(wb[bb + 40u]) | (uint(wb[bb + 41u]) << 16u));
    uint g = 8u * half_ + 2u * j + (sub >> 1u);
    uint scw = (uint(wb[bb + (g >> 1u)]) >> (8u * (g & 1u))) & 255u;
    float sc1 = dm.x * float(scw & 0xFu);
    float sc2 = dm.y * float((scw >> 4u) & 0xFu);
    uint q0w = bb + 8u + 16u * half_ + sub * 4u;
    uint p0 = uint(wb[q0w + 0u]) | (uint(wb[q0w + 1u]) << 16u);
    uint p1 = uint(wb[q0w + 2u]) | (uint(wb[q0w + 3u]) << 16u);
    vec4 q0 = vec4(unpack8((p0 >> (2u * j)) & 0x03030303u));
    vec4 q1 = vec4(unpack8((p1 >> (2u * j)) & 0x03030303u));
    As[ar][a_k0] = f16vec4(q0 * sc1 - sc2);
    As[ar][a_k1] = f16vec4(q1 * sc1 - sc2);
#endif
}

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * BM;
    uint tile_base = gl_WorkGroupID.y * TILE_WORDS;
    uint expert = tiles[tile_base];
    if (expert == INVALID) return;

    if (tid < SLOT_TILE) sh_slot[tid] = tiles[tile_base + 1u + tid];

#if defined(P36_MOE_IQ3XXS)
    uint row_stride = pc.blocks * IQ3XXS_BYTES;
#elif defined(P36_MOE_Q3K)
    uint row_stride = pc.blocks * Q3K_BYTES;
#elif defined(P36_MOE_IQ3S)
    uint row_stride = pc.blocks * IQ3S_BYTES;
#elif defined(P36_MOE_IQ2S)
    uint row_stride = pc.blocks * IQ2S_BYTES;
#else
    uint row_stride = pc.blocks * Q2K_U16;
#endif
    uint ar0 = tid >> 2u;
    uint sub = tid & 3u;
    uint base_addr[STAGE_ITERS];
    [[unroll]] for (uint s = 0u; s < STAGE_ITERS; s++) {
        uint row = row0 + ar0 + 64u * s;
        base_addr[s] = (expert * pc.out_dim + (row < pc.out_dim ? row : 0u)) * row_stride;
    }
    uint bc = tid >> 3u;
    uint bkk = tid & 7u;
    uint sl = tid & 15u;
    uint ry = tid >> 4u;
    uint mid4 = pc.in_dim / 4u;

    float acc[RPL][2];
    [[unroll]] for (uint i = 0u; i < RPL; i++)
        for (uint j = 0u; j < 2u; j++) acc[i][j] = 0.0;
    barrier();

    uint sa = P36_SWZ(ar0);
    uint a_k0 = (sub * 2u) ^ sa;
    uint a_k1 = (sub * 2u + 1u) ^ sa;

    bool hi_live = false;
    for (uint j = 16u; j < SLOT_TILE; j++) hi_live = hi_live || sh_slot[j] != INVALID;
    bool slot_valid = (bc < SLOT_TILE) && (sh_slot[bc] != INVALID);
    uint b_k = (bc < SLOT_TILE) ? (bkk ^ P36_SWZ(bc)) : 0u;
    uint b_base = slot_valid ? (sh_slot[bc] * mid4 + bkk) : 0u;

    uint swz_sl = P36_SWZ(sl);
    uint swz_ry = P36_SWZ(ry);
    uint arow[RPL];
    [[unroll]] for (uint i = 0u; i < RPL; i++) arow[i] = ry + 16u * i;

    uint n_kb = pc.blocks * 8u;
    for (uint kb = 0u; kb < n_kb; kb++) {
        uint sb = kb >> 3u;
        [[unroll]] for (uint s = 0u; s < STAGE_ITERS; s++) {
            stage_a(ar0 + 64u * s, base_addr[s], sb, kb, sub, a_k0, a_k1);
        }
        if (bc < SLOT_TILE) {
            Bs[bc][b_k] = slot_valid ? f16vec4(mid[b_base + kb * 8u]) : f16vec4(0.0hf);
        }
        barrier();

        f16vec2 pk[RPL][2];
        [[unroll]] for (uint i = 0u; i < RPL; i++)
            for (uint j = 0u; j < 2u; j++) pk[i][j] = f16vec2(0.0hf);
        if (hi_live) {
            [[unroll]] for (uint kk = 0u; kk < KK; kk++) {
                uint kkb = kk ^ swz_sl;
                f16vec4 b0 = Bs[sl      ][kkb];
                f16vec4 b1 = Bs[sl + 16u][kkb];
                uint kka = kk ^ swz_ry;
                [[unroll]] for (uint i = 0u; i < RPL; i++) {
                    f16vec4 a = As[arow[i]][kka];
                    pk[i][0] = fma(a.zw, b0.zw, fma(a.xy, b0.xy, pk[i][0]));
                    pk[i][1] = fma(a.zw, b1.zw, fma(a.xy, b1.xy, pk[i][1]));
                }
            }
        } else {
            [[unroll]] for (uint kk = 0u; kk < KK; kk++) {
                uint kkb = kk ^ swz_sl;
                f16vec4 b0 = Bs[sl      ][kkb];
                uint kka = kk ^ swz_ry;
                [[unroll]] for (uint i = 0u; i < RPL; i++) {
                    f16vec4 a = As[arow[i]][kka];
                    pk[i][0] = fma(a.zw, b0.zw, fma(a.xy, b0.xy, pk[i][0]));
                }
            }
        }
        [[unroll]] for (uint i = 0u; i < RPL; i++)
            for (uint j = 0u; j < 2u; j++)
                acc[i][j] += float(pk[i][j].x) + float(pk[i][j].y);
        barrier();
    }

    float sc = pc.has_scales != 0u ? scales[expert] : 1.0;
    for (uint j = 0u; j < 2u; j++) {
        if (sl + 16u * j >= SLOT_TILE) continue;
        uint slot = sh_slot[sl + 16u * j];
        if (slot == INVALID) continue;
        [[unroll]] for (uint i = 0u; i < RPL; i++) {
            uint r = row0 + ry + 16u * i;
            if (r < pc.out_dim) y[slot * pc.out_dim + r] = acc[i][j] * sc;
        }
    }
}
