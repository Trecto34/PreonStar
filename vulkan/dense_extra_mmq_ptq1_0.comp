#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint TOK_TILE = 8u;

/* local_size_x=64 spans 2 subgroups at wave32 (forced on this shader,
 * see q36_vulkan.c force_wave32) but 1 at wave64 -- size for the worst
 * case (min subgroup size on this device is 32).
 * Each token in the tile gets one slot per subgroup. */
shared int sh_sum[TOK_TILE][2];

layout(set = 0, binding = 0) readonly buffer Weights { uint8_t wb[]; };
layout(set = 0, binding = 1) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 3) readonly buffer Tables { uint tables[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint n_tok;
    uint blocks;
    uint row_bytes;
    uint type;
    float scale;
} pc;

const uint ROWS = 4u;
const uint Q8K_WORDS = 74u;
const uint QK_PTQ1_0 = 128u;
const uint PTQ1_0_BYTES = 28u;
const uint PTQ1_0_BLKS_PER_Q8K = 2u;

uint load_u8(uint off) {
    return uint(wb[off]);
}

uint load_u16(uint off) {
    return uint(wb[off]) | (uint(wb[off + 1u]) << 8u);
}

float f16_to_f32(uint h) {
    return unpackHalf2x16(h & 0xffffu).x;
}

/* int8 q8 activation for token `tok`, q8_K block `b`, element `j`. */
int q8_at(uint tok, uint b, uint j) {
    uint w = q8[(tok * pc.blocks + b) * Q8K_WORDS + 2u + (j >> 2u)];
    int v = int((w >> (8u * (j & 3u))) & 0xffu);
    return (v & 0x80) != 0 ? v - 256 : v;
}

const uint pow3[5] = {1u, 3u, 9u, 27u, 81u};

/* Ternary weight value in {-1,0,1} at position p of a PTQ1_0 block. */
int weight_at(uint base, uint p) {
    uint byte; uint n;
    if (p < 80u) {
        byte = load_u8(base + p % 16u);
        n = p / 16u;
    } else if (p < 120u) {
        uint l = p - 80u;
        byte = load_u8(base + 16u + l % 8u);
        n = l / 8u;
    } else {
        uint l = p - 120u;
        byte = load_u8(base + 24u + l % 2u);
        n = l / 2u;
    }
    uint qq = (byte * pow3[n]) & 0xffu;
    return int((qq * 3u) >> 8u) - 1;
}

void main(void) {
    uint lid = gl_LocalInvocationID.x;
    uint first_row = gl_WorkGroupID.x * ROWS;
    uint tok0 = gl_WorkGroupID.y * TOK_TILE;

    if (tok0 >= pc.n_tok) return;

    float acc[ROWS];
    [[unroll]] for (uint r = 0u; r < ROWS; r++) acc[r] = 0.0f;

    for (uint b = 0u; b < pc.blocks; b++) {
        float yd = 0.0f;
        if (lid < TOK_TILE) {
            uint my_tok = tok0 + lid;
            if (my_tok < pc.n_tok) {
                yd = uintBitsToFloat(q8[(my_tok * pc.blocks + b) * Q8K_WORDS]);
            }
        }

        [[unroll]] for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
            if (row >= pc.out_dim) continue;

            for (uint pb = 0u; pb < PTQ1_0_BLKS_PER_Q8K; pb++) {
                uint qblock = PTQ1_0_BLKS_PER_Q8K * b + pb;
                uint base = row * pc.row_bytes + qblock * PTQ1_0_BYTES;
                float wd = f16_to_f32(load_u16(base + 26u));

                // Decode 2 weights per thread once per (row, pb) and reuse across token tile
                int w0 = weight_at(base, lid);
                int w1 = weight_at(base, lid + 64u);
                uint a0 = pb * 128u + lid;
                uint a1 = pb * 128u + (lid + 64u);

                for (uint t = 0u; t < TOK_TILE; t++) {
                    uint tok = tok0 + t;
                    if (tok >= pc.n_tok) break;

                    int s = w0 * q8_at(tok, b, a0) + w1 * q8_at(tok, b, a1);
                    int local = subgroupAdd(s);
                    if (subgroupElect()) sh_sum[t][gl_SubgroupID] = local;
                }
                barrier();

                if (lid < TOK_TILE) {
                    uint my_tok = tok0 + lid;
                    if (my_tok < pc.n_tok) {
                        int total = 0;
                        for (uint sg = 0u; sg < gl_NumSubgroups; sg++) total += sh_sum[lid][sg];
                        acc[r] = fma(wd * yd, float(total), acc[r]);
                    }
                }
                barrier();
            }
        }
    }

    if (lid < TOK_TILE) {
        uint my_tok = tok0 + lid;
        if (my_tok < pc.n_tok) {
            [[unroll]] for (uint r = 0u; r < ROWS; r++) {
                uint row = first_row + r;
                if (row < pc.out_dim) {
                    y[my_tok * pc.out_dim + row] = acc[r] * pc.scale;
                }
            }
        }
    }
}