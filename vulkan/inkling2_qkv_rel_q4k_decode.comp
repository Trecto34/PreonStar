#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : require

/* Fused Q4_K decode for Inkling-2-Mini attention projections: Q + K + V + rel in ONE dispatch!
 * 64 threads = 4 sub-groups x 16 lanes/sub-group, 2 rows/sub-group -> 8 output rows/WG!
 * Reuses unpacked Q8_K activations (yd, qsum, av[0..3]) across 2 rows -> halves Q8_K loads & ALU.
 * Eliminates 144 dispatches/tok (48 logical layers x 3 saved dispatches) and tail-wave waste.
 * Dispatch: ((out_q + out_k + out_v + out_r) / 8, 1, 1) = (688, 1, 1). */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Wq { uint wq[]; };
layout(set = 0, binding = 1) readonly buffer Wk { uint wk[]; };
layout(set = 0, binding = 2) readonly buffer Wv { uint wv[]; };
layout(set = 0, binding = 3) readonly buffer Wr { uint wr[]; };
layout(set = 0, binding = 4) readonly buffer Q8_0 { uint q8_0[]; };
layout(set = 0, binding = 5) readonly buffer Q8_1 { uint q8_1[]; };
layout(set = 0, binding = 6) readonly buffer Q8_2 { uint q8_2[]; };
layout(set = 0, binding = 7) writeonly buffer Yq { float yq[]; };
layout(set = 0, binding = 8) writeonly buffer Yk { float yk[]; };
layout(set = 0, binding = 9) writeonly buffer Yv { float yv[]; };
layout(set = 0, binding = 10) writeonly buffer Yr { float yr[]; };

layout(push_constant) uniform Push {
    uint blocks;     /* 9 */
    uint row_words;  /* 9 * 36 = 324 */
    uint wg_q;       /* out_q / 8 = 384 */
    uint wg_qk;      /* (out_q + out_k) / 8 = 512 */
    uint wg_qkv;     /* (out_q + out_k + out_v) / 8 = 640 */
} pc;

const uint Q8K_WORDS = 74u;

float sum16(float v) {
    v += subgroupShuffleXor(v, 8u);
    v += subgroupShuffleXor(v, 4u);
    v += subgroupShuffleXor(v, 2u);
    v += subgroupShuffleXor(v, 1u);
    return v;
}

#define Q4K_ROW_PART(WBUF, WBASE, AV0, AV1, AV2, AV3, QSUM, PART_OUT) do { \
    vec2 d2 = unpackHalf2x16(WBUF[WBASE]); \
    uint s0 = WBUF[WBASE + 1u]; \
    uint s1 = WBUF[WBASE + 2u]; \
    uint sc; \
    uint mn; \
    if (group < 4u) { \
        uint sh = group * 8u; \
        sc = (s0 >> sh) & 63u; \
        mn = (s1 >> sh) & 63u; \
    } else { \
        uint sh = (group - 4u) * 8u; \
        uint s2 = WBUF[WBASE + 3u]; \
        sc = ((s2 >> sh) & 15u) | (((s0 >> (sh + 6u)) & 3u) << 4u); \
        mn = ((s2 >> (sh + 4u)) & 15u) | (((s1 >> (sh + 6u)) & 3u) << 4u); \
    } \
    uint qw = WBASE + qw_off; \
    uint ql0 = (WBUF[qw + 0u] >> nshift) & 0x0f0f0f0fu; \
    uint ql1 = (WBUF[qw + 1u] >> nshift) & 0x0f0f0f0fu; \
    uint ql2 = (WBUF[qw + 2u] >> nshift) & 0x0f0f0f0fu; \
    uint ql3 = (WBUF[qw + 3u] >> nshift) & 0x0f0f0f0fu; \
    float qdot = dot(vec4(float(ql0 & 15u), float((ql0 >> 8u) & 15u), float((ql0 >> 16u) & 15u), float((ql0 >> 24u) & 15u)), AV0) \
               + dot(vec4(float(ql1 & 15u), float((ql1 >> 8u) & 15u), float((ql1 >> 16u) & 15u), float((ql1 >> 24u) & 15u)), AV1) \
               + dot(vec4(float(ql2 & 15u), float((ql2 >> 8u) & 15u), float((ql2 >> 16u) & 15u), float((ql2 >> 24u) & 15u)), AV2) \
               + dot(vec4(float(ql3 & 15u), float((ql3 >> 8u) & 15u), float((ql3 >> 16u) & 15u), float((ql3 >> 24u) & 15u)), AV3); \
    PART_OUT = d2.x * float(sc) * qdot - d2.y * float(mn) * QSUM; \
} while (false)

#define RUN_Q4K2(WBUF, Q8BUF, YBUF, ROW0_EXPR) do { \
    uint row0 = (ROW0_EXPR); \
    uint row0_w0 = row0 * pc.row_words; \
    uint row1_w0 = row0_w0 + pc.row_words; \
    float acc0 = 0.0; \
    float acc1 = 0.0; \
    for (uint b = 0u; b < pc.blocks; b++) { \
        uint qbase = b * Q8K_WORDS; \
        float yd = uintBitsToFloat(Q8BUF[qbase]); \
        float qsum = float(bitfieldExtract(int(Q8BUF[qbase + bsum_off]), bsum_bit, 16)); \
        uint qv0 = Q8BUF[qbase + 2u + 4u * itid + 0u]; \
        uint qv1 = Q8BUF[qbase + 2u + 4u * itid + 1u]; \
        uint qv2 = Q8BUF[qbase + 2u + 4u * itid + 2u]; \
        uint qv3 = Q8BUF[qbase + 2u + 4u * itid + 3u]; \
        vec4 av0 = vec4(float(bitfieldExtract(int(qv0), 0, 8)), float(bitfieldExtract(int(qv0), 8, 8)), \
                        float(bitfieldExtract(int(qv0), 16, 8)), float(bitfieldExtract(int(qv0), 24, 8))); \
        vec4 av1 = vec4(float(bitfieldExtract(int(qv1), 0, 8)), float(bitfieldExtract(int(qv1), 8, 8)), \
                        float(bitfieldExtract(int(qv1), 16, 8)), float(bitfieldExtract(int(qv1), 24, 8))); \
        vec4 av2 = vec4(float(bitfieldExtract(int(qv2), 0, 8)), float(bitfieldExtract(int(qv2), 8, 8)), \
                        float(bitfieldExtract(int(qv2), 16, 8)), float(bitfieldExtract(int(qv2), 24, 8))); \
        vec4 av3 = vec4(float(bitfieldExtract(int(qv3), 0, 8)), float(bitfieldExtract(int(qv3), 8, 8)), \
                        float(bitfieldExtract(int(qv3), 16, 8)), float(bitfieldExtract(int(qv3), 24, 8))); \
        float p0, p1; \
        Q4K_ROW_PART(WBUF, row0_w0 + 36u * b, av0, av1, av2, av3, qsum, p0); \
        Q4K_ROW_PART(WBUF, row1_w0 + 36u * b, av0, av1, av2, av3, qsum, p1); \
        acc0 = fma(yd, p0, acc0); \
        acc1 = fma(yd, p1, acc1); \
    } \
    acc0 = sum16(acc0); \
    acc1 = sum16(acc1); \
    if (itid == 0u) { \
        YBUF[row0] = acc0; \
        YBUF[row0 + 1u] = acc1; \
    } \
} while (false)

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint r_local = tid >> 4u;
    uint itid = tid & 15u;
    uint group = itid >> 1u;
    uint nshift = (group & 1u) * 4u;
    uint qw_off = 4u + (group >> 1u) * 8u + (itid & 1u) * 4u;
    uint bsum_off = 66u + (itid >> 1u);
    int bsum_bit = int((itid & 1u) * 16u);
    uint wg = gl_WorkGroupID.x;

    if (wg < pc.wg_q) {
        RUN_Q4K2(wq, q8_0, yq, wg * 8u + 2u * r_local);
    } else if (wg < pc.wg_qk) {
        RUN_Q4K2(wk, q8_1, yk, (wg - pc.wg_q) * 8u + 2u * r_local);
    } else if (wg < pc.wg_qkv) {
        RUN_Q4K2(wv, q8_2, yv, (wg - pc.wg_qk) * 8u + 2u * r_local);
    } else {
        RUN_Q4K2(wr, q8_0, yr, (wg - pc.wg_qkv) * 8u + 2u * r_local);
    }
}
