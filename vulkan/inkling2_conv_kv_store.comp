#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : require

/* Fused K/V short-conv (l_cache=4, optional dynamic taps) + K L2-clip +
 * V RMSNorm + F16 KV cache store for Inkling-2-Mini.
 * Each workgroup (1 wave64) owns 1 KV head (128 dims = 2 dims/lane) x 8 tokens.
 * When n_tok >= 3, dispatches (n_head_kv = 8, ceil(n_tok / 8), 1) with state READ-ONLY;
 * host copies last 3 rows of k_in/v_in into k_state/v_state via vkCmdCopyBuffer.
 * When n_tok < 3, dispatches (n_head_kv = 8, 1, 1) and updates state in-place. */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer KBuf { float k_in[]; };
layout(set = 0, binding = 1) readonly buffer VBuf { float v_in[]; };
layout(set = 0, binding = 2) readonly buffer KWeight { vec4 kw[]; };
layout(set = 0, binding = 3) readonly buffer VWeight { vec4 vw[]; };
layout(set = 0, binding = 4) buffer KState { float ks[]; };
layout(set = 0, binding = 5) buffer VState { float vs[]; };
layout(set = 0, binding = 6) readonly buffer KDyn { vec4 kdyn[]; };
layout(set = 0, binding = 7) readonly buffer VDyn { vec4 vdyn[]; };
#ifdef KV_Q8
/* Int8 KV: per (slot, head) 34 words = 128 x int8 (dim d = byte d) + 4 x f16 scale (dims 32b..32b+31). */
layout(set = 0, binding = 8) writeonly buffer CacheK { uint cache_k[]; };
layout(set = 0, binding = 9) writeonly buffer CacheV { uint cache_v[]; };

/* lane tid holds dims tid (block tid>>5) and tid+64 (block 2+(tid>>5)); lanes 0..33 write the 34 words. */
void store_q8(float x0, float x1, uint tid, uint hb, bool is_k) {
    float d0 = float(float16_t(subgroupClusteredMax(abs(x0), 32u) / 127.0));
    float d1 = float(float16_t(subgroupClusteredMax(abs(x1), 32u) / 127.0));
    int q0 = (d0 > 0.0) ? clamp(int(round(x0 / d0)), -127, 127) : 0;
    int q1 = (d1 > 0.0) ? clamp(int(round(x1 / d1)), -127, 127) : 0;
    uint pk = uint(q0 & 255) | (uint(q1 & 255) << 8u);
    uint src = 4u * (tid & 15u);
    uint sh = (tid < 16u) ? 0u : 8u;
    uint w = 0u;
    [[unroll]] for (uint i = 0u; i < 4u; i++) w |= ((subgroupShuffle(pk, src + i) >> sh) & 255u) << (8u * i);
    float d0a = subgroupShuffle(d0, 0u), d0b = subgroupShuffle(d0, 32u);
    float d1a = subgroupShuffle(d1, 0u), d1b = subgroupShuffle(d1, 32u);
    if (tid < 34u) {
        uint o = (tid < 32u) ? w : packHalf2x16((tid == 32u) ? vec2(d0a, d0b) : vec2(d1a, d1b));
        if (is_k) cache_k[hb + tid] = o;
        else      cache_v[hb + tid] = o;
    }
}
#else
layout(set = 0, binding = 8) writeonly buffer CacheK { float16_t cache_k[]; };
layout(set = 0, binding = 9) writeonly buffer CacheV { float16_t cache_v[]; };
#endif

layout(push_constant) uniform Push {
    uint n_head_kv;
    uint n_tok;
    uint pos0;
    uint kv_cap;
    uint is_swa;
    uint has_dyn;
    float inv_scale;
    float qk_clip;
} pc;

void main(void) {
    uint h = gl_WorkGroupID.x;
    uint t0 = gl_WorkGroupID.y * 8u;
    uint t_end = min(t0 + 8u, pc.n_tok);
    if (t0 >= pc.n_tok) return;

    uint tid = gl_LocalInvocationID.x;
    uint C = pc.n_head_kv * 128u;
    uint c0 = h * 128u + tid;
    uint c1 = c0 + 64u;

    vec4 kw0 = kw[c0], kw1 = kw[c1];
    vec4 vw0 = vw[c0], vw1 = vw[c1];

    float ks0_0 = (t0 >= 3u) ? k_in[(t0 - 3u) * C + c0] : ks[t0 * C + c0];
    float ks1_0 = (t0 >= 2u) ? k_in[(t0 - 2u) * C + c0] : ks[(t0 + 1u) * C + c0];
    float ks2_0 = (t0 >= 1u) ? k_in[(t0 - 1u) * C + c0] : ks[(t0 + 2u) * C + c0];
    float ks0_1 = (t0 >= 3u) ? k_in[(t0 - 3u) * C + c1] : ks[t0 * C + c1];
    float ks1_1 = (t0 >= 2u) ? k_in[(t0 - 2u) * C + c1] : ks[(t0 + 1u) * C + c1];
    float ks2_1 = (t0 >= 1u) ? k_in[(t0 - 1u) * C + c1] : ks[(t0 + 2u) * C + c1];

    float vs0_0 = (t0 >= 3u) ? v_in[(t0 - 3u) * C + c0] : vs[t0 * C + c0];
    float vs1_0 = (t0 >= 2u) ? v_in[(t0 - 2u) * C + c0] : vs[(t0 + 1u) * C + c0];
    float vs2_0 = (t0 >= 1u) ? v_in[(t0 - 1u) * C + c0] : vs[(t0 + 2u) * C + c0];
    float vs0_1 = (t0 >= 3u) ? v_in[(t0 - 3u) * C + c1] : vs[t0 * C + c1];
    float vs1_1 = (t0 >= 2u) ? v_in[(t0 - 2u) * C + c1] : vs[(t0 + 1u) * C + c1];
    float vs2_1 = (t0 >= 1u) ? v_in[(t0 - 1u) * C + c1] : vs[(t0 + 2u) * C + c1];

    uint mask = pc.kv_cap - 1u;

    for (uint t = t0; t < t_end; t++) {
        uint base = t * C;
        float kx0 = k_in[base + c0];
        float kx1 = k_in[base + c1];
        float vx0 = v_in[base + c0];
        float vx1 = v_in[base + c1];

        float ka0 = ks0_0 * kw0.x + ks1_0 * kw0.y + ks2_0 * kw0.z + kx0 * kw0.w;
        float ka1 = ks0_1 * kw1.x + ks1_1 * kw1.y + ks2_1 * kw1.z + kx1 * kw1.w;
        float va0 = vs0_0 * vw0.x + vs1_0 * vw0.y + vs2_0 * vw0.z + vx0 * vw0.w;
        float va1 = vs0_1 * vw1.x + vs1_1 * vw1.y + vs2_1 * vw1.z + vx1 * vw1.w;

        if (pc.has_dyn != 0u) {
            vec4 kd = kdyn[t * pc.n_head_kv + h];
            vec4 vd = vdyn[t * pc.n_head_kv + h];
            ka0 += kx0 * kd.x + ks2_0 * kd.y + ks1_0 * kd.z + ks0_0 * kd.w;
            ka1 += kx1 * kd.x + ks2_1 * kd.y + ks1_1 * kd.z + ks0_1 * kd.w;
            va0 += vx0 * vd.x + vs2_0 * vd.y + vs1_0 * vd.z + vs0_0 * vd.w;
            va1 += vx1 * vd.x + vs2_1 * vd.y + vs1_1 * vd.z + vs0_1 * vd.w;
        }

        float ko0 = (kx0 + ka0) * pc.inv_scale;
        float ko1 = (kx1 + ka1) * pc.inv_scale;
        float vo0 = (vx0 + va0) * pc.inv_scale;
        float vo1 = (vx1 + va1) * pc.inv_scale;

        ks0_0 = ks1_0; ks1_0 = ks2_0; ks2_0 = kx0;
        ks0_1 = ks1_1; ks1_1 = ks2_1; ks2_1 = kx1;
        vs0_0 = vs1_0; vs1_0 = vs2_0; vs2_0 = vx0;
        vs0_1 = vs1_1; vs1_1 = vs2_1; vs2_1 = vx1;

        float knorm = sqrt(subgroupAdd(ko0 * ko0 + ko1 * ko1)) + 1.0e-6;
        float kf = clamp(pc.qk_clip / knorm, 0.0, 1.0);
        float v_inv = inversesqrt(subgroupAdd(vo0 * vo0 + vo1 * vo1) / 128.0 + 1.0e-6);

        uint pos = pc.pos0 + t;
        uint slot = (pc.is_swa != 0u) ? (pos & mask) : pos;
#ifdef KV_Q8
        uint hb = (slot * pc.n_head_kv + h) * 34u;
        store_q8(ko0 * kf, ko1 * kf, tid, hb, true);
        store_q8(vo0 * v_inv, vo1 * v_inv, tid, hb, false);
#else
        uint kv_base = (slot * pc.n_head_kv + h) * 128u;
        cache_k[kv_base + tid] = float16_t(ko0 * kf);
        cache_k[kv_base + tid + 64u] = float16_t(ko1 * kf);
        cache_v[kv_base + tid] = float16_t(vo0 * v_inv);
        cache_v[kv_base + tid + 64u] = float16_t(vo1 * v_inv);
#endif
    }

    if (pc.n_tok < 3u) {
        ks[c0] = ks0_0; ks[C + c0] = ks1_0; ks[2u * C + c0] = ks2_0;
        ks[c1] = ks0_1; ks[C + c1] = ks1_1; ks[2u * C + c1] = ks2_1;
        vs[c0] = vs0_0; vs[C + c0] = vs1_0; vs[2u * C + c0] = vs2_0;
        vs[c1] = vs0_1; vs[C + c1] = vs1_1; vs[2u * C + c1] = vs2_1;
    }
}
