#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require

/* Zero-barrier wave64 q8_K activation quantization on GPU.
 * One workgroup (64 threads = 1 wave64) handles one 256-wide block from one token row:
 * 64 threads x 1 vec4 each, register-cached, subgroup reductions, zero LDS, zero barriers. */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Input {
    vec4 xv[];
};

layout(set = 0, binding = 1) writeonly buffer Output {
    uint q8[];
};

layout(push_constant) uniform Push {
    uint in_dim;
    uint blocks;
    uint n_tok;
} pc;

const uint Q8K_WORDS = 74u;

int nearest_int(float fval) {
    precise float val = fval + 12582912.0f;
    uint bits = floatBitsToUint(val);
    return int(bits & 0x007fffffu) - 0x00400000;
}

uint pack_i8x4(int a0, int a1, int a2, int a3) {
    return (uint(a0) & 255u)
         | ((uint(a1) & 255u) << 8u)
         | ((uint(a2) & 255u) << 16u)
         | ((uint(a3) & 255u) << 24u);
}

void main(void) {
    uint lid = gl_LocalInvocationID.x;
    uint block = gl_WorkGroupID.x;
    uint tok = gl_WorkGroupID.y;
    uint xbase4 = (tok * (pc.in_dim >> 2u)) + block * 64u;
    uint out_base = (tok * pc.blocks + block) * Q8K_WORDS;

    vec4 v = xv[xbase4 + lid];
    vec4 av = abs(v);
    float max_a = max(max(av.x, av.y), max(av.z, av.w));
    float gmax_a = subgroupMax(max_a);

    float iscale = 0.0f;
    float d = 0.0f;
    if (gmax_a > 0.0f) {
        float cand_v = (av.x == gmax_a) ? v.x : ((av.y == gmax_a) ? v.y : ((av.z == gmax_a) ? v.z : v.w));
        uint win_lane = subgroupMin((max_a == gmax_a) ? lid : 64u);
        float maxv = subgroupShuffle(cand_v, win_lane);
        iscale = -127.0f / maxv;
        d = 1.0f / iscale;
    }

    int q0 = iscale != 0.0f ? min(nearest_int(iscale * v.x), 127) : 0;
    int q1 = iscale != 0.0f ? min(nearest_int(iscale * v.y), 127) : 0;
    int q2 = iscale != 0.0f ? min(nearest_int(iscale * v.z), 127) : 0;
    int q3 = iscale != 0.0f ? min(nearest_int(iscale * v.w), 127) : 0;

    if (lid == 0u) {
        q8[out_base + 0u] = floatBitsToUint(d);
        q8[out_base + 1u] = 0u;
    }
    q8[out_base + 2u + lid] = pack_i8x4(q0, q1, q2, q3);

    int s4 = q0 + q1 + q2 + q3;
    s4 += subgroupShuffleXor(s4, 1u);
    s4 += subgroupShuffleXor(s4, 2u);
    int s_pair = subgroupShuffleXor(s4, 4u);
    if ((lid & 7u) == 0u) {
        uint pair_idx = lid >> 3u;
        q8[out_base + 66u + pair_idx] = (uint(s4) & 0xffffu) | ((uint(s_pair) & 0xffffu) << 16u);
    }
}
