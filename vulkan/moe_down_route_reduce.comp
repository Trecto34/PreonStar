#version 460

#extension GL_ARB_gpu_shader_int64 : require

/* Second half of the identity MoE down sum (moe_down_q2k_sum_decode writes
 * one partial row per routed slot): y[t][row] = sum_u route * part, in expert
 * order with the same software fma32 the fused per-row kernel used, so the
 * result is bit-identical to it. */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Part { float part[]; };
layout(set = 0, binding = 1) readonly buffer RouteWeights { float route[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint n_used;
} pc;

float fma32(float a, float b, float c) {
    double p = double(a) * double(b);
    double s = p + double(c);
    double bv = s - p;
    double e = (p - (s - bv)) + (double(c) - bv);
    if (e != 0.0LF) {
        uint64_t bits = doubleBitsToUint64(s);
        if ((bits & 1UL) == 0UL) {
            if (s > 0.0LF) bits += (e > 0.0LF) ? 1UL : -1UL;
            else if (s < 0.0LF) bits += (e < 0.0LF) ? 1UL : -1UL;
            s = uint64BitsToDouble(bits);
        }
    }
    return float(s);
}

void main(void) {
    uint row = gl_GlobalInvocationID.x;
    uint t = gl_WorkGroupID.y;   /* identity token */
    if (row >= pc.out_dim) return;
    float sum = 0.0;
    for (uint u = 0u; u < pc.n_used; u++) {
        uint slot = t * pc.n_used + u;
        sum = fma32(part[slot * pc.out_dim + row], route[slot], sum);
    }
    y[t * pc.out_dim + row] = sum;
}
