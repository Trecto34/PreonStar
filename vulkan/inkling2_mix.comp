#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : require

/* Fused depth-residual attention for Inkling-2-Mini (vec4 vectorized, shared state reads),
 * with optional fused RMSNorm (norm_mode == 1) or fused RMSNorm + Q8_K quantize (norm_mode == 2)
 * when n_q == 1! Eliminates 45 dispatches + 45 barriers per token. */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer BlocksNormed { vec4 blocks[]; };
layout(set = 0, binding = 1) readonly buffer Cur { vec4 cur[]; };
layout(set = 0, binding = 2) readonly buffer Query { vec4 query[]; };
layout(set = 0, binding = 3) writeonly buffer Out { vec4 out_buf[]; };
layout(set = 0, binding = 4) readonly buffer NormWeight { vec4 norm_w[]; };
layout(set = 0, binding = 5) writeonly buffer Q8Out { uint q8[]; };

layout(push_constant) uniform Push {
    uint n_embd;
    uint n_blocks;
    uint include_cur;
    uint n_q;
    uint q_offset;
    uint state_stride;   /* floats between consecutive block slots */
    uint out_stride;     /* floats between consecutive query outputs */
    uint push_slot;      /* 0xffffffff to skip writing rms(cur) */
    uint norm_mode;      /* 0 = raw mix, 1 = fused rms_norm, 2 = fused rms_norm + q8_k */
    float eps;           /* 1e-6 */
} pc;

const uint Q8K_WORDS = 74u;

uint pack_i8x4(int a0, int a1, int a2, int a3) {
    return (uint(a0) & 255u)
         | ((uint(a1) & 255u) << 8u)
         | ((uint(a2) & 255u) << 16u)
         | ((uint(a3) & 255u) << 24u);
}

void main(void) {
    uint tok = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint d4 = pc.n_embd >> 2u;          /* 576 */
    uint base_tok4 = tok * d4;
    uint state_stride4 = pc.state_stride >> 2u;
    uint out_stride4 = pc.out_stride >> 2u;

    vec4 cur_n[9];
    if (pc.include_cur != 0u || pc.push_slot != 0xffffffffu) {
        float sum_sq = 0.0;
        [[unroll]] for (uint c = 0u; c < 9u; c++) {
            vec4 v = cur[base_tok4 + c * 64u + tid];
            cur_n[c] = v;
            sum_sq += dot(v, v);
        }
        float inv_rms = inversesqrt(subgroupAdd(sum_sq) / float(pc.n_embd) + 1.0e-6);
        [[unroll]] for (uint c = 0u; c < 9u; c++) {
            cur_n[c] *= inv_rms;
        }
        if (pc.push_slot != 0xffffffffu) {
            uint dst_base = pc.push_slot * state_stride4 + base_tok4;
            [[unroll]] for (uint c = 0u; c < 9u; c++) {
                blocks[dst_base + c * 64u + tid] = cur_n[c];
            }
        }
    }

    if (pc.n_q == 0u) return;

    uint n_states = pc.n_blocks + (pc.include_cur != 0u ? 1u : 0u);
    float inv_sqrt_d = inversesqrt(float(pc.n_embd));
    float probs[4][5];

    /* Pass 1: score each state once against all n_q queries */
    for (uint s = 0u; s < pc.n_blocks; s++) {
        uint s_base = s * state_stride4 + base_tok4;
        float acc[4] = float[4](0.0, 0.0, 0.0, 0.0);
        [[unroll]] for (uint c = 0u; c < 9u; c++) {
            uint idx = c * 64u + tid;
            vec4 sv = blocks[s_base + idx];
            for (uint q = 0u; q < pc.n_q; q++) {
                acc[q] += dot(sv, query[(pc.q_offset + q) * d4 + idx]);
            }
        }
        for (uint q = 0u; q < pc.n_q; q++) {
            probs[q][s] = subgroupAdd(acc[q]) * inv_sqrt_d;
        }
    }
    if (pc.include_cur != 0u) {
        float acc[4] = float[4](0.0, 0.0, 0.0, 0.0);
        [[unroll]] for (uint c = 0u; c < 9u; c++) {
            uint idx = c * 64u + tid;
            for (uint q = 0u; q < pc.n_q; q++) {
                acc[q] += dot(cur_n[c], query[(pc.q_offset + q) * d4 + idx]);
            }
        }
        for (uint q = 0u; q < pc.n_q; q++) {
            probs[q][pc.n_blocks] = subgroupAdd(acc[q]) * inv_sqrt_d;
        }
    }

    /* Softmax per query */
    for (uint q = 0u; q < pc.n_q; q++) {
        float max_s = -1.0e30;
        for (uint s = 0u; s < n_states; s++) max_s = max(max_s, probs[q][s]);
        float sum_e = 0.0;
        for (uint s = 0u; s < n_states; s++) {
            probs[q][s] = exp(probs[q][s] - max_s);
            sum_e += probs[q][s];
        }
        float inv_e = 1.0 / sum_e;
        for (uint s = 0u; s < n_states; s++) probs[q][s] *= inv_e;
    }

    /* Fast fused path for n_q == 1 with RMSNorm (+ optional Q8_K) */
    if (pc.norm_mode != 0u) {
        vec4 o0[9];
        float sum_sq = 0.0;
        [[unroll]] for (uint c = 0u; c < 9u; c++) {
            uint idx = c * 64u + tid;
            vec4 v = vec4(0.0);
            for (uint s = 0u; s < pc.n_blocks; s++) {
                v = fma(vec4(probs[0][s]), blocks[s * state_stride4 + base_tok4 + idx], v);
            }
            if (pc.include_cur != 0u) {
                v = fma(vec4(probs[0][pc.n_blocks]), cur_n[c], v);
            }
            o0[c] = v;
            sum_sq += dot(v, v);
        }
        float inv_rms = inversesqrt(subgroupAdd(sum_sq) / float(pc.n_embd) + pc.eps);

        [[unroll]] for (uint c = 0u; c < 9u; c++) {
            uint idx = c * 64u + tid;
            vec4 y = o0[c] * inv_rms * norm_w[idx];
            out_buf[base_tok4 + idx] = y;

            if (pc.norm_mode == 2u) {
                vec4 ay = abs(y);
                float max_a = max(max(ay.x, ay.y), max(ay.z, ay.w));
                float gmax_a = subgroupMax(max_a);
                float iscale = 0.0;
                float d = 0.0;
                if (gmax_a > 0.0) {
                    float cand_v = (ay.x == gmax_a) ? y.x : ((ay.y == gmax_a) ? y.y : ((ay.z == gmax_a) ? y.z : y.w));
                    uint win_lane = subgroupMin((max_a == gmax_a) ? tid : 64u);
                    float maxv = subgroupShuffle(cand_v, win_lane);
                    iscale = -127.0 / maxv;
                    d = 1.0 / iscale;
                }
                int q0 = clamp(int(roundEven(iscale * y.x)), -128, 127);
                int q1 = clamp(int(roundEven(iscale * y.y)), -128, 127);
                int q2 = clamp(int(roundEven(iscale * y.z)), -128, 127);
                int q3 = clamp(int(roundEven(iscale * y.w)), -128, 127);

                uint out_base = (tok * 9u + c) * Q8K_WORDS;
                if (tid == 0u) {
                    q8[out_base + 0u] = floatBitsToUint(d);
                    q8[out_base + 1u] = 0u;
                }
                q8[out_base + 2u + tid] = pack_i8x4(q0, q1, q2, q3);

                int s4 = q0 + q1 + q2 + q3;
                s4 += subgroupShuffleXor(s4, 1u);
                s4 += subgroupShuffleXor(s4, 2u);
                int s_pair = subgroupShuffleXor(s4, 4u);
                if ((tid & 7u) == 0u) {
                    uint pair_idx = tid >> 3u;
                    q8[out_base + 66u + pair_idx] = (uint(s4) & 0xffffu) | ((uint(s_pair) & 0xffffu) << 16u);
                }
            }
        }
        return;
    }

    /* Pass 2: accumulate outputs across all queries per chunk */
    [[unroll]] for (uint c = 0u; c < 9u; c++) {
        uint idx = c * 64u + tid;
        vec4 o[4] = vec4[4](vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));
        for (uint s = 0u; s < pc.n_blocks; s++) {
            vec4 sv = blocks[s * state_stride4 + base_tok4 + idx];
            for (uint q = 0u; q < pc.n_q; q++) {
                o[q] = fma(vec4(probs[q][s]), sv, o[q]);
            }
        }
        if (pc.include_cur != 0u) {
            for (uint q = 0u; q < pc.n_q; q++) {
                o[q] = fma(vec4(probs[q][pc.n_blocks]), cur_n[c], o[q]);
            }
        }
        for (uint q = 0u; q < pc.n_q; q++) {
            out_buf[q * out_stride4 + base_tok4 + idx] = o[q];
        }
    }
}
