+int q36_gpu_swiglu_hadamard_prepare_tensor(q36_gpu_tensor *q8_dst,
+                                           const q36_gpu_tensor *gate,
+                                           const q36_gpu_tensor *up,
+                                           const q36_gpu_tensor *signs,
+                                           uint32_t width,
+                                           uint32_t n_rows,
+                                           uint32_t sign_offset,
+                                           uint32_t total_signs,
+                                           float scale) {
+    uint64_t elems, act_bytes, sign_bytes, q8_bytes;
+    if (!q8_dst || !gate || !up || !signs || !width || !n_rows ||
+        (width % 1024u) != 0 ||
+        !q36_u64_mul_ok(width, n_rows, &elems) ||
+        !q36_u64_mul_ok(elems, sizeof(float), &act_bytes) ||
+        !q36_u64_mul_ok(total_signs, sizeof(float), &sign_bytes) ||
+        sign_offset > total_signs ||
+        (uint64_t)sign_offset + width > total_signs ||
+        !q36_u64_mul_ok(n_rows, width / Q36_VK_QK_K, &q8_bytes) ||
+        !q36_u64_mul_ok(q8_bytes, sizeof(q36_vk_block_q8_K), &q8_bytes) ||
+        !q36_gpu_tensor_range_ok(gate, 0, act_bytes) ||
+        !q36_gpu_tensor_range_ok(up, 0, act_bytes) ||
+        !q36_gpu_tensor_range_ok(signs, 0, sign_bytes) ||
+        !q36_gpu_tensor_range_ok(q8_dst, 0, q8_bytes)) return 0;
+    struct {
+        uint32_t width, sign_offset;
+        float scale;
+        uint32_t n_rows, blocks, is_grouped;
+    } push = { width, sign_offset, scale, n_rows, width / Q36_VK_QK_K, 0 };
+    const q36_gpu_tensor *bindings[4] = { gate, up, signs, q8_dst };
+    pthread_mutex_lock(&q36_vk_mu);
+    int ok = q36_vk_run_unlocked("swiglu_hadamard_prepare",
+                                  &q36_vk.swiglu_hadamard_prepare, bindings,
+                                  &push, sizeof(push), width / 1024u, n_rows, 1);
+    pthread_mutex_unlock(&q36_vk_mu);
+    return ok;
+}
