+/* True when a dense matmul of this weight type consumes the q8_K activation
+ * (the xq argument) instead of the f32 activation.  Mirrors the branch in
+ * p36_gpu_tensor_matmul_q8_or_float_scaled. */
+static bool p36_tensor_consumes_q8_activation(uint32_t type) {
+    return type != P36_TENSOR_F32 && type != P36_TENSOR_F16 &&
+           type != P36_TENSOR_BF16 && type != P36_TENSOR_Q8_0;
+}
+
+/* Activation-preparation trim: skip q8_K preparation whose only consumer is a
+ * rotated (folded) weight that takes the had_q8 path instead.  Selectable so
+ * the untrimmed graph stays available for A/B; default off. */
+static bool p36_vk_prep_trim(void) {
+    static int cached = -1;
+    if (cached < 0) {
+        const char *env = getenv("P36_VK_PREP_TRIM");
+        cached = env && env[0] && env[0] != '0';
+    }
+    return cached != 0;
+}
